#!/usr/bin/env sh
set -eu

ASTERISK_CONFIG="${ASTERISK_CONFIG:-/tmp/utcp-asterisk/asterisk.conf}"
MODULES_CONFIG="${MODULES_CONFIG:-/opt/utcp-asterisk-config/modules.conf}"
ARI_URL="${ARI_URL:-http://127.0.0.1:8088/ari/asterisk/info}"
ASTERISK_BIN=/usr/sbin/asterisk
ASTERISK_BIN="${ASTERISK_BIN_OVERRIDE:-$ASTERISK_BIN}"
RECORDING_DIR="${ASTERISK_RECORDING_DIR:-/var/spool/asterisk/recording}"

fail() {
  check_class="$1"
  reason="$2"
  module="${3:-}"
  if [ -n "$module" ]; then
    printf 'asterisk_readiness=failed check=%s module=%s reason=%s\n' "$check_class" "$module" "$reason" >&2
  else
    printf 'asterisk_readiness=failed check=%s reason=%s\n' "$check_class" "$reason" >&2
  fi
  exit 1
}

cli() {
  timeout 5 "$ASTERISK_BIN" -C "$ASTERISK_CONFIG" -rx "$1" 2>/dev/null
}

[ -x "$ASTERISK_BIN" ] || fail startup asterisk_binary_unavailable
[ -r "$ASTERISK_CONFIG" ] || fail startup asterisk_config_unreadable
[ -r "$MODULES_CONFIG" ] || fail modules modules_config_unreadable
[ -d "$RECORDING_DIR" ] || fail recording recording_directory_missing
[ -w "$RECORDING_DIR" ] || fail recording recording_directory_not_writable
recording_probe="$RECORDING_DIR/.utcp-recording-readiness-$$"
if ! : > "$recording_probe" 2>/dev/null; then
  fail recording recording_directory_write_failed
fi
rm -f "$recording_probe"

if ! cli "core waitfullybooted" >/dev/null; then
  fail startup cli_not_fully_booted
fi

http_code="$(
  curl -sS -o /dev/null -w '%{http_code}' \
    --connect-timeout 2 \
    --max-time 4 \
    "$ARI_URL" 2>/dev/null || true
)"
[ "$http_code" = "401" ] || fail ari_http "unexpected_http_status_${http_code:-none}"

modules="$(
  awk '
    /^[[:space:]]*($|;|#)/ { next }
    {
      line=$0
      sub(/[;#].*$/, "", line)
      if (line ~ /^[[:space:]]*load[[:space:]]*=[[:space:]]*[A-Za-z0-9_.-]+\.so[[:space:]]*$/) {
        sub(/^[[:space:]]*load[[:space:]]*=[[:space:]]*/, "", line)
        sub(/[[:space:]]*$/, "", line)
        print line
      }
    }
  ' "$MODULES_CONFIG"
)"
[ -n "$modules" ] || fail modules no_load_directives

printf '%s\n' "$modules" | while IFS= read -r module; do
  [ -n "$module" ] || fail modules empty_module_name
  if ! cli "module show like $module" | awk -v module="$module" '$1 == module && $0 ~ /Running/ { found=1 } END { exit found ? 0 : 1 }'; then
    fail modules not_running "$module"
  fi
done

check_interface() {
  command="$1"
  evidence="$2"
  interface="$3"
  output="$(cli "$command")" || fail dialplan_interface "cli_command_failed" "$interface"
  printf '%s\n' "$output" | grep -Eiq "$evidence" || fail dialplan_interface "not_registered" "$interface"
}

check_interface "core show application Dial" "Info about application 'Dial'" Dial
check_interface "core show function PJSIP_HEADER" "Info about function 'PJSIP_HEADER'" PJSIP_HEADER
check_interface "core show application Gosub" "Info about application 'Gosub'" Gosub
check_interface "core show application Return" "Info about application 'Return'" Return

if ! cli "core show channeltypes" | awk '$1 == "Local" { found=1 } END { exit found ? 0 : 1 }'; then
  fail local_channel channel_type_absent
fi

if ! cli "pjsip show transports" | grep -Eq '^Transport:[[:space:]]+transport-udp-internal[[:space:]]+udp[[:space:]].*0\.0\.0\.0:5060$'; then
  fail pjsip_transport "transport_missing_or_not_udp_5060"
fi

wav_formats_ready=0
# The caller-side readiness probe retries this bounded check while Asterisk
# finishes loading explicitly configured modules. Keep this probe short so a
# single invocation cannot consume the caller's entire retry window.
for attempt in $(seq 1 5); do
  if cli "core show file formats" | awk '$2 == "wav" || $2 == "wav16" { found=1 } END { exit found ? 0 : 1 }'; then
    wav_formats_ready=1
    break
  fi
  sleep 1
done
[ "$wav_formats_ready" -eq 1 ] || fail recording wav_format_unavailable

printf 'asterisk_readiness=ok\n'
