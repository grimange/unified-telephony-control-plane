#!/usr/bin/env python3
import os
import socket
import sys


host = os.environ.get("POD_IP")
port = int(os.environ.get("RTPENGINE_NG_PORT", "2223"))

if not host:
    print("POD_IP is required for rtpengine ng ping", file=sys.stderr)
    sys.exit(1)

cookie = b"utcp-health"
payload = cookie + b" d7:command4:pinge"

with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
    sock.settimeout(2.0)
    sock.sendto(payload, (host, port))
    data, _ = sock.recvfrom(4096)

if not data.startswith(cookie + b" "):
    print("rtpengine ng ping returned an unexpected cookie", file=sys.stderr)
    sys.exit(1)

body = data[len(cookie) + 1 :]
if b"6:result4:pong" not in body:
    print(f"rtpengine ng ping returned an unexpected body: {body!r}", file=sys.stderr)
    sys.exit(1)
