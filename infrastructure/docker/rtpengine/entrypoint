#!/usr/bin/env sh
set -eu

require_ipv4() {
  value="$1"
  case "$value" in
    ""|0.0.0.0|127.*|169.254.*)
      return 1
      ;;
  esac
  printf '%s\n' "$value" | awk -F. '
    NF != 4 {exit 1}
    {
      for (i = 1; i <= 4; i++) {
        if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1
      }
    }
  '
}

: "${POD_IP:?POD_IP must be supplied from status.podIP}"
: "${RTPENGINE_NG_PORT:?RTPENGINE_NG_PORT must be set}"
: "${RTPENGINE_MEDIA_PORT_MIN:?RTPENGINE_MEDIA_PORT_MIN must be set}"
: "${RTPENGINE_MEDIA_PORT_MAX:?RTPENGINE_MEDIA_PORT_MAX must be set}"
: "${RTPENGINE_METRICS_PORT:?RTPENGINE_METRICS_PORT must be set}"

if ! require_ipv4 "$POD_IP"; then
  printf 'invalid POD_IP for rtpengine bind/advertisement: %s\n' "$POD_IP" >&2
  exit 1
fi

if [ "$RTPENGINE_MEDIA_PORT_MIN" != "40000" ] || [ "$RTPENGINE_MEDIA_PORT_MAX" != "40099" ]; then
  printf 'rtpengine media range must be exactly 40000-40099\n' >&2
  exit 1
fi

if [ "$RTPENGINE_NG_PORT" != "2223" ]; then
  printf 'rtpengine ng control port must be 2223\n' >&2
  exit 1
fi

exec /usr/bin/rtpengine \
  --foreground \
  --pidfile=/run/rtpengine/rtpengine.pid \
  --table=-1 \
  --listen-ng="${POD_IP}:${RTPENGINE_NG_PORT}" \
  --interface="internal/${POD_IP}!${POD_IP}" \
  --port-min="${RTPENGINE_MEDIA_PORT_MIN}" \
  --port-max="${RTPENGINE_MEDIA_PORT_MAX}" \
  --listen-http="${POD_IP}:${RTPENGINE_METRICS_PORT}" \
  --log-stderr
