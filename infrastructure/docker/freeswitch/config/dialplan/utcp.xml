<include>
  <context name="utcp">
    <extension name="utcp-echo">
      <condition field="destination_number" expression="^9900$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>
    <extension name="utcp-ring">
      <condition field="destination_number" expression="^9901$">
        <action application="ring_ready"/>
        <action application="sleep" data="60000"/>
      </condition>
    </extension>
  </context>
</include>
