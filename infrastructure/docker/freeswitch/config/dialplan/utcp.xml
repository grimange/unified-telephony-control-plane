<include>
  <context name="utcp">
    <extension name="utcp-inbound">
      <condition field="destination_number" expression="^utcp-in-([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89AaBb][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12})$">
        <action application="set" data="utcp_called_address=${destination_number}"/>
        <action application="set" data="utcp_ingress_external_trunk_id=${sip_h_X-UTCP-Ingress-External-Trunk-ID}"/>
        <action application="set" data="utcp_ingress_telephony_address_id=${sip_h_X-UTCP-Ingress-Telephony-Address-ID}"/>
        <action application="set" data="utcp_ingress_trunk_endpoint_id=${sip_h_X-UTCP-Ingress-Trunk-Endpoint-ID}"/>
        <action application="set" data="utcp_ingress_runtime_node_id=${sip_h_X-UTCP-Ingress-Runtime-Node-ID}"/>
        <action application="answer"/>
        <action application="park"/>
      </condition>
    </extension>
    <extension name="utcp-echo">
      <condition field="destination_number" expression="^9900$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>
    <extension name="utcp-ring">
      <condition field="destination_number" expression="^9901$">
        <action application="ring_ready"/>
        <action application="sleep" data="60000"/>
      </condition>
    </extension>
  </context>
</include>
