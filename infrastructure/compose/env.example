# Synthetic local-only defaults for Phase F3 Docker Compose.
# Copying this file is optional; the canonical Makefile targets already use
# safe defaults through Compose interpolation.

UTCP_GATEWAY_PORT=8088
UTCP_APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

UTCP_POSTGRES_DB=utcp
UTCP_POSTGRES_USER=utcp
UTCP_POSTGRES_PASSWORD=utcp_local_password

UTCP_BUILD_VERSION=0.1.0-dev
UTCP_BUILD_COMMIT=unknown
UTCP_BUILD_CREATED=unknown
UTCP_IMAGE_SOURCE=local

UTCP_API_IMAGE=utcp-api:dev
UTCP_WEB_IMAGE=utcp-web:dev
UTCP_GATEWAY_IMAGE=utcp-gateway:dev
UTCP_REVERB_APP_ID=utcp-local-placeholder
UTCP_REVERB_APP_KEY=replace-with-public-reverb-application-key
UTCP_REVERB_APP_SECRET=replace-with-backend-only-reverb-application-secret
UTCP_REVERB_ALLOWED_ORIGIN=app.utcp.local.test
UTCP_REVERB_PUBLIC_HOST=app.utcp.local.test
UTCP_REVERB_PUBLIC_PORT=443
UTCP_REVERB_PUBLIC_SCHEME=wss
UTCP_REVERB_PUBLIC_PATH=/app

POSTGRES_IMAGE=postgres:17.6-alpine
REDIS_IMAGE=redis:8.2.3-alpine
GATEWAY_RUNTIME_IMAGE=nginxinc/nginx-unprivileged:1.29.4-alpine
