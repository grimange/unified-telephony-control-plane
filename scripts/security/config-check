from __future__ import annotations

import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml

security_render = Path(sys.argv[1])
root = Path(sys.argv[2])

expected_namespaces = {
    "utcp-platform",
    "utcp-data",
    "utcp-observability",
    "utcp-runtime",
    "traefik-system",
}
psa_expected = {
    "pod-security.kubernetes.io/enforce": "restricted",
    "pod-security.kubernetes.io/enforce-version": "v1.35",
    "pod-security.kubernetes.io/audit": "restricted",
    "pod-security.kubernetes.io/audit-version": "v1.35",
    "pod-security.kubernetes.io/warn": "restricted",
    "pod-security.kubernetes.io/warn-version": "v1.35",
}
system_namespaces = {"default", "kube-system", "kube-public", "kube-node-lease"}
authority_renders = {
    "security": "infrastructure/kubernetes/security",
    "base/runtime": "infrastructure/kubernetes/base/runtime",
    "overlays/local/runtime": "infrastructure/kubernetes/overlays/local/runtime",
    "overlays/local-two-asterisk": "infrastructure/kubernetes/overlays/local-two-asterisk",
}
workload_renders = {
    "base": "infrastructure/kubernetes/base",
    "overlays/local": "infrastructure/kubernetes/overlays/local",
    "overlays/local/platform": "infrastructure/kubernetes/overlays/local/platform",
    "overlays/local/migration": "infrastructure/kubernetes/overlays/local/migration",
    "overlays/local/runtime": "infrastructure/kubernetes/overlays/local/runtime",
    "overlays/local-two-asterisk": "infrastructure/kubernetes/overlays/local-two-asterisk",
    "components/runtime-fencing": "infrastructure/kubernetes/components/runtime-fencing",
    "components/asterisk-instance": "infrastructure/kubernetes/components/asterisk-instance",
}
workload_kinds = {"Deployment", "StatefulSet", "DaemonSet", "Job", "CronJob", "Pod"}
reverb_secret = "utcp-local-reverb-credentials"
reverb_config_keys = {"REVERB_HOST", "REVERB_PORT", "REVERB_SCHEME"}
reverb_secret_keys = {"REVERB_APP_ID", "REVERB_APP_KEY", "REVERB_APP_SECRET"}
publisher_workloads = {
    "Deployment/utcp-platform/api",
    "Deployment/utcp-platform/worker",
    "Deployment/utcp-platform/control-plane-outbox-dispatcher",
    "Deployment/utcp-platform/reverb",
}
non_publisher_workloads = {
    "Deployment/utcp-platform/scheduler",
    "Deployment/utcp-platform/telephony-command-worker",
    "Deployment/utcp-platform/telephony-event-normalizer",
    "Deployment/utcp-platform/telephony-reconciler",
    "Deployment/utcp-platform/simulator-event-source",
    "Deployment/utcp-platform/asterisk-ari-events",
    "Deployment/utcp-platform/kamailio-registration-observer",
    "Deployment/utcp-platform/utcp-runtime-fence-worker",
    "Job/utcp-platform/utcp-migrate",
}


def fail(message: str) -> None:
    print(f"security config check failed: {message}", file=sys.stderr)
    raise SystemExit(1)


def load_yaml_documents(content: str) -> list[dict[str, Any]]:
    return [doc for doc in yaml.safe_load_all(content) if isinstance(doc, dict)]


def render(path: str) -> list[dict[str, Any]]:
    output = subprocess.check_output(["kubectl", "kustomize", path], cwd=root, text=True)
    return load_yaml_documents(output)


def namespace_documents(docs: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [doc for doc in docs if doc.get("kind") == "Namespace"]


def labels(doc: dict[str, Any]) -> dict[str, Any]:
    return doc.get("metadata", {}).get("labels") or {}


def object_key(doc: dict[str, Any]) -> str:
    metadata = doc.get("metadata", {})
    return f"{doc.get('kind')}/{metadata.get('namespace')}/{metadata.get('name')}"


def has_psa_labels(doc: dict[str, Any]) -> bool:
    doc_labels = labels(doc)
    return any(key in doc_labels for key in psa_expected)


def pod_template_spec(doc: dict[str, Any]) -> tuple[str, dict[str, Any]] | None:
    kind = doc.get("kind")
    name = doc.get("metadata", {}).get("name", "<unnamed>")
    namespace = doc.get("metadata", {}).get("namespace", "default")
    identifier = f"{kind}/{namespace}/{name}"
    if kind == "Pod":
        return identifier, doc.get("spec") or {}
    if kind == "CronJob":
        spec = (
            doc.get("spec", {})
            .get("jobTemplate", {})
            .get("spec", {})
            .get("template", {})
            .get("spec")
        )
        return identifier, spec or {}
    if kind == "Job":
        spec = doc.get("spec", {}).get("template", {}).get("spec")
        return identifier, spec or {}
    if kind in {"Deployment", "StatefulSet", "DaemonSet"}:
        spec = doc.get("spec", {}).get("template", {}).get("spec")
        return identifier, spec or {}
    return None


def workload_containers(doc: dict[str, Any]) -> list[dict[str, Any]]:
    template = pod_template_spec(doc)
    if template is None:
        return []
    _, pod_spec = template
    return pod_spec.get("containers") or []


def env_from_names(container: dict[str, Any]) -> tuple[list[str], list[str]]:
    config_maps: list[str] = []
    secrets: list[str] = []
    for entry in container.get("envFrom") or []:
        config_name = (entry.get("configMapRef") or {}).get("name")
        secret_name = (entry.get("secretRef") or {}).get("name")
        if config_name:
            config_maps.append(config_name)
        if secret_name:
            secrets.append(secret_name)
    return config_maps, secrets


def explicit_env(container: dict[str, Any]) -> dict[str, str]:
    return {
        entry.get("name"): entry.get("value")
        for entry in container.get("env") or []
        if entry.get("name")
    }


def effective_broadcast_connection(container: dict[str, Any], config_data: dict[str, Any]) -> str | None:
    env = explicit_env(container)
    if "BROADCAST_CONNECTION" in env:
        return env["BROADCAST_CONNECTION"]
    config_maps, _ = env_from_names(container)
    if "utcp-application-config" in config_maps:
        return config_data.get("BROADCAST_CONNECTION")
    return None


def validate_broadcasting_boundary(label: str, docs: list[dict[str, Any]]) -> None:
    rendered_objects = {object_key(doc): doc for doc in docs}
    config_data = (rendered_objects.get("ConfigMap/utcp-platform/utcp-application-config") or {}).get("data") or {}
    secret_data = (
        rendered_objects.get("Secret/utcp-platform/utcp-local-reverb-credentials") or {}
    ).get("data") or {}

    for key, doc in rendered_objects.items():
        if doc.get("kind") not in workload_kinds:
            continue
        containers = workload_containers(doc)
        if not containers:
            continue
        container = containers[0]
        _, secrets = env_from_names(container)
        env = explicit_env(container)
        connection = effective_broadcast_connection(container, config_data)

        if connection == "reverb":
            if key not in publisher_workloads:
                fail(f"{label} {key} unexpectedly uses BROADCAST_CONNECTION=reverb")
            if reverb_secret not in secrets:
                fail(f"{label} {key} uses Reverb without {reverb_secret}")
            missing_config = sorted(reverb_config_keys - set(config_data))
            if missing_config:
                fail(f"{label} {key} publisher misses Reverb config keys: {missing_config}")
            missing_secret = sorted(reverb_secret_keys - set(secret_data))
            if missing_secret:
                fail(f"{label} {key} publisher misses Reverb credential keys: {missing_secret}")

        if key in non_publisher_workloads:
            if connection != "log":
                fail(f"{label} {key} must use BROADCAST_CONNECTION=log")
            if reverb_secret in secrets:
                fail(f"{label} {key} must not reference {reverb_secret}")
            for secret_key in reverb_secret_keys:
                if secret_key in env:
                    fail(f"{label} {key} must not define {secret_key}")


def validate_container_security(identifier: str, name: str, container: dict[str, Any]) -> None:
    security_context = container.get("securityContext") or {}
    if security_context.get("privileged") is True:
        fail(f"{identifier} container {name} is privileged")
    if security_context.get("allowPrivilegeEscalation") is not False:
        fail(f"{identifier} container {name} must set allowPrivilegeEscalation=false")
    capabilities = security_context.get("capabilities") or {}
    if capabilities.get("add"):
        fail(f"{identifier} container {name} adds Linux capabilities")
    if capabilities.get("drop") != ["ALL"]:
        fail(f"{identifier} container {name} must drop all Linux capabilities")
    run_as_user = security_context.get("runAsUser")
    if run_as_user == 0:
        fail(f"{identifier} container {name} runs as UID 0")
    seccomp_type = (security_context.get("seccompProfile") or {}).get("type")
    if seccomp_type == "Unconfined":
        fail(f"{identifier} container {name} uses unconfined seccomp")


def validate_pod_security(identifier: str, pod_spec: dict[str, Any]) -> None:
    for field in ("hostNetwork", "hostPID", "hostIPC"):
        if pod_spec.get(field) is True:
            fail(f"{identifier} enables {field}")
    for volume in pod_spec.get("volumes") or []:
        if "hostPath" in volume:
            fail(f"{identifier} uses hostPath volume {volume.get('name', '<unnamed>')}")
    pod_security = pod_spec.get("securityContext") or {}
    if pod_security.get("runAsNonRoot") is not True:
        fail(f"{identifier} must set pod runAsNonRoot=true")
    if pod_security.get("runAsUser") == 0:
        fail(f"{identifier} runs as UID 0")
    if (pod_security.get("seccompProfile") or {}).get("type") != "RuntimeDefault":
        fail(f"{identifier} must set pod seccompProfile RuntimeDefault")
    for container_key in ("initContainers", "containers"):
        for container in pod_spec.get(container_key) or []:
            validate_container_security(identifier, container.get("name", "<unnamed>"), container)


security_docs = load_yaml_documents(security_render.read_text(encoding="utf-8"))
security_objects = {object_key(doc): doc for doc in security_docs}
security_namespaces = namespace_documents(security_docs)
if {doc.get("metadata", {}).get("name") for doc in security_namespaces} != expected_namespaces:
    fail("security render must define exactly the five UTCP-owned namespaces")

for doc in security_namespaces:
    name = doc.get("metadata", {}).get("name")
    doc_labels = labels(doc)
    for key, expected_value in psa_expected.items():
        if doc_labels.get(key) != expected_value:
            fail(f"Namespace/{name} {key} must be {expected_value}")
    if name in system_namespaces:
        fail(f"security render must not claim system namespace {name}")

if any(doc.get("metadata", {}).get("name") in system_namespaces for doc in security_namespaces):
    fail("security render claims a system namespace")

authority_hits: list[str] = []
for label, path in authority_renders.items():
    for doc in namespace_documents(render(path)):
        name = doc.get("metadata", {}).get("name")
        doc_labels = labels(doc)
        if name == "utcp-runtime":
            authority_hits.append(label)
        if has_psa_labels(doc):
            if name not in expected_namespaces:
                fail(f"{label} sets PSA labels on unexpected namespace {name}")
            for key, expected_value in psa_expected.items():
                if doc_labels.get(key) != expected_value:
                    fail(f"{label} Namespace/{name} {key} is not {expected_value}")
        for key in (
            "pod-security.kubernetes.io/enforce",
            "pod-security.kubernetes.io/audit",
            "pod-security.kubernetes.io/warn",
        ):
            if doc_labels.get(key) in {"baseline", "privileged"}:
                fail(f"{label} Namespace/{name} downgrades {key} to {doc_labels[key]}")

if authority_hits != ["security"]:
    fail(f"utcp-runtime Namespace authority must render only from security, found {authority_hits}")

first_security = yaml.safe_dump_all(security_namespaces, sort_keys=True)
second_security = yaml.safe_dump_all(namespace_documents(render("infrastructure/kubernetes/security")), sort_keys=True)
if first_security != second_security:
    fail("repeated security rendering changed namespace labels")

redis_policy = security_objects.get("NetworkPolicy/utcp-data/allow-redis-from-backend-roles")
if not redis_policy:
    fail("security render must include Redis ingress policy")

redis_spec = redis_policy.get("spec") or {}
if (redis_spec.get("podSelector") or {}).get("matchLabels") != {"utcp.io/network-role": "redis"}:
    fail("Redis policy must target only Redis pods")

redis_ingress = redis_spec.get("ingress") or []
if len(redis_ingress) != 1:
    fail("Redis policy must define one bounded ingress rule")

redis_ports = redis_ingress[0].get("ports") or []
if redis_ports != [{"protocol": "TCP", "port": 6379}]:
    fail("Redis policy must allow only TCP port 6379")

redis_sources = redis_ingress[0].get("from") or []
redis_roles = []
for source in redis_sources:
    namespace_selector = (source.get("namespaceSelector") or {}).get("matchLabels") or {}
    pod_selector = source.get("podSelector") or {}
    match_labels = pod_selector.get("matchLabels") or {}
    if namespace_selector != {"kubernetes.io/metadata.name": "utcp-platform"}:
        fail("Redis ingress source must be bounded to the platform namespace")
    if not match_labels:
        fail("Redis ingress source must not permit all Pods")
    role = match_labels.get("utcp.io/network-role")
    if not role:
        fail("Redis ingress source must select an explicit network role")
    redis_roles.append(role)

if sorted(redis_roles) != [
    "api",
    "asterisk-ari-events",
    "migration",
    "reverb",
    "scheduler",
    "simulator-event-source",
    "worker",
]:
    fail("Redis ingress roles must preserve approved clients and include reverb")

for label, path in workload_renders.items():
    rendered_docs = render(path)
    validate_broadcasting_boundary(label, rendered_docs)
    for doc in rendered_docs:
        if doc.get("kind") not in workload_kinds:
            continue
        template = pod_template_spec(doc)
        if template is None:
            continue
        identifier, pod_spec = template
        validate_pod_security(f"{label}:{identifier}", pod_spec)

print("namespace_psa_authority=ok")
print("restricted_workload_compatibility=ok")
