dns_ports = [{"protocol": "UDP", "port": 53}, {"protocol": "TCP", "port": 53}]
kamailio_dns_egress = [
    rule
    for rule in kamailio_spec.get("egress") or []
    if rule.get("ports") == dns_ports
]
if len(kamailio_dns_egress) != 1:
    fail("allow-kamailio-signaling-required-traffic must include exactly one cluster-DNS egress rule")
cluster_dns_peers = kamailio_dns_egress[0].get("to") or []
if cluster_dns_peers != [
    {
        "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "kube-system"}},
        "podSelector": {"matchLabels": {"k8s-app": "kube-dns"}},
    }
]:
    fail("Kamailio DNS egress must use the exact kube-system CoreDNS selector")

asterisk_sip_spec = asterisk_sip_policy.get("spec") or {}
if (asterisk_sip_spec.get("podSelector") or {}).get("matchLabels") != {
    "app.kubernetes.io/component": "asterisk-ari",
    "utcp.io/network-role": "asterisk-ari",
    "utcp.dev/runtime-node": "local-asterisk-ari",
}:
    fail("allow-asterisk-sip-from-kamailio must target only the canonical Asterisk runtime Pods")
if asterisk_sip_spec.get("policyTypes") != ["Ingress", "Egress"]:
    fail("allow-asterisk-sip-from-kamailio must enforce ingress and egress")
