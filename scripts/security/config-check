from __future__ import annotations

import sys
from pathlib import Path
from typing import Any

import yaml


docs = [doc for doc in yaml.safe_load_all(Path(sys.argv[1]).read_text(encoding="utf-8")) if isinstance(doc, dict)]


def fail(message: str) -> None:
    print(f"security config check failed: {message}", file=sys.stderr)
    raise SystemExit(1)


def key(doc: dict[str, Any]) -> str:
    meta = doc.get("metadata") or {}
    return f"{doc.get('kind')}/{meta.get('namespace')}/{meta.get('name')}"


objects = {key(doc): doc for doc in docs}
policy = objects.get("NetworkPolicy/utcp-platform/allow-rtpengine-media")
if not policy:
    fail("security render must include allow-rtpengine-media")
kamailio_policy = objects.get("NetworkPolicy/utcp-platform/allow-kamailio-signaling-required-traffic")
if not kamailio_policy:
    fail("security render must include allow-kamailio-signaling-required-traffic")
asterisk_sip_policy = objects.get("NetworkPolicy/utcp-runtime/allow-asterisk-sip-from-kamailio")
if not asterisk_sip_policy:
    fail("security render must include allow-asterisk-sip-from-kamailio")

spec = policy.get("spec") or {}
if (spec.get("podSelector") or {}).get("matchLabels") != {"utcp.io/network-role": "rtpengine-media"}:
    fail("allow-rtpengine-media must target only rtpengine-media Pods")
if spec.get("policyTypes") != ["Ingress", "Egress"]:
    fail("allow-rtpengine-media must enforce both ingress and egress")

ingress = spec.get("ingress") or []
egress = spec.get("egress") or []
if len(ingress) != 3:
    fail("allow-rtpengine-media must define exactly ng, media, and metrics ingress")
if len(egress) != 1:
    fail("allow-rtpengine-media must define exactly bounded media egress")

rendered = yaml.safe_dump(policy, sort_keys=True)
for forbidden in ("utcp-data", "postgres", "redis", "kube-system", "0.0.0.0/0", "::/0"):
