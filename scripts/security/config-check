        fail(f"allow-rtpengine-media must not allow {forbidden}")

if "port: 2223" not in rendered or "protocol: UDP" not in rendered:
    fail("allow-rtpengine-media must allow UDP 2223 ng control")
if "port: 40000" not in rendered or "endPort: 40099" not in rendered:
    fail("allow-rtpengine-media must bound media to UDP 40000-40099")
if "port: 2224" not in rendered or "protocol: TCP" not in rendered:
    fail("allow-rtpengine-media must keep metrics internal on TCP 2224")
if "utcp.io/network-role: kamailio-signaling" not in rendered:
    fail("allow-rtpengine-media must bound ng control to Kamailio signaling")
if "utcp.io/network-role: asterisk-ari" not in rendered:
    fail("allow-rtpengine-media must bound in-cluster media to the selected runtime role")
if "app.kubernetes.io/name" not in rendered or "prometheus" not in rendered:
    fail("allow-rtpengine-media must bound metrics ingress to Prometheus")

kamailio_spec = kamailio_policy.get("spec") or {}
if (kamailio_spec.get("podSelector") or {}).get("matchLabels") != {"utcp.io/network-role": "kamailio-signaling"}:
