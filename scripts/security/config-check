kamailio_rtpengine_egress = [
    rule
    for rule in kamailio_spec.get("egress") or []
    if rule.get("ports") == [{"protocol": "UDP", "port": 2223}]
]
if len(kamailio_rtpengine_egress) != 1:
    fail("allow-kamailio-signaling-required-traffic must include exactly one rtpengine UDP 2223 egress rule")
rtpengine_peers = kamailio_rtpengine_egress[0].get("to") or []
if rtpengine_peers != [
    {
        "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "utcp-platform"}},
        "podSelector": {"matchLabels": {"app.kubernetes.io/component": "rtpengine"}},
    }
]:
    fail("Kamailio rtpengine egress must use the exact utcp-platform rtpengine destination selector")

kamailio_asterisk_egress = [
    rule
    for rule in kamailio_spec.get("egress") or []
    if rule.get("ports") == [{"protocol": "UDP", "port": 5060}]
]
if len(kamailio_asterisk_egress) != 1:
    fail("allow-kamailio-signaling-required-traffic must include exactly one Asterisk UDP 5060 egress rule")
asterisk_egress_peers = kamailio_asterisk_egress[0].get("to") or []
if asterisk_egress_peers != [
