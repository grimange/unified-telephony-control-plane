listener_data_check() {
  local rendered_security="$1"

  python3 - "$rendered_security" <<'PY'
from __future__ import annotations

import sys
from pathlib import Path

import yaml


docs = [
    doc
    for doc in yaml.safe_load_all(Path(sys.argv[1]).read_text(encoding="utf-8"))
    if isinstance(doc, dict)
]
def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def policy(name: str) -> dict:
    for doc in docs:
        metadata = doc.get("metadata") or {}
        if doc.get("kind") == "NetworkPolicy" and metadata.get("namespace") == "utcp-data" and metadata.get("name") == name:
            return doc
    fail(f"missing data policy {name}")


def source_roles(name: str, port: int) -> list[str]:
    spec = policy(name).get("spec") or {}
    ingress = spec.get("ingress") or []
    if len(ingress) != 1 or ingress[0].get("ports") != [{"protocol": "TCP", "port": port}]:
        fail(f"{name} must retain its exact data port")
    roles = []
    for source in ingress[0].get("from") or []:
        if (source.get("namespaceSelector") or {}).get("matchLabels") != {"kubernetes.io/metadata.name": "utcp-platform"}:
            fail(f"{name} source namespace is not bounded")
        labels = (source.get("podSelector") or {}).get("matchLabels") or {}
        if set(labels) != {"utcp.io/network-role"}:
            fail(f"{name} source must select one explicit role")
        roles.append(labels["utcp.io/network-role"])
    return roles


postgres_roles = source_roles("allow-postgres-from-backend-roles", 5432)
redis_roles = source_roles("allow-redis-from-backend-roles", 6379)
for service, roles in (("PostgreSQL", postgres_roles), ("Redis", redis_roles)):
    if "asterisk-ari-events" not in roles:
        fail(f"{service} must retain Asterisk listener ingress")
    if "freeswitch-esl-events" not in roles:
        fail(f"{service} must authorize the FreeSWITCH event listener")
PY
}

