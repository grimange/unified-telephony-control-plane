mutate_security_render() {
  local file="$1"
  local mutation="$2"

  python3 - "$file" "$mutation" <<'PY'
from __future__ import annotations

import sys
from pathlib import Path

import yaml

path = Path(sys.argv[1])
mutation = sys.argv[2]
docs = [doc for doc in yaml.safe_load_all(path.read_text(encoding="utf-8")) if isinstance(doc, dict)]


def policy(namespace: str, name: str) -> dict:
    for doc in docs:
        meta = doc.get("metadata") or {}
        if doc.get("kind") == "NetworkPolicy" and meta.get("namespace") == namespace and meta.get("name") == name:
            return doc
    raise SystemExit(f"policy not found: {namespace}/{name}")


asterisk = policy("utcp-runtime", "allow-asterisk-sip-from-kamailio")
asterisk_spec = asterisk["spec"]
kamailio = policy("utcp-platform", "allow-kamailio-signaling-required-traffic")
kamailio_spec = kamailio["spec"]


def remove_data_source(policy_name: str, role: str) -> None:
    data_policy = policy("utcp-data", policy_name)
    for rule in data_policy["spec"].get("ingress") or []:
        rule["from"] = [
            source
            for source in rule.get("from") or []
            if (source.get("podSelector") or {}).get("matchLabels", {}).get("utcp.io/network-role") != role
        ]


def asterisk_dns_rule() -> dict:
    for rule in asterisk_spec.get("egress") or []:
        ports = rule.get("ports") or []
        if any(port.get("port") == 53 for port in ports):
            return rule
    raise SystemExit("Asterisk DNS rule not found")


def asterisk_sip_rule() -> dict:
    for rule in asterisk_spec.get("egress") or []:
        if rule.get("ports") == [{"protocol": "UDP", "port": 5062}]:
            return rule
    raise SystemExit("Asterisk SIP rule not found")


def kamailio_dns_rule() -> dict:
    for rule in kamailio_spec.get("egress") or []:
        ports = rule.get("ports") or []
        if any(port.get("port") == 53 for port in ports):
            return rule
    raise SystemExit("Kamailio DNS rule not found")


if mutation == "remove-udp-53":
    asterisk_dns_rule()["ports"] = [port for port in asterisk_dns_rule()["ports"] if port != {"protocol": "UDP", "port": 53}]
elif mutation == "remove-tcp-53":
    asterisk_dns_rule()["ports"] = [port for port in asterisk_dns_rule()["ports"] if port != {"protocol": "TCP", "port": 53}]
elif mutation == "change-dns-port":
    asterisk_dns_rule()["ports"][0]["port"] = 5353
elif mutation == "remove-dns-pod-selector":
    asterisk_dns_rule()["to"][0].pop("podSelector", None)
elif mutation == "remove-dns-namespace-selector":
    asterisk_dns_rule()["to"][0].pop("namespaceSelector", None)
elif mutation == "split-dns-selectors":
    peer = asterisk_dns_rule()["to"][0]
    asterisk_dns_rule()["to"] = [
        {"namespaceSelector": peer["namespaceSelector"]},
        {"podSelector": peer["podSelector"]},
    ]
elif mutation == "widen-kube-system-dns":
    asterisk_dns_rule()["to"][0].pop("podSelector", None)
elif mutation == "dns-ipblock":
    asterisk_dns_rule()["to"] = [{"ipBlock": {"cidr": "10.43.0.10/32"}}]
elif mutation == "dns-broad-cidr":
    asterisk_dns_rule()["to"] = [{"ipBlock": {"cidr": "0.0.0.0/0"}}]
elif mutation == "unrestricted-egress":
    asterisk_spec.setdefault("egress", []).append({})
elif mutation == "allow-secondary-asterisk":
    asterisk_spec["podSelector"]["matchLabels"]["example.com/secondary-runtime"] = "true"
elif mutation == "remove-sip-egress":
    asterisk_spec["egress"] = [
        rule for rule in asterisk_spec.get("egress") or []
        if rule.get("ports") != [{"protocol": "UDP", "port": 5062}]
    ]
elif mutation == "change-sip-egress-port":
    asterisk_sip_rule()["ports"][0]["port"] = 5060
elif mutation == "widen-sip-egress":
    asterisk_sip_rule()["to"][0].pop("podSelector", None)
elif mutation == "kamailio-dns-drift":
    kamailio_dns_rule()["to"][0]["podSelector"]["matchLabels"]["k8s-app"] = "coredns"
elif mutation == "remove-freeswitch-postgres-source":
    remove_data_source("allow-postgres-from-backend-roles", "freeswitch-esl-events")
elif mutation == "remove-freeswitch-redis-source":
    remove_data_source("allow-redis-from-backend-roles", "freeswitch-esl-events")
elif mutation == "remove-freeswitch-worker-egress":
    docs = [
        doc for doc in docs
        if not (
            doc.get("kind") == "NetworkPolicy"
            and (doc.get("metadata") or {}).get("namespace") == "utcp-platform"
            and (doc.get("metadata") or {}).get("name") == "allow-command-worker-to-freeswitch-esl"
        )
    ]
elif mutation == "change-freeswitch-worker-port":
    policy("utcp-platform", "allow-command-worker-to-freeswitch-esl")["spec"]["egress"][0]["ports"][0]["port"] = 8022
elif mutation == "widen-freeswitch-worker-destination":
    policy("utcp-platform", "allow-command-worker-to-freeswitch-esl")["spec"]["egress"][0]["to"][0].pop("podSelector", None)
elif mutation == "change-freeswitch-worker-source":
    policy("utcp-platform", "allow-command-worker-to-freeswitch-esl")["spec"]["podSelector"]["matchLabels"]["utcp.io/network-role"] = "api"
elif mutation == "change-freeswitch-worker-protocol":
    policy("utcp-platform", "allow-command-worker-to-freeswitch-esl")["spec"]["egress"][0]["ports"][0]["protocol"] = "UDP"
else:
    raise SystemExit(f"unknown security mutation: {mutation}")

path.write_text(yaml.safe_dump_all(docs, sort_keys=False), encoding="utf-8")
PY
}

