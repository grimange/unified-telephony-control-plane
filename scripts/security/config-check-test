#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
VALIDATOR="$ROOT/scripts/security/validate-observability-apiserver-egress"
SOURCE_TEMPLATE="$ROOT/infrastructure/kubernetes/observability/network-policies/allow-apiserver-egress.template.yaml"
SOURCE_INVENTORY="$ROOT/scripts/security/observability-api-workloads.yaml"
SECURITY_SOURCE="$ROOT/infrastructure/kubernetes/security"
KAMAILIO_CONFIGMAP="$ROOT/infrastructure/kubernetes/base/platform/kamailio-configmap.yaml"
TMP_DIR="$(mktemp -d)"

trap 'rm -rf "$TMP_DIR"' EXIT

production_kubeconfig="$TMP_DIR/production-check-kubeconfig"
printf 'apiVersion: v1\n' > "$production_kubeconfig"
real_kubectl="$(command -v kubectl)"
production_kubectl="$TMP_DIR/production-kubectl"
cat > "$production_kubectl" <<EOF
#!/usr/bin/env bash
set -euo pipefail

args=" \$* "
if [[ "\$args" == *" apply --dry-run=server "* ]]; then
  exit 0
fi
if [[ "\$args" == *" get service "* ]] && [[ "\$args" == *".spec.clusterIP"* ]]; then
  printf '10.43.0.1'
  exit 0
fi
if [[ "\$args" == *" get endpoints "* ]]; then
  if [[ "\$args" == *".subsets[*].ports[*].port"* ]]; then
    printf '6443'
  else
    printf '10.0.0.1'
  fi
  exit 0
fi
exec "$real_kubectl" "\$@"
EOF
chmod +x "$production_kubectl"
ln -s "$production_kubectl" "$TMP_DIR/kubectl"
if ! UTCP_SECURITY_ENVIRONMENT=native-k3s \
  UTCP_SECURITY_KUBECONFIG_FILE="$production_kubeconfig" \
  PATH="$TMP_DIR:$PATH" \
  "$ROOT/scripts/security/config-check" >"$TMP_DIR/production-out" 2>"$TMP_DIR/production-err"; then
  printf 'expected production security config check to pass against canonical repository render\n' >&2
  cat "$TMP_DIR/production-out" "$TMP_DIR/production-err" >&2
  exit 1
fi

render_policy() {
  local target="$1"

  sed \
    -e "s#__KUBERNETES_API_ENDPOINT_CIDR__#172.24.0.2/32#g" \
    -e "s#__KUBERNETES_API_ENDPOINT_PORT__#6443#g" \
    "$SOURCE_TEMPLATE" > "$target"
}

pass_case() {
  local name="$1"
  local inventory="$2"
  local policy="$3"

  if ! "$VALIDATOR" "$inventory" "$policy" >"$TMP_DIR/out" 2>"$TMP_DIR/err"; then
    printf 'expected security config check to pass: %s\n' "$name" >&2
    cat "$TMP_DIR/err" >&2
    exit 1
  fi
}

fail_case() {
  local name="$1"
  local expected="$2"
  local inventory="$3"
  local policy="$4"

  if "$VALIDATOR" "$inventory" "$policy" >"$TMP_DIR/out" 2>"$TMP_DIR/err"; then
    printf 'expected security config check to fail: %s\n' "$name" >&2
    cat "$TMP_DIR/out" >&2
    exit 1
  fi
  if ! grep -Fq "$expected" "$TMP_DIR/err"; then
    printf 'expected failure for %s to include: %s\n' "$name" "$expected" >&2
    cat "$TMP_DIR/err" >&2
    exit 1
  fi
}

mutate_policy() {
  local file="$1"
  local mutation="$2"

  python3 - "$file" "$mutation" <<'PY'
from __future__ import annotations

import sys
from pathlib import Path

import yaml

path = Path(sys.argv[1])
mutation = sys.argv[2]
docs = [doc for doc in yaml.safe_load_all(path.read_text(encoding="utf-8")) if isinstance(doc, dict)]


def name(doc: dict) -> str:
    return (doc.get("metadata") or {}).get("name", "")


def operator_policy() -> dict:
    for doc in docs:
        if name(doc) == "allow-prometheus-operator-apiserver-egress":
            return doc
    raise SystemExit("operator policy not found")


def name_policy() -> dict:
    for doc in docs:
        if name(doc) == "allow-observability-kubernetes-api-egress":
            return doc
    raise SystemExit("name policy not found")


if mutation == "remove-operator-policy":
    docs = [doc for doc in docs if name(doc) != "allow-prometheus-operator-apiserver-egress"]
elif mutation == "wrong-operator-component":
    operator_policy()["spec"]["podSelector"]["matchLabels"]["app.kubernetes.io/component"] = "wrong-operator"
elif mutation == "legacy-name-only":
    docs = [doc for doc in docs if name(doc) != "allow-prometheus-operator-apiserver-egress"]
    selector = name_policy()["spec"]["podSelector"]
    for expression in selector.get("matchExpressions") or []:
        if expression.get("key") == "app.kubernetes.io/name":
            expression.setdefault("values", []).append("prometheus-operator")
elif mutation == "operator-selector-all-pods":
    operator_policy()["spec"]["podSelector"] = {}
elif mutation == "remove-api-destination":
    operator_policy()["spec"]["egress"] = []
elif mutation == "unrestricted-api-egress":
    operator_policy()["spec"]["egress"][0]["to"][0]["ipBlock"]["cidr"] = "0.0.0.0/0"
else:
    raise SystemExit(f"unknown policy mutation: {mutation}")

path.write_text(yaml.safe_dump_all(docs, sort_keys=False), encoding="utf-8")
PY
}

mutate_inventory() {
  local file="$1"
  local mutation="$2"

  python3 - "$file" "$mutation" <<'PY'
from __future__ import annotations

import sys
from pathlib import Path

import yaml

path = Path(sys.argv[1])
mutation = sys.argv[2]
doc = yaml.safe_load(path.read_text(encoding="utf-8"))

if mutation == "add-uncovered-client":
    doc.setdefault("workloads", []).append(
        {
            "id": "uncovered-api-client",
            "namespace": "utcp-observability",
            "kind": "Deployment",
            "name": "uncovered-api-client",
            "podLabels": {"app.kubernetes.io/name": "uncovered-api-client"},
        }
    )
else:
    raise SystemExit(f"unknown inventory mutation: {mutation}")

path.write_text(yaml.safe_dump(doc, sort_keys=False), encoding="utf-8")
PY
}

correct_policy="$TMP_DIR/allow-apiserver-egress.correct.yaml"
missing_operator_policy="$TMP_DIR/allow-apiserver-egress.missing-operator.yaml"
wrong_operator_component="$TMP_DIR/allow-apiserver-egress.wrong-operator.yaml"
legacy_only="$TMP_DIR/allow-apiserver-egress.legacy-only.yaml"
wide_operator_selector="$TMP_DIR/allow-apiserver-egress.wide-operator.yaml"
missing_destination="$TMP_DIR/allow-apiserver-egress.missing-destination.yaml"
unrestricted_destination="$TMP_DIR/allow-apiserver-egress.unrestricted.yaml"
uncovered_inventory="$TMP_DIR/observability-api-workloads.uncovered.yaml"

render_policy "$correct_policy"
cp "$correct_policy" "$missing_operator_policy"
cp "$correct_policy" "$wrong_operator_component"
cp "$correct_policy" "$legacy_only"
cp "$correct_policy" "$wide_operator_selector"
cp "$correct_policy" "$missing_destination"
cp "$correct_policy" "$unrestricted_destination"
cp "$SOURCE_INVENTORY" "$uncovered_inventory"

mutate_policy "$missing_operator_policy" remove-operator-policy
mutate_policy "$wrong_operator_component" wrong-operator-component
mutate_policy "$legacy_only" legacy-name-only
mutate_policy "$wide_operator_selector" operator-selector-all-pods
mutate_policy "$missing_destination" remove-api-destination
mutate_policy "$unrestricted_destination" unrestricted-api-egress
mutate_inventory "$uncovered_inventory" add-uncovered-client

pass_case "correct repository policy and inventory" "$SOURCE_INVENTORY" "$correct_policy"
fail_case "missing operator component policy rejected" \
  "missing source policy allow-prometheus-operator-apiserver-egress" \
  "$SOURCE_INVENTORY" "$missing_operator_policy"
fail_case "wrong operator component rejected" \
  "Prometheus Operator source policy must select app.kubernetes.io/component=prometheus-operator" \
  "$SOURCE_INVENTORY" "$wrong_operator_component"
fail_case "legacy name-only operator selector rejected" \
  "ineffective legacy selector app.kubernetes.io/name=prometheus-operator matches no rendered API-dependent workload" \
  "$SOURCE_INVENTORY" "$legacy_only"
fail_case "operator namespace-wide selector rejected" \
  "overbroad source selector selects all observability Pods" \
  "$SOURCE_INVENTORY" "$wide_operator_selector"
fail_case "missing pinned API destination rejected" \
  "expected exactly one canonical API egress rule" \
  "$SOURCE_INVENTORY" "$missing_destination"
fail_case "unrestricted API egress rejected" \
  "unrestricted egress is forbidden" \
  "$SOURCE_INVENTORY" "$unrestricted_destination"
pass_case "declared API-dependent workloads selected by bounded policy" \
  "$SOURCE_INVENTORY" "$correct_policy"
fail_case "new API-dependent workload without policy rejected" \
  "missing source policy selecting API-dependent workload uncovered-api-client" \
  "$uncovered_inventory" "$correct_policy"

validate_asterisk_dns_policy() {
  local rendered_security="$1"
  local kamailio_configmap="$2"

  python3 - "$rendered_security" "$kamailio_configmap" <<'PY'
from __future__ import annotations

import re
import sys
from pathlib import Path
from typing import Any

import yaml


docs = [
    doc
    for doc in yaml.safe_load_all(Path(sys.argv[1]).read_text(encoding="utf-8"))
    if isinstance(doc, dict)
]
kamailio_config = Path(sys.argv[2]).read_text(encoding="utf-8")


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def key(doc: dict[str, Any]) -> str:
    meta = doc.get("metadata") or {}
    return f"{doc.get('kind')}/{meta.get('namespace')}/{meta.get('name')}"


objects = {key(doc): doc for doc in docs}
asterisk = objects.get("NetworkPolicy/utcp-runtime/allow-asterisk-sip-from-kamailio")
kamailio = objects.get("NetworkPolicy/utcp-platform/allow-kamailio-signaling-required-traffic")
runtime_default_deny = objects.get("NetworkPolicy/utcp-runtime/default-deny")
if not asterisk:
    fail("missing Asterisk SIP policy")
if not kamailio:
    fail("missing Kamailio signaling policy")
if not runtime_default_deny:
    fail("missing runtime default-deny policy")
if (runtime_default_deny.get("spec") or {}).get("podSelector") != {}:
    fail("runtime default-deny must remain namespace-wide")

kamailio_ingress = (kamailio.get("spec") or {}).get("ingress") or []
runtime_ingress = [
    rule for rule in kamailio_ingress
    if rule.get("ports") == [{"protocol": "UDP", "port": 5062}]
    and any(
        (peer.get("namespaceSelector") or {}).get("matchLabels", {}).get("kubernetes.io/metadata.name") == "utcp-runtime"
        for peer in rule.get("from", [])
    )
]
if len(runtime_ingress) != 2:
    fail("Kamailio must expose exactly two runtime ingress rules on UDP 5062")
if any(
    rule.get("ports") == [{"protocol": "UDP", "port": 5060}]
    and any(peer.get("namespaceSelector") for peer in rule.get("from", []))
    for rule in kamailio_ingress
):
    fail("runtime namespace ingress must not reach Kamailio provider UDP 5060")
external_ingress = [
    rule for rule in kamailio_ingress
    if any(peer.get("ipBlock", {}).get("cidr") == "38.146.161.46/32" for peer in rule.get("from", []))
]
if external_ingress != [{"from": [{"ipBlock": {"cidr": "38.146.161.46/32"}}], "ports": [{"protocol": "UDP", "port": 5060}]}]:
    fail("external provider ingress must be limited to UDP 5060")

internal_rr_host = "kamailio-sip-internal.utcp-platform.svc.cluster.local:5060"
if internal_rr_host not in kamailio_config:
    fail("internal Kamailio route-set identity must remain Service DNS")
if re.search(r"advertise\s+(?:10|127|172|192)\.\d+\.\d+\.\d+:5060", kamailio_config):
    fail("internal Kamailio route-set identity must not be an IP literal")

asterisk_spec = asterisk.get("spec") or {}
if (asterisk_spec.get("podSelector") or {}).get("matchLabels") != {
    "app.kubernetes.io/component": "asterisk-ari",
    "utcp.io/network-role": "asterisk-ari",
}:
    fail("Asterisk policy must select only canonical Asterisk")
if "local-asterisk-ari-b" in yaml.safe_dump(asterisk, sort_keys=True):
    fail("Asterisk policy must not include secondary Asterisk")

kamailio_spec = kamailio.get("spec") or {}
dns_ports = [{"protocol": "UDP", "port": 53}, {"protocol": "TCP", "port": 53}]
kamailio_dns = [
    rule for rule in kamailio_spec.get("egress") or []
    if rule.get("ports") == dns_ports
]
if len(kamailio_dns) != 1:
    fail("Kamailio DNS authority must expose exact UDP and TCP 53")
cluster_dns_peer = [
    {
        "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "kube-system"}},
        "podSelector": {"matchLabels": {"k8s-app": "kube-dns"}},
    }
]
if kamailio_dns[0].get("to") != cluster_dns_peer:
    fail("Kamailio DNS authority must use combined kube-system and CoreDNS selectors")

ingress = asterisk_spec.get("ingress") or []
if len(ingress) != 2 or {
    "from": [{
        "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "utcp-platform"}},
        "podSelector": {"matchLabels": {"utcp.io/network-role": "kamailio-signaling"}},
    }],
    "ports": [{"protocol": "UDP", "port": 5060}],
} not in ingress or {
    "from": [{
        "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "utcp-platform"}},
        "podSelector": {"matchLabels": {
            "app.kubernetes.io/component": "rtpengine",
            "utcp.io/network-role": "rtpengine-media",
        }},
    }],
    "ports": [{"protocol": "UDP", "port": 10000, "endPort": 20000}],
} not in ingress:
    fail("Asterisk ingress must retain exact Kamailio SIP and rtpengine media rules")

egress = asterisk_spec.get("egress") or []
if len(egress) != 3:
    fail("Asterisk egress must contain exactly SIP, media, and DNS")
for rule in egress:
    if not rule.get("to"):
        fail("Asterisk egress must not be unrestricted")
    rendered_rule = yaml.safe_dump(rule, sort_keys=True)
    if "ipBlock" in rendered_rule or "0.0.0.0/0" in rendered_rule:
        fail("Asterisk egress must not use ipBlock or broad CIDR")

sip_rules = [
    rule for rule in egress
    if rule.get("ports") == [{"protocol": "UDP", "port": 5062}]
]
if sip_rules != [
    {
        "to": [
            {
                "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "utcp-platform"}},
                "podSelector": {"matchLabels": {
                    "app.kubernetes.io/component": "kamailio",
                    "utcp.io/network-role": "kamailio-signaling",
                }},
            }
        ],
        "ports": [{"protocol": "UDP", "port": 5062}],
    }
]:
    fail("Asterisk SIP egress must remain exact Kamailio internal UDP 5062")

media_rules = [rule for rule in egress if rule.get("ports") == [{"protocol": "UDP", "port": 40000, "endPort": 40099}]]
if media_rules != [{
    "to": [{
        "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "utcp-platform"}},
        "podSelector": {"matchLabels": {
            "app.kubernetes.io/component": "rtpengine",
            "utcp.io/network-role": "rtpengine-media",
        }},
    }],
    "ports": [{"protocol": "UDP", "port": 40000, "endPort": 40099}],
}]:
    fail("Asterisk media egress must remain exact rtpengine UDP 40000-40099")

dns_rules = [rule for rule in egress if rule.get("ports") == dns_ports]
if len(dns_rules) != 1:
    fail("Asterisk DNS egress must expose exact UDP and TCP 53")
if dns_rules[0].get("to") != kamailio_dns[0].get("to"):
    fail("Asterisk DNS egress must mirror Kamailio cluster-DNS selector")
PY
}

