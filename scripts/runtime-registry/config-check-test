#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TARGET="$ROOT/apps/api/config/runtime_registry.php"
TMP="$(mktemp -d)"
trap 'cp "$TMP/runtime_registry.php" "$TARGET"; rm -rf "$TMP"' EXIT
cp "$TARGET" "$TMP/runtime_registry.php"

if ! make runtime-registry-config-check >"$TMP/out" 2>"$TMP/err"; then
  cat "$TMP/err" >&2
  exit 1
fi

sed -i "/'media.playback' =>/a\\        'media.provider-specific' => 'Forbidden adapter capability'," "$TARGET"
if make runtime-registry-config-check >"$TMP/out" 2>"$TMP/err"; then
  printf 'forbidden runtime capability mutation unexpectedly passed\n' >&2
  exit 1
fi
grep -Fq 'adapter-specific or telephony-transport capability' "$TMP/err" || { cat "$TMP/err" >&2; exit 1; }

printf 'Runtime registry media.playback and forbidden-capability tests passed\n'
