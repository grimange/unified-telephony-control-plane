#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
KUBECONFIG_FILE="$ROOT/.runtime/kubeconfig/utcp-local.yaml"
CONTEXT="k3d-utcp-local"
NAMESPACE="utcp-platform"

if [ -z "${USER:-}" ]; then
  printf 'USER is required\n' >&2
  exit 2
fi

if [ -z "${REASON:-}" ]; then
  printf 'REASON is required\n' >&2
  exit 2
fi

EXPIRES_IN="${EXPIRES_IN:-30}"
SHOW_PASSWORD="${SHOW_PASSWORD:-0}"

if [ ! -s "$KUBECONFIG_FILE" ]; then
  printf 'repository kubeconfig is missing: %s\n' "$KUBECONFIG_FILE" >&2
  exit 1
fi

kube() {
  KUBECONFIG="$KUBECONFIG_FILE" kubectl --context "$CONTEXT" "$@"
}

if ! kube -n "$NAMESPACE" get deployment/api >/dev/null 2>&1; then
  printf 'canonical API deployment is not available in %s\n' "$NAMESPACE" >&2
  exit 1
fi

kube -n "$NAMESPACE" rollout status deployment/api --timeout=180s >/dev/null
pod="$(
  kube -n "$NAMESPACE" get pod \
    -l app.kubernetes.io/component=api \
    --field-selector=status.phase=Running \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' \
    | sort \
    | head -n 1
)"

if [ -z "$pod" ]; then
  printf 'no running API Pod is available in %s\n' "$NAMESPACE" >&2
  exit 1
fi

args=(
  php artisan utcp:user-access:reset-password
  "--user=$USER"
  "--reason=$REASON"
  "--expires-in=$EXPIRES_IN"
)

if [ "$SHOW_PASSWORD" = "1" ] || [ "$SHOW_PASSWORD" = "true" ]; then
  args+=(--show-password)
fi

kube -n "$NAMESPACE" exec "$pod" -- "${args[@]}"
