#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

fail() {
  printf 'local runtime cutoff check failed: %s\n' "$1" >&2
  exit 1
}

grep -qx 'UTCP_PHASE=C3' versions.env || fail 'versions.env must declare UTCP_PHASE=C3 before C4 begins'
grep -Fq '| C3 Command, event, projection, and reconciliation engine | Complete |' docs/roadmap/phase-status.md ||
  fail 'phase-status must mark C3 complete when UTCP_PHASE=C3'

grep -Eq '^local-up:' Makefile || fail 'Makefile must expose local-up'
grep -Eq '^local-status:' Makefile || fail 'Makefile must expose local-status'
grep -Eq '^local-proof:' Makefile || fail 'Makefile must expose local-proof'
grep -Eq '^local-down:' Makefile || fail 'Makefile must expose local-down'
grep -Eq '^compose-debug-up:' Makefile || fail 'Makefile must expose explicit compose-debug-up'
grep -Eq '^compose-up: compose-debug-up' Makefile || fail 'compose-up must be only a compatibility alias for debug mode'

if grep -Eq 'make compose-up|compose-debug-up' scripts/local/up scripts/local/proof; then
  fail 'canonical local lifecycle must not start Compose'
fi

grep -Fq 'require_no_persistent_compose' scripts/local/up || fail 'local-up must detect persistent Compose authority drift'
grep -Fq 'require_no_persistent_compose' scripts/local/proof || fail 'local-proof must detect persistent Compose authority drift'
grep -Fq 'report_persistent_compose_projects' scripts/local/status || fail 'local-status must report Compose authority drift'

grep -Fq 'utcp-compose-proof-$$' scripts/compose/compose-proof || fail 'compose-proof must default to an isolated disposable project'
grep -Fq 'down --volumes --remove-orphans' scripts/compose/compose-proof || fail 'compose-proof must clean disposable volumes'
grep -Fq 'trap cleanup EXIT INT TERM' scripts/compose/compose-proof || fail 'compose-proof must clean up on success and failure'
grep -Fq 'gateway_port" = "80"' scripts/compose/compose-proof || fail 'compose-proof must reject host port 80'
grep -Fq 'gateway_port" = "443"' scripts/compose/compose-proof || fail 'compose-proof must reject host port 443'
grep -Fq 'utcp|utcp-debug)' scripts/compose/compose-proof || fail 'compose-proof must reject persistent project names'

if grep -R "Start isolated Compose contract for K0 verification" .github/workflows; then
  fail 'CI Kubernetes jobs must not start Compose for K0 verification'
fi
if grep -R "UTCP_COMPOSE_PROJECT_NAME=utcp .*make compose-up" .github/workflows; then
  fail 'CI must not start the old persistent utcp Compose project'
fi

if grep -R "UTCP Compose remains running" README.md CLAUDE.md docs; then
  fail 'active guidance must not require persistent UTCP Compose to remain running'
fi

printf 'local runtime cutoff config check passed\n'
