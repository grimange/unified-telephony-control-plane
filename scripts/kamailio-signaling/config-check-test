            "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "utcp-platform"}},
            "podSelector": {"matchLabels": {"app.kubernetes.io/component": "rtpengine", "utcp.io/network-role": "rtpengine-media"}},
        }],
        "ports": [{"protocol": "UDP", "port": 10000, "endPort": 20000}],
    }
    require(len((asterisk_policy.get("spec") or {}).get("ingress") or []) == 2 and asterisk_media_ingress in ((asterisk_policy.get("spec") or {}).get("ingress") or []), "Asterisk ingress must retain exact Kamailio SIP and rtpengine media rules")
    require({
        "from": [{
            "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "utcp-platform"}},
            "podSelector": {"matchLabels": {"utcp.io/network-role": "kamailio-signaling"}},
        }],
        "ports": [{"protocol": "UDP", "port": 5060}],
    } in ((asterisk_policy.get("spec") or {}).get("ingress") or []), "Asterisk SIP ingress must remain exact Kamailio UDP 5060")
    asterisk_egress = (asterisk_policy.get("spec") or {}).get("egress") or []
    asterisk_sip_egress = {
        "to": [{
            "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "utcp-platform"}},
