        "ports": [{"protocol": "UDP", "port": 40000, "endPort": 40099}],
    }
    require(
        len(asterisk_egress) == 3
        and asterisk_sip_egress in asterisk_egress
        and asterisk_media_egress in asterisk_egress
        and asterisk_dns_egress in asterisk_egress,
