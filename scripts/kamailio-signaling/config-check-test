#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

local_render="$TMP_DIR/local.yaml"
security_render="$TMP_DIR/security.yaml"

kubectl kustomize "$ROOT/infrastructure/kubernetes/overlays/local" >"$local_render"
kubectl kustomize "$ROOT/infrastructure/kubernetes/security" >"$security_render"

python3 - "$ROOT" "$local_render" "$security_render" <<'PY'
from __future__ import annotations

import copy
import hashlib
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any, Callable

import yaml

root = Path(sys.argv[1])
local_docs = [doc for doc in yaml.safe_load_all(Path(sys.argv[2]).read_text(encoding="utf-8")) if isinstance(doc, dict)]
security_docs = [doc for doc in yaml.safe_load_all(Path(sys.argv[3]).read_text(encoding="utf-8")) if isinstance(doc, dict)]
kamailio_image = ""
for line in (root / "versions.env").read_text(encoding="utf-8").splitlines():
    if line.startswith("KAMAILIO_IMAGE="):
        kamailio_image = line.split("=", 1)[1]
        break


class ValidationError(Exception):
    pass


def key(doc: dict[str, Any]) -> str:
    metadata = doc.get("metadata") or {}
    return f"{doc.get('kind')}/{metadata.get('namespace')}/{metadata.get('name')}"


def load_state() -> dict[str, Any]:
    return {
        "modules": (root / "infrastructure/docker/asterisk/config/modules.conf").read_text(encoding="utf-8"),
        "pjsip": (root / "infrastructure/docker/asterisk/config/pjsip.conf").read_text(encoding="utf-8"),
        "extensions": (root / "infrastructure/docker/asterisk/config/extensions.conf").read_text(encoding="utf-8"),
        "kamailio": rendered_kamailio_config(local_docs),
        "local_docs": copy.deepcopy(local_docs),
        "security_docs": copy.deepcopy(security_docs),
    }


def objects(docs: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    return {key(doc): doc for doc in docs}


def rendered_kamailio_config(docs: list[dict[str, Any]]) -> str:
    rendered_objects = objects(docs)
    return (
        rendered_objects.get("ConfigMap/utcp-platform/kamailio-config", {})
        .get("data", {})
        .get("kamailio.cfg", "")
    )


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ValidationError(message)


def block_after(config: str, marker: str) -> str:
    start = config.find(marker)
    if start < 0:
        raise ValidationError(f"Kamailio route block missing {marker}")
    brace = config.find("{", start)
    if brace < 0:
        raise ValidationError(f"Kamailio route block {marker} has no opening brace")
    depth = 0
    for index in range(brace, len(config)):
        char = config[index]
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return config[brace + 1:index]
    raise ValidationError(f"Kamailio route block {marker} has no closing brace")


def require_in_order(block: str, tokens: list[str], context: str) -> None:
    cursor = -1
    for token in tokens:
        index = block.find(token, cursor + 1)
        require(index >= 0, f"{context} missing ordered token {token}")
        cursor = index


def validate(state: dict[str, Any]) -> None:
    modules = state["modules"]
    pjsip = state["pjsip"]
    extensions = state["extensions"]
    kamailio = state["kamailio"]
    local_objects = objects(state["local_docs"])
    security_objects = objects(state["security_docs"])
    request_block = block_after(kamailio, "request_route")
    application_block = block_after(kamailio, "route[APPLICATION_DIALOG]")
    within_block = block_after(kamailio, "route[WITHINDLG]")
    asterisk_block = block_after(kamailio, "route[ASTERISK_RELAY]")
    failure_block = block_after(kamailio, "failure_route[ASTERISK_UNAVAILABLE]")

    require(re.search(r"^\s*autoload\s*=\s*no\s*$", modules, re.M) is not None, "autoload=no required")
    require("autoload = yes" not in modules, "autoload=yes forbidden")
    for module in (
        "res_sorcery_memory.so",
        "res_pjproject.so",
        "res_sorcery_astdb.so",
        "res_pjsip.so",
        "res_pjsip_endpoint_identifier_anonymous.so",
        "res_pjsip_pubsub.so",
        "res_pjsip_session.so",
        "res_rtp_asterisk.so",
        "res_pjsip_sdp_rtp.so",
        "chan_pjsip.so",
        "app_echo.so",
    ):
        require(f"load = {module}" in modules, f"required module missing: {module}")

    require(pjsip.count("type=transport") == 1, "exactly one transport required")
    require("protocol=udp" in pjsip and "bind=0.0.0.0:5060" in pjsip, "UDP 5060 transport required")
    for forbidden in ("protocol=tcp", "protocol=tls", "protocol=ws", "protocol=wss"):
        require(forbidden not in pjsip.lower(), f"forbidden transport: {forbidden}")
    for token in ("[anonymous]", "context=from-kamailio", "direct_media=no", "disallow=all", "allow=ulaw"):
        require(token in pjsip, f"endpoint token missing: {token}")
    require("direct_media=yes" not in pjsip, "direct media forbidden")

    require("[from-kamailio]" in extensions and "Hangup(21)" in extensions, "base from-kamailio rejection context required")
    require("exten => 9900" not in extensions, "base config must not contain local proof extension")

    deployment = local_objects.get("Deployment/utcp-runtime/asterisk-ari")
    sip_service = local_objects.get("Service/utcp-runtime/asterisk-sip")
    ari_service = local_objects.get("Service/utcp-runtime/asterisk-ari")
    require(deployment is not None, "Asterisk Deployment missing")
    require(sip_service is not None, "Asterisk SIP Service missing")
    require(ari_service is not None, "Asterisk ARI Service missing")
    container = (((deployment.get("spec") or {}).get("template") or {}).get("spec") or {}).get("containers", [{}])[0]
    ports = container.get("ports") or []
    require(any(port.get("name") == "sip" and port.get("protocol") == "UDP" and port.get("containerPort") == 5060 for port in ports), "SIP UDP container port missing")
    require(not any("hostPort" in port for port in ports), "hostPort forbidden")
    readiness = (((container.get("readinessProbe") or {}).get("exec") or {}).get("command") or [])
    require(readiness == ["/usr/local/bin/utcp-asterisk-readiness"], "readiness script required")
    require((sip_service.get("spec") or {}).get("type") == "ClusterIP", "SIP Service must be ClusterIP")
    require((sip_service.get("spec") or {}).get("ports") == [{"name": "sip", "protocol": "UDP", "port": 5060, "targetPort": "sip"}], "SIP Service port contract drifted")
    require([port.get("name") for port in (ari_service.get("spec") or {}).get("ports") or []] == ["ari"], "ARI Service must remain ARI-only")
    fixture = local_objects.get("ConfigMap/utcp-runtime/asterisk-local-sip-fixtures")
    require(fixture is not None, "local proof fixture missing")
    fixture_text = (fixture.get("data") or {}).get("extensions.local.conf", "")
    require(fixture_text.count("exten => 9900,1") == 1 and all(token in fixture_text for token in ("Answer()", "Echo()", "Hangup()")), "local proof fixture must be 9900 Answer/Echo/Hangup")

    kamailio_deployment = local_objects.get("Deployment/utcp-platform/kamailio")
    require(kamailio_deployment is not None, "Kamailio Deployment missing")
    kamailio_pod_spec = (((kamailio_deployment.get("spec") or {}).get("template") or {}).get("spec") or {})
    kamailio_container = (kamailio_pod_spec.get("containers") or [{}])[0]
    kamailio_ports = kamailio_container.get("ports") or []
    require(
        any(port.get("name") == "ws" and port.get("protocol") == "TCP" and port.get("containerPort") == 8080 for port in kamailio_ports),
        "Kamailio TCP 8080 container port required",
    )
    require(
        any(port.get("name") == "sip-udp" and port.get("protocol") == "UDP" and port.get("containerPort") == 5060 for port in kamailio_ports),
        "Kamailio UDP 5060 container port required",
    )
    require(not any("hostPort" in port for port in kamailio_ports), "Kamailio hostPort forbidden")
    require(kamailio_pod_spec.get("hostNetwork") is not True, "Kamailio hostNetwork forbidden")
    annotations = (
        (((kamailio_deployment.get("spec") or {}).get("template") or {}).get("metadata") or {})
        .get("annotations") or {}
    )
    expected_checksum = hashlib.sha256(kamailio.encode("utf-8")).hexdigest()
    require(
        annotations.get("utcp.io/kamailio-config-sha256") == expected_checksum,
        "Kamailio Deployment checksum must match rendered kamailio.cfg",
    )
    require(
        "kubectl.kubernetes.io/restartedAt" not in yaml.safe_dump(kamailio_deployment),
        "manual rollout restart timestamp forbidden",
    )
    for forbidden in ("rtpengine_offer", "rtpengine_answer", "rtpengine_delete", "rtpengine_manage"):
        require(forbidden not in kamailio, f"rtpengine operation forbidden in T3-S2A: {forbidden}")
    for token in (
        'if ($rm == "REGISTER")',
        'save("location", "0x04")',
        'loadmodule "rr.so"',
        'loadmodule "siputils.so"',
        'route[APPLICATION_DIALOG]',
        'route[WITHINDLG]',
        'route[ASTERISK_RELAY]',
        'is_method("INVITE|ACK|CANCEL|BYE|UPDATE")',
        'www_authorize("$fd", "kamailio_signaling_auth_view")',
        'record_route()',
        'has_totag()',
        'loose_route()',
        'if ($rm == "ACK")',
        'if ($rm == "CANCEL")',
        't_relay()',
        't_on_failure("ASTERISK_UNAVAILABLE")',
        'failure_route[ASTERISK_UNAVAILABLE]',
        't_is_canceled()',
        't_check_status("408")',
        't_reply("503", "Application Runtime Unavailable")',
        'result=asterisk_unavailable',
        'sl_send_reply("405", "Method Not Allowed")',
    ):
        require(token in kamailio, f"Kamailio route token missing: {token}")
    require_in_order(
        request_block,
        [
            'if ($rm == "CANCEL")',
            "has_totag()",
            "route(WITHINDLG)",
            'if ($rd != "sip.utcp.local.test")',
            'if ($rm == "REGISTER")',
            'is_method("INVITE|ACK|CANCEL|BYE|UPDATE")',
            "route(APPLICATION_DIALOG)",
        ],
        "request_route",
    )
    require("has_totag()" not in application_block, "established-dialog handling must not live behind initial method routing")
    require('if ($rd != "sip.utcp.local.test")' not in application_block, "initial domain validation must not run inside application dialog route")
    require("loose_route()" in within_block, "WITHINDLG must use loose_route")
    require('www_authorize("$fd", "kamailio_signaling_auth_view")' not in within_block, "WITHINDLG must not authenticate as an initial request")
    require("route(ASTERISK_RELAY)" not in within_block and "$du =" not in within_block, "WITHINDLG must not repeat Asterisk destination selection")
    require('result=initial_foreign_domain' in kamailio and 'result=foreign_domain' not in kamailio, "initial domain rejection label required")
    require_in_order(asterisk_block, ['$du = "sip:asterisk-sip.utcp-runtime.svc.cluster.local:5060;transport=udp"', 't_on_failure("ASTERISK_UNAVAILABLE")', "t_relay()"], "route[ASTERISK_RELAY]")
    require("t_reply(\"503\", \"Application Runtime Unavailable\")" in asterisk_block, "immediate relay failure must use committed 503")
    require("t_check_status(\"408\")" in failure_block, "failure route must match timeout/generated 408 only")
    require("t_reply(\"503\", \"Application Runtime Unavailable\")" in failure_block, "failure route must return committed 503")
    require("t_is_canceled()" in failure_block and failure_block.find("t_is_canceled()") < failure_block.find("t_check_status(\"408\")"), "failure route must not convert cancellation to 503")
    for token in ("append_branch", "t_relay()", "$du =", "rtpengine_", "www_authorize"):
        require(token not in failure_block, f"failure route must not contain {token}")
    require(re.search(r't_check_status\("(\.\*|[1-6]\[0-9\]\[0-9\]|[45]\[0-9\]\[0-9\]|[0-9]\{3\})"\)', failure_block) is None, "failure route must not map every downstream response")
    asterisk_targets = re.findall(r"\bsip:([^\";\s]+:5060)(?:;transport=udp)?", kamailio)
    require(not any(re.match(r"(?:\d{1,3}\.){3}\d{1,3}:5060$", target) for target in asterisk_targets), "IP literal Asterisk target forbidden")
    require(asterisk_targets == ["asterisk-sip.utcp-runtime.svc.cluster.local:5060"], "exactly one Asterisk Service DNS target required")
    asterisk_destinations = re.findall(r'\$du\s*=\s*"sip:([^";\s]+):(\d+);transport=([a-zA-Z]+)"', kamailio)
    require(
        asterisk_destinations == [("asterisk-sip.utcp-runtime.svc.cluster.local", "5060", "udp")],
        "exactly one Asterisk UDP 5060 relay destination required",
    )
    listeners = [
        (proto.lower(), host, int(port), adv_host, int(adv_port))
        for proto, host, port, adv_host, adv_port in re.findall(r"^\s*listen=(udp|tcp):([^:\s]+):(\d+)\s+advertise\s+([^:\s]+):(\d+)\s*$", kamailio, re.M | re.I)
    ]
    require(listeners.count(("tcp", "0.0.0.0", 8080, "sip.utcp.local.test", 443)) == 1, "exactly one advertised Kamailio TCP 8080 listener required")
    require(listeners.count(("udp", "0.0.0.0", 5060, "kamailio-sip-internal.utcp-platform.svc.cluster.local", 5060)) == 1, "exactly one advertised Kamailio UDP 5060 listener required")
    require(sum(1 for proto, _host, _port, _adv_host, _adv_port in listeners if proto == "udp") == 1, "multiple Kamailio UDP listeners forbidden")
    for proto, host, port, adv_host, adv_port in listeners:
        require(host == "0.0.0.0", f"Kamailio listener IP literal forbidden: {host}")
        require(adv_host != "0.0.0.0" and not re.match(r"(?:10\.|127\.|172\.(?:1[6-9]|2[0-9]|3[0-1])\.|192\.168\.)", adv_host), f"unstable listener advertisement forbidden: {adv_host}")
        if proto == "tcp":
            require((adv_host, adv_port) == ("sip.utcp.local.test", 443), "client-facing advertisement must use canonical T1 ingress")
        if proto == "udp":
            require(port == 5060, "Kamailio UDP listener port must match Asterisk destination")
            require((adv_host, adv_port) == ("kamailio-sip-internal.utcp-platform.svc.cluster.local", 5060), "Asterisk-facing advertisement must use internal Service DNS")
    for _host, port, transport in asterisk_destinations:
        require(transport.lower() == "udp", "Asterisk relay destination must use UDP")
        require(int(port) == 5060, "Asterisk relay destination port must be 5060")
        require(any(proto == "udp" and host == "0.0.0.0" and listen_port == int(port) for proto, host, listen_port, _adv_host, _adv_port in listeners), "Asterisk relay destination requires matching UDP listener")

    for doc in state["local_docs"]:
        if doc.get("kind") == "UDPRoute":
            raise ValidationError("Kamailio UDPRoute exposure forbidden")
        if doc.get("kind") != "Service":
            continue
        spec = doc.get("spec") or {}
        selector = spec.get("selector") or {}
        ports = spec.get("ports") or []
        selects_kamailio = selector.get("app.kubernetes.io/component") == "kamailio"
        if selects_kamailio and any(port.get("protocol") == "UDP" for port in ports):
            require(key(doc) == "Service/utcp-platform/kamailio-sip-internal", "only the internal Kamailio SIP Service may expose UDP")
            require(spec.get("type") == "ClusterIP", "internal Kamailio SIP Service must be ClusterIP")
            require(selector == {
                "app.kubernetes.io/part-of": "utcp",
                "app.kubernetes.io/component": "kamailio",
                "utcp.io/network-role": "kamailio-signaling",
            }, "internal Kamailio SIP Service must select only Kamailio signaling")
            require(ports == [{"name": "sip-udp", "protocol": "UDP", "port": 5060, "targetPort": "sip-udp"}], "internal Kamailio SIP Service must expose only UDP 5060")
            require(not any(field in spec for field in ("externalIPs", "loadBalancerIP", "externalName")), "internal Kamailio SIP Service must not use external fields")
        require(not (selects_kamailio and spec.get("type") in {"NodePort", "LoadBalancer"}), "Kamailio public Service type forbidden")
    require("Service/utcp-platform/kamailio-sip-internal" in local_objects, "internal Kamailio SIP Service required")

    kamailio_policy = security_objects.get("NetworkPolicy/utcp-platform/allow-kamailio-signaling-required-traffic")
    asterisk_policy = security_objects.get("NetworkPolicy/utcp-runtime/allow-asterisk-sip-from-kamailio")
    require(kamailio_policy is not None, "Kamailio NetworkPolicy missing")
    require(asterisk_policy is not None, "Asterisk SIP NetworkPolicy missing")
    kamailio_egress = [
        rule
        for rule in (kamailio_policy.get("spec") or {}).get("egress") or []
        if rule.get("ports") == [{"port": 5060, "protocol": "UDP"}] or rule.get("ports") == [{"protocol": "UDP", "port": 5060}]
    ]
    require(len(kamailio_egress) == 1, "exact Kamailio UDP 5060 egress required")
    require(kamailio_egress[0].get("to") == [{
        "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "utcp-runtime"}},
        "podSelector": {"matchLabels": {
            "app.kubernetes.io/component": "asterisk-ari",
            "utcp.io/network-role": "asterisk-ari",
            "utcp.dev/runtime-node": "local-asterisk-ari",
        }},
    }], "Kamailio egress destination must be exact canonical Asterisk runtime")
    require((asterisk_policy.get("spec") or {}).get("ingress") == [{
        "from": [{
            "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "utcp-platform"}},
            "podSelector": {"matchLabels": {"utcp.io/network-role": "kamailio-signaling"}},
        }],
        "ports": [{"protocol": "UDP", "port": 5060}],
    }], "Asterisk ingress must be exact Kamailio UDP 5060")
    asterisk_egress = (asterisk_policy.get("spec") or {}).get("egress") or []
    asterisk_sip_egress = {
        "to": [{
            "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "utcp-platform"}},
            "podSelector": {"matchLabels": {"app.kubernetes.io/component": "kamailio", "utcp.io/network-role": "kamailio-signaling"}},
        }],
        "ports": [{"protocol": "UDP", "port": 5060}],
    }
    asterisk_dns_egress = {
        "to": [{
            "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "kube-system"}},
            "podSelector": {"matchLabels": {"k8s-app": "kube-dns"}},
        }],
        "ports": [{"protocol": "UDP", "port": 53}, {"protocol": "TCP", "port": 53}],
    }
    require(
        len(asterisk_egress) == 2
        and asterisk_sip_egress in asterisk_egress
        and asterisk_dns_egress in asterisk_egress,
        "Asterisk egress must be exact Kamailio UDP 5060 plus cluster-DNS UDP/TCP 53",
    )
    require((asterisk_policy.get("spec") or {}).get("podSelector", {}).get("matchLabels", {}).get("utcp.dev/runtime-node") == "local-asterisk-ari", "Asterisk SIP policy must select only the canonical runtime")
    require(any(rule.get("from") == [{
        "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "utcp-runtime"}},
        "podSelector": {"matchLabels": {"app.kubernetes.io/component": "asterisk-ari", "utcp.io/network-role": "asterisk-ari", "utcp.dev/runtime-node": "local-asterisk-ari"}},
    }] and rule.get("ports") == [{"protocol": "UDP", "port": 5060}] for rule in (kamailio_policy.get("spec") or {}).get("ingress") or []), "Kamailio ingress must be exact canonical Asterisk UDP 5060")
    for policy in (kamailio_policy, asterisk_policy):
        rendered = yaml.safe_dump(policy, sort_keys=True)
        require("ipBlock" not in rendered, "SIP policy must not use ipBlock")
        require("podSelector: {}\n" not in rendered, "SIP policy must not use namespace-wide peers")


def mutate_doc(state: dict[str, Any], doc_key: str, mutation: Callable[[dict[str, Any]], None], source: str = "local_docs") -> None:
    for doc in state[source]:
        if key(doc) == doc_key:
            mutation(doc)
            return
    raise RuntimeError(f"test setup could not find {doc_key}")


def set_kamailio_config(state: dict[str, Any], config: str, update_checksum: bool = False) -> None:
    state["kamailio"] = config
    mutate_doc(
        state,
        "ConfigMap/utcp-platform/kamailio-config",
        lambda d: d.setdefault("data", {}).update({"kamailio.cfg": config}),
    )
    if update_checksum:
        checksum = hashlib.sha256(config.encode("utf-8")).hexdigest()
        mutate_doc(
            state,
            "Deployment/utcp-platform/kamailio",
            lambda d: (
                d.setdefault("spec", {})
                .setdefault("template", {})
                .setdefault("metadata", {})
                .setdefault("annotations", {})
                .update({"utcp.io/kamailio-config-sha256": checksum})
            ),
        )


def kamailio_template_hash(state: dict[str, Any]) -> str:
    deployment = objects(state["local_docs"]).get("Deployment/utcp-platform/kamailio")
    if deployment is None:
        raise ValidationError("Kamailio Deployment missing")
    template = (deployment.get("spec") or {}).get("template") or {}
    return hashlib.sha256(yaml.safe_dump(template, sort_keys=True).encode("utf-8")).hexdigest()


def parse_kamailio_config(config: str) -> tuple[bool, str]:
    if not kamailio_image:
        return False, "KAMAILIO_IMAGE missing from versions.env"
    with tempfile.TemporaryDirectory() as tmp:
        cfg = Path(tmp) / "kamailio.cfg"
        cfg.write_text(config, encoding="utf-8")
        result = subprocess.run(
            [
                "docker",
                "run",
                "--rm",
                "--entrypoint",
                "/usr/sbin/kamailio",
                "-v",
                f"{cfg}:/tmp/kamailio.cfg:ro",
                kamailio_image,
                "-c",
                "-f",
                "/tmp/kamailio.cfg",
            ],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
    return result.returncode == 0, result.stdout


def remove_kamailio_sip_egress(policy: dict[str, Any]) -> None:
    policy["spec"]["egress"] = [
        rule
        for rule in policy["spec"]["egress"]
        if rule.get("ports") not in (
            [{"port": 5060, "protocol": "UDP"}],
            [{"protocol": "UDP", "port": 5060}],
        )
    ]


def widen_kamailio_sip_egress(policy: dict[str, Any]) -> None:
    for rule in policy["spec"]["egress"]:
        if rule.get("ports") in (
            [{"port": 5060, "protocol": "UDP"}],
            [{"protocol": "UDP", "port": 5060}],
        ):
            for peer in rule.get("to", []):
                peer.pop("podSelector", None)


def move_initial_domain_before_has_totag(state: dict[str, Any]) -> None:
    has_totag_block = '''    if (has_totag()) {
        route(WITHINDLG);
        exit;
    }

'''
    domain_block = '''    if ($rd != "sip.utcp.local.test") {
        xlog("L_WARN", "kamailio_registration_rejected result=initial_foreign_domain\\n");
        sl_send_reply("403", "Forbidden");
        exit;
    }

'''
    config = state["kamailio"].replace(has_totag_block, "", 1)
    config = config.replace(domain_block, domain_block + has_totag_block, 1)
    set_kamailio_config(state, config)


def pass_case(name: str, state: dict[str, Any]) -> None:
    try:
        validate(state)
    except ValidationError as exc:
        print(f"expected pass failed: {name}: {exc}", file=sys.stderr)
        raise SystemExit(1)


def fail_case(name: str, mutate: Callable[[dict[str, Any]], None]) -> None:
