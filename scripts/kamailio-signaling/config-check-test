#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

local_render="$TMP_DIR/local.yaml"
security_render="$TMP_DIR/security.yaml"

kubectl kustomize "$ROOT/infrastructure/kubernetes/overlays/local" >"$local_render"
kubectl kustomize "$ROOT/infrastructure/kubernetes/security" >"$security_render"

python3 - "$ROOT" "$local_render" "$security_render" <<'PY'
from __future__ import annotations

import copy
import hashlib
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any, Callable

import yaml

root = Path(sys.argv[1])
local_docs = [doc for doc in yaml.safe_load_all(Path(sys.argv[2]).read_text(encoding="utf-8")) if isinstance(doc, dict)]
security_docs = [doc for doc in yaml.safe_load_all(Path(sys.argv[3]).read_text(encoding="utf-8")) if isinstance(doc, dict)]
kamailio_image = ""
for line in (root / "versions.env").read_text(encoding="utf-8").splitlines():
    if line.startswith("KAMAILIO_IMAGE="):
        kamailio_image = line.split("=", 1)[1]
        break


class ValidationError(Exception):
    pass


def key(doc: dict[str, Any]) -> str:
    metadata = doc.get("metadata") or {}
    return f"{doc.get('kind')}/{metadata.get('namespace')}/{metadata.get('name')}"


def load_state() -> dict[str, Any]:
    return {
        "modules": (root / "infrastructure/docker/asterisk/config/modules.conf").read_text(encoding="utf-8"),
        "pjsip": (root / "infrastructure/docker/asterisk/config/pjsip.conf").read_text(encoding="utf-8"),
        "extensions": (root / "infrastructure/docker/asterisk/config/extensions.conf").read_text(encoding="utf-8"),
        "kamailio": rendered_kamailio_config(local_docs),
        "local_docs": copy.deepcopy(local_docs),
        "security_docs": copy.deepcopy(security_docs),
    }


def objects(docs: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    return {key(doc): doc for doc in docs}


def rendered_kamailio_config(docs: list[dict[str, Any]]) -> str:
    rendered_objects = objects(docs)
    return (
        rendered_objects.get("ConfigMap/utcp-platform/kamailio-config", {})
        .get("data", {})
        .get("kamailio.cfg", "")
    )


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ValidationError(message)


def block_after(config: str, marker: str) -> str:
    start = config.find(marker)
    if start < 0:
        raise ValidationError(f"Kamailio route block missing {marker}")
    brace = config.find("{", start + len(marker))
    if brace < 0:
        raise ValidationError(f"Kamailio route block {marker} has no opening brace")
    depth = 0
    for index in range(brace, len(config)):
        char = config[index]
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return config[brace + 1:index]
    raise ValidationError(f"Kamailio route block {marker} has no closing brace")


def require_in_order(block: str, tokens: list[str], context: str) -> None:
    cursor = -1
    for token in tokens:
        index = block.find(token, cursor + 1)
        require(index >= 0, f"{context} missing ordered token {token}")
        cursor = index


def validate(state: dict[str, Any]) -> None:
    modules = state["modules"]
    pjsip = state["pjsip"]
    extensions = state["extensions"]
    kamailio = state["kamailio"]
    local_objects = objects(state["local_docs"])
    security_objects = objects(state["security_docs"])
    request_block = block_after(kamailio, "request_route")
    application_block = block_after(kamailio, "route[APPLICATION_DIALOG]")
    within_block = block_after(kamailio, "route[WITHINDLG]")
    within_loose_route_block = block_after(within_block, "if (loose_route())")
    asterisk_block = block_after(kamailio, "route[ASTERISK_RELAY]")
    failure_block = block_after(kamailio, "failure_route[ASTERISK_UNAVAILABLE]")
    register_block = block_after(kamailio, 'if ($rm == "REGISTER")')
    media_offer_block = block_after(kamailio, "route[MEDIA_OFFER]")
    media_answer_block = block_after(kamailio, "route[MEDIA_ANSWER]")
    media_delete_block = block_after(kamailio, "route[MEDIA_DELETE]")
    media_reply_block = block_after(kamailio, "onreply_route[APPLICATION_RUNTIME_MEDIA_REPLY]")

    require(re.search(r"^\s*autoload\s*=\s*no\s*$", modules, re.M) is not None, "autoload=no required")
    require("autoload = yes" not in modules, "autoload=yes forbidden")
    for module in (
        "res_sorcery_memory.so",
        "res_pjproject.so",
        "res_sorcery_astdb.so",
        "res_pjsip.so",
        "res_pjsip_endpoint_identifier_anonymous.so",
        "res_pjsip_pubsub.so",
        "res_pjsip_session.so",
        "res_rtp_asterisk.so",
        "res_pjsip_sdp_rtp.so",
        "chan_pjsip.so",
        "app_echo.so",
    ):
        require(f"load = {module}" in modules, f"required module missing: {module}")

    require(pjsip.count("type=transport") == 1, "exactly one transport required")
    require("protocol=udp" in pjsip and "bind=0.0.0.0:5060" in pjsip, "UDP 5060 transport required")
    for forbidden in ("protocol=tcp", "protocol=tls", "protocol=ws", "protocol=wss"):
        require(forbidden not in pjsip.lower(), f"forbidden transport: {forbidden}")
    for token in ("[anonymous]", "context=from-kamailio", "direct_media=no", "disallow=all", "allow=ulaw"):
        require(token in pjsip, f"endpoint token missing: {token}")
    require("direct_media=yes" not in pjsip, "direct media forbidden")

    require("[from-kamailio]" in extensions and "Hangup(21)" in extensions, "base from-kamailio rejection context required")
    require("exten => 9900" not in extensions, "base config must not contain local proof extension")

    deployment = local_objects.get("Deployment/utcp-runtime/asterisk-ari")
    sip_service = local_objects.get("Service/utcp-runtime/asterisk-sip")
    ari_service = local_objects.get("Service/utcp-runtime/asterisk-ari")
    require(deployment is not None, "Asterisk Deployment missing")
    require(sip_service is not None, "Asterisk SIP Service missing")
    require(ari_service is not None, "Asterisk ARI Service missing")
    container = (((deployment.get("spec") or {}).get("template") or {}).get("spec") or {}).get("containers", [{}])[0]
    ports = container.get("ports") or []
    require(any(port.get("name") == "sip" and port.get("protocol") == "UDP" and port.get("containerPort") == 5060 for port in ports), "SIP UDP container port missing")
    require(not any("hostPort" in port for port in ports), "hostPort forbidden")
    readiness = (((container.get("readinessProbe") or {}).get("exec") or {}).get("command") or [])
    require(readiness == ["/usr/local/bin/utcp-asterisk-readiness"], "readiness script required")
    require((sip_service.get("spec") or {}).get("type") == "ClusterIP", "SIP Service must be ClusterIP")
    require((sip_service.get("spec") or {}).get("ports") == [{"name": "sip", "protocol": "UDP", "port": 5060, "targetPort": "sip"}], "SIP Service port contract drifted")
    require([port.get("name") for port in (ari_service.get("spec") or {}).get("ports") or []] == ["ari"], "ARI Service must remain ARI-only")
    fixture = local_objects.get("ConfigMap/utcp-runtime/asterisk-local-sip-fixtures")
    require(fixture is not None, "local proof fixture missing")
    fixture_text = (fixture.get("data") or {}).get("extensions.local.conf", "")
    require(fixture_text.count("exten => 9900,1") == 1 and all(token in fixture_text for token in ("Answer()", "Echo()", "Hangup()")), "local proof fixture must be 9900 Answer/Echo/Hangup")

    kamailio_deployment = local_objects.get("Deployment/utcp-platform/kamailio")
    require(kamailio_deployment is not None, "Kamailio Deployment missing")
    kamailio_pod_spec = (((kamailio_deployment.get("spec") or {}).get("template") or {}).get("spec") or {})
    kamailio_container = (kamailio_pod_spec.get("containers") or [{}])[0]
    kamailio_ports = kamailio_container.get("ports") or []
    require(
        any(port.get("name") == "ws" and port.get("protocol") == "TCP" and port.get("containerPort") == 8080 for port in kamailio_ports),
        "Kamailio TCP 8080 container port required",
    )
    require(
        any(port.get("name") == "sip-udp" and port.get("protocol") == "UDP" and port.get("containerPort") == 5060 for port in kamailio_ports),
        "Kamailio UDP 5060 container port required",
    )
    require(not any("hostPort" in port for port in kamailio_ports), "Kamailio hostPort forbidden")
    require(kamailio_pod_spec.get("hostNetwork") is not True, "Kamailio hostNetwork forbidden")
    annotations = (
        (((kamailio_deployment.get("spec") or {}).get("template") or {}).get("metadata") or {})
        .get("annotations") or {}
    )
    expected_checksum = hashlib.sha256(kamailio.encode("utf-8")).hexdigest()
    require(
        annotations.get("utcp.io/kamailio-config-sha256") == expected_checksum,
        "Kamailio Deployment checksum must match rendered kamailio.cfg",
    )
    require(
        "kubectl.kubernetes.io/restartedAt" not in yaml.safe_dump(kamailio_deployment),
        "manual rollout restart timestamp forbidden",
    )
    require("rtpengine_manage" not in kamailio, "rtpengine_manage forbidden; use explicit offer/answer/delete")
    for forbidden in (
        "set_contact_alias",
        "fix_nated_contact",
        "fix_nated_register",
        "loadmodule \"path.so\"",
        "add_path",
        "path(",
        "outbound",
        "gruu",
    ):
        require(forbidden not in kamailio.lower(), f"forbidden WebSocket dialog authority introduced: {forbidden}")
    for token in (
        'if ($rm == "REGISTER")',
        'save("location", "0x04")',
        'loadmodule "rr.so"',
        'loadmodule "siputils.so"',
        'loadmodule "nathelper.so"',
        'loadmodule "rtpengine.so"',
        'modparam("rtpengine", "rtpengine_sock", "udp:rtpengine.utcp-platform.svc.cluster.local:2223")',
        'route[APPLICATION_DIALOG]',
        'route[WITHINDLG]',
        'route[ASTERISK_RELAY]',
        'route[MEDIA_OFFER]',
        'route[MEDIA_ANSWER]',
        'route[MEDIA_DELETE]',
        'onreply_route[APPLICATION_RUNTIME_MEDIA_REPLY]',
        'rtpengine_offer(',
        'rtpengine_answer(',
        'rtpengine_delete()',
        'result=media_offer',
        'result=media_answer',
        'result=media_delete',
        'result=media_offer_failed',
        'result=media_answer_failed',
        'is_method("INVITE|ACK|CANCEL|BYE|UPDATE")',
        'www_authorize("$fd", "kamailio_signaling_auth_view")',
        'record_route()',
        'if ($proto == "ws" || $proto == "wss")',
        'add_contact_alias()',
        'result=websocket_contact_alias_failed',
        'handle_ruri_alias()',
        'result=invalid_dialog_contact_alias',
        'result=missing_dialog_contact_alias',
        'has_totag()',
        'loose_route()',
        'if ($rm == "ACK")',
        'if ($rm == "CANCEL")',
        't_relay()',
        't_on_failure("ASTERISK_UNAVAILABLE")',
        'failure_route[ASTERISK_UNAVAILABLE]',
        't_is_canceled()',
        't_check_status("408")',
        't_reply("503", "Application Runtime Unavailable")',
        'result=asterisk_unavailable',
        'sl_send_reply("405", "Method Not Allowed")',
    ):
        require(token in kamailio, f"Kamailio route token missing: {token}")
    require_in_order(
        request_block,
        [
            'if ($rm == "CANCEL")',
            "has_totag()",
            "route(WITHINDLG)",
            'if ($rd != "sip.utcp.local.test")',
            'if ($rm == "REGISTER")',
            'is_method("INVITE|ACK|CANCEL|BYE|UPDATE")',
            "route(APPLICATION_DIALOG)",
        ],
        "request_route",
    )
    require("has_totag()" not in application_block, "established-dialog handling must not live behind initial method routing")
    require('if ($rd != "sip.utcp.local.test")' not in application_block, "initial domain validation must not run inside application dialog route")
    require("loose_route()" in within_block, "WITHINDLG must use loose_route")
    require('www_authorize("$fd", "kamailio_signaling_auth_view")' not in within_block, "WITHINDLG must not authenticate as an initial request")
    require("route(ASTERISK_RELAY)" not in within_block and re.search(r"\$du\s*=\s*\"sip:", within_block) is None, "WITHINDLG must not repeat Asterisk destination selection")
    require('result=initial_foreign_domain' in kamailio and 'result=foreign_domain' not in kamailio, "initial domain rejection label required")
    require(kamailio.count("add_contact_alias()") == 1, "exactly one initial WebSocket Contact alias creation required")
    require(kamailio.count("handle_ruri_alias()") == 1, "exactly one established-dialog alias consumption required")
    require("add_contact_alias()" not in register_block and "handle_ruri_alias()" not in register_block, "REGISTER route must not use dialog alias helpers")
    require("add_contact_alias()" not in request_block and "handle_ruri_alias()" not in request_block, "request_route must not run dialog alias helpers directly")
    require("handle_ruri_alias()" not in application_block, "initial requests must not consume R-URI aliases")
    require("add_contact_alias()" not in within_block, "sequential requests must not append Contact aliases")
    require(re.search(r'\$proto\s*==\s*"(?:WS|WSS)"', application_block) is None, "WebSocket Contact alias guard must use lowercase live $proto values only")
    require('$proto == "ws"' in application_block and '$proto == "wss"' in application_block, "WebSocket Contact alias guard must compare lowercase ws and wss")
    require('if ($proto == "ws" || $proto == "wss")' in application_block, "WebSocket Contact alias guard must be the canonical lowercase ws/wss expression")
    alias_create_guard_block = block_after(application_block, 'if ($proto == "ws" || $proto == "wss")')
    require("add_contact_alias()" in alias_create_guard_block, "add_contact_alias() must remain inside the lowercase WS/WSS transport guard")
    require(
        re.search(r'\$proto\s*==\s*"udp"', application_block, re.I) is None and 'if (true)' not in application_block,
        "Contact aliasing must remain guarded by WS/WSS transport",
    )
    require_in_order(
        application_block,
        [
            'if ($rm == "ACK")',
            'if ($rm != "INVITE")',
            'www_authorize("$fd", "kamailio_signaling_auth_view")',
            'if ($au != $fU)',
            'if ($proto == "ws" || $proto == "wss")',
            'if (!add_contact_alias())',
            'result=websocket_contact_alias_failed method=$rm call_id=$ci',
            'sl_send_reply("400", "Bad Request")',
            "exit;",
            "route(MEDIA_OFFER)",
            "record_route()",
            "route(ASTERISK_RELAY)",
        ],
        "route[APPLICATION_DIALOG]",
    )
    require("route(MEDIA_OFFER)" in application_block, "initial application-dialog INVITE with SDP must invoke media offer")
    require(not any(token in application_block for token in ("rtpengine_offer", "rtpengine_answer", "rtpengine_delete", "rtpengine_manage")), "APPLICATION_DIALOG must delegate media control to provider-neutral routes")
    require("route(MEDIA_OFFER)" not in register_block and "route(MEDIA_ANSWER)" not in register_block and "route(MEDIA_DELETE)" not in register_block, "REGISTER route must not invoke media routes")
    for forbidden in ("rtpengine_offer", "rtpengine_answer", "rtpengine_delete", "rtpengine_manage"):
        require(forbidden not in register_block, f"REGISTER route must not invoke {forbidden}")
    require(
        not any(token in request_block for token in ("rtpengine_offer", "rtpengine_answer", "rtpengine_delete", "rtpengine_manage", "route(MEDIA_OFFER)", "route(MEDIA_ANSWER)")),
        "request_route must not run media offer or answer directly",
    )
    require("route(MEDIA_DELETE)" in request_block, "CANCEL must clean up any created media session")
    require("t_on_reply(\"APPLICATION_RUNTIME_MEDIA_REPLY\")" in asterisk_block, "Asterisk relay must arm media answer route")
    require(not any(token in asterisk_block for token in ("rtpengine_offer", "rtpengine_answer", "rtpengine_delete", "rtpengine_manage")), "Asterisk relay must delegate media control to provider-neutral routes")
    require_in_order(
        asterisk_block,
        [
            '$du = "sip:asterisk-sip.utcp-runtime.svc.cluster.local:5060;transport=udp"',
            't_on_reply("APPLICATION_RUNTIME_MEDIA_REPLY")',
            't_on_failure("ASTERISK_UNAVAILABLE")',
            "t_relay()",
        ],
        "route[ASTERISK_RELAY] media transaction setup",
    )
    require_in_order(
        media_offer_block,
        [
            'if (!has_body("application/sdp"))',
            "return;",
            'rtpengine_offer("replace-origin replace-session-connection ICE=force RTP/SAVPF DTLS=passive rtcp-mux-offer")',
            'result=media_offer_failed method=$rm call_id=$ci',
            'sl_send_reply("488", "Media Relay Unavailable")',
            "exit;",
            'rtpengine_offer("replace-origin replace-session-connection ICE=remove RTP/AVP rtcp-mux-demux")',
            'setflag(FLT_MEDIA_RELAY_REQUIRED)',
            'result=media_offer method=$rm call_id=$ci',
        ],
        "route[MEDIA_OFFER]",
    )
    require_in_order(
        media_answer_block,
        [
            'if (!has_body("application/sdp"))',
            "return;",
            'rtpengine_answer("replace-origin replace-session-connection ICE=remove RTP/AVP rtcp-mux-demux")',
            'result=media_answer_failed method=$rm call_id=$ci',
            "drop();",
            'rtpengine_answer("replace-origin replace-session-connection ICE=force RTP/SAVPF DTLS=passive rtcp-mux-offer")',
            'result=media_answer method=$rm call_id=$ci',
        ],
        "route[MEDIA_ANSWER]",
    )
    require_in_order(
        media_delete_block,
        [
            "rtpengine_delete()",
            'result=media_delete_failed method=$rm call_id=$ci',
            "return;",
            'result=media_delete method=$rm call_id=$ci',
        ],
        "route[MEDIA_DELETE]",
    )
    require(media_offer_block.count("rtpengine_offer(") == 2, "MEDIA_OFFER must contain exactly two media profiles")
    require(media_answer_block.count("rtpengine_answer(") == 2, "MEDIA_ANSWER must contain exactly two media profiles")
    require(media_delete_block.count("rtpengine_delete()") == 1, "MEDIA_DELETE must be single direct delete authority")
    require("route(MEDIA_ANSWER)" in media_reply_block and "rtpengine_answer" not in media_reply_block, "onreply route must delegate to MEDIA_ANSWER")
    require("route(MEDIA_DELETE)" in failure_block, "terminal Asterisk transaction failure must clean up media")
    require(failure_block.count("route(MEDIA_DELETE)") >= 2, "Asterisk failure route must clean up media for both cancellation and terminal failure")
    require(not any(token in failure_block for token in ("rtpengine_delete()", "rtpengine_offer", "rtpengine_answer")), "failure route must delegate media cleanup")
    require('route(MEDIA_DELETE)' in within_loose_route_block and within_loose_route_block.find('if ($rm == "BYE")') < within_loose_route_block.find('route(MEDIA_DELETE)') < within_loose_route_block.find("t_relay()"), "established BYE must delete media before relay")
    require('is_method("INVITE|UPDATE")' in within_loose_route_block and 'route(MEDIA_OFFER)' in within_loose_route_block and 't_on_reply("APPLICATION_RUNTIME_MEDIA_REPLY")' in within_loose_route_block, "in-dialog re-INVITE/UPDATE must update media and arm answer handling")
    require(not any(token in kamailio for token in ("ARI", "AMI", "channel_id", "asterisk_channel", "dialplan_context")), "media lifecycle must not use Asterisk-specific state")
    require(
        re.search(r"(?:10\.42\.|10\.43\.|127\.0\.0\.1|192\.168\.|172\.(?:1[6-9]|2[0-9]|3[0-1])\.)", media_offer_block + media_answer_block) is None,
        "media routes must not embed Pod, Service ClusterIP, node, or developer-host IP literals",
    )
    alias_destination_block = block_after(within_loose_route_block, 'if ($du == "")')
    require(
        not alias_destination_block.lstrip().startswith("if (!handle_ruri_alias())"),
        "WITHINDLG must not require alias handling for every empty-$du established request",
    )
    require('if ($(ru{uri.param,alias}) != "")' in alias_destination_block, "WITHINDLG must inspect Request-URI alias parameter before alias consumption")
    require(
        '$(ru{uri.param,transport}) == "ws"' in alias_destination_block and '$(ru{uri.param,transport}) == "wss"' in alias_destination_block,
        "WITHINDLG must identify browser WebSocket targets by R-URI transport",
    )
    require(
        re.search(r'\$\(ru\{uri\.host\}\)\s*=~\s*"\\\\\.invalid\$"', alias_destination_block) is not None,
        "WITHINDLG must identify reserved .invalid browser Contact targets",
    )
    alias_present_block = block_after(alias_destination_block, 'if ($(ru{uri.param,alias}) != "")')
    require_in_order(
        alias_present_block,
        [
            'if (!handle_ruri_alias())',
            'result=invalid_dialog_contact_alias method=$rm call_id=$ci',
            'sl_send_reply("400", "Bad Request")',
            "exit;",
            'if ($du == "")',
            'result=invalid_dialog_contact_alias method=$rm call_id=$ci',
            'sl_send_reply("400", "Bad Request")',
            "exit;",
        ],
        "route[WITHINDLG] alias-present destination postcondition",
    )
    missing_browser_alias_block = block_after(alias_destination_block, 'else if ($(ru{uri.param,transport}) == "ws" || $(ru{uri.param,transport}) == "wss" || $(ru{uri.host}) =~ "\\\\.invalid$")')
    require_in_order(
        missing_browser_alias_block,
        [
            'result=missing_dialog_contact_alias method=$rm call_id=$ci',
            'sl_send_reply("400", "Bad Request")',
            "exit;",
        ],
        "route[WITHINDLG] missing browser alias failure",
    )
    require_in_order(
        within_loose_route_block,
        [
            'if ($du == "")',
            'if ($(ru{uri.param,alias}) != "")',
            'if (!handle_ruri_alias())',
            'result=invalid_dialog_contact_alias method=$rm call_id=$ci',
            'sl_send_reply("400", "Bad Request")',
            "exit;",
            'if ($du == "")',
            'result=invalid_dialog_contact_alias method=$rm call_id=$ci',
            'sl_send_reply("400", "Bad Request")',
            "exit;",
            'else if ($(ru{uri.param,transport}) == "ws" || $(ru{uri.param,transport}) == "wss" || $(ru{uri.host}) =~ "\\\\.invalid$")',
            'result=missing_dialog_contact_alias method=$rm call_id=$ci',
            'sl_send_reply("400", "Bad Request")',
            "exit;",
            "t_relay()",
        ],
        "route[WITHINDLG]",
    )
    require("t_reply(\"503\", \"Application Runtime Unavailable\")" in asterisk_block, "immediate relay failure must use committed 503")
    require("t_check_status(\"408\")" in failure_block, "failure route must match timeout/generated 408 only")
    require("t_reply(\"503\", \"Application Runtime Unavailable\")" in failure_block, "failure route must return committed 503")
    require("t_is_canceled()" in failure_block and failure_block.find("t_is_canceled()") < failure_block.find("t_check_status(\"408\")"), "failure route must not convert cancellation to 503")
    for token in ("append_branch", "t_relay()", "$du =", "www_authorize"):
        require(token not in failure_block, f"failure route must not contain {token}")
    require(re.search(r't_check_status\("(\.\*|[1-6]\[0-9\]\[0-9\]|[45]\[0-9\]\[0-9\]|[0-9]\{3\})"\)', failure_block) is None, "failure route must not map every downstream response")
    asterisk_targets = re.findall(r"\bsip:([^\";\s]+:5060)(?:;transport=udp)?", kamailio)
    require(not any(re.match(r"(?:\d{1,3}\.){3}\d{1,3}:5060$", target) for target in asterisk_targets), "IP literal Asterisk target forbidden")
