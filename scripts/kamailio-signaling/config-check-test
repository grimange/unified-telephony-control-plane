def pass_case(name: str, state: dict[str, Any]) -> None:
    try:
        validate(state)
    except ValidationError as exc:
        print(f"expected pass failed: {name}: {exc}", file=sys.stderr)
        raise SystemExit(1)


def fail_case(name: str, mutate: Callable[[dict[str, Any]], None]) -> None:
    state = load_state()
    mutate(state)
    try:
        validate(state)
    except ValidationError:
        return
    print(f"expected failure did not occur: {name}", file=sys.stderr)
    raise SystemExit(1)


def parser_pass_case(name: str, config: str) -> None:
    passed, output = parse_kamailio_config(config)
    if not passed:
        print(f"expected parser pass failed: {name}", file=sys.stderr)
        print(output, file=sys.stderr)
        raise SystemExit(1)


def parser_fail_case(name: str, config: str) -> None:
    passed, _output = parse_kamailio_config(config)
    if passed:
        print(f"expected parser failure did not occur: {name}", file=sys.stderr)
        raise SystemExit(1)


