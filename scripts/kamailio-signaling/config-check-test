def mutate_doc(state: dict[str, Any], doc_key: str, mutation: Callable[[dict[str, Any]], None], source: str = "local_docs") -> None:
    for doc in state[source]:
        if key(doc) == doc_key:
            mutation(doc)
            return
    raise RuntimeError(f"test setup could not find {doc_key}")


def set_kamailio_config(state: dict[str, Any], config: str, update_checksum: bool = False) -> None:
    state["kamailio"] = config
    mutate_doc(
        state,
        "ConfigMap/utcp-platform/kamailio-config",
        lambda d: d.setdefault("data", {}).update({"kamailio.cfg": config}),
    )
    if update_checksum:
        checksum = hashlib.sha256(config.encode("utf-8")).hexdigest()
        mutate_doc(
            state,
            "Deployment/utcp-platform/kamailio",
            lambda d: (
                d.setdefault("spec", {})
                .setdefault("template", {})
                .setdefault("metadata", {})
                .setdefault("annotations", {})
                .update({"utcp.io/kamailio-config-sha256": checksum})
            ),
        )


def kamailio_template_hash(state: dict[str, Any]) -> str:
    deployment = objects(state["local_docs"]).get("Deployment/utcp-platform/kamailio")
    if deployment is None:
        raise ValidationError("Kamailio Deployment missing")
    template = (deployment.get("spec") or {}).get("template") or {}
    return hashlib.sha256(yaml.safe_dump(template, sort_keys=True).encode("utf-8")).hexdigest()


def parse_kamailio_config(config: str) -> tuple[bool, str]:
    if not kamailio_image:
        return False, "KAMAILIO_IMAGE missing from versions.env"
    with tempfile.TemporaryDirectory() as tmp:
        cfg = Path(tmp) / "kamailio.cfg"
        cfg.write_text(config, encoding="utf-8")
        result = subprocess.run(
            [
                "docker",
                "run",
                "--rm",
                "--entrypoint",
                "/usr/sbin/kamailio",
                "-v",
                f"{cfg}:/tmp/kamailio.cfg:ro",
                kamailio_image,
                "-c",
                "-f",
                "/tmp/kamailio.cfg",
            ],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
    return result.returncode == 0, result.stdout


