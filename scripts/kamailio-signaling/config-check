    'add_contact_alias()',
    'result=websocket_contact_alias_failed',
    'handle_ruri_alias()',
    'result=invalid_dialog_contact_alias',
    'result=missing_dialog_contact_alias',
    'has_totag()',
    'loose_route()',
    'if ($rm == "ACK")',
    'if ($rm == "CANCEL")',
    't_check_trans()',
