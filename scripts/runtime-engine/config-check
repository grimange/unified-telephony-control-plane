#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

fail() {
  printf 'runtime engine config check failed: %s\n' "$1" >&2
  exit 1
}

for file in \
  apps/api/config/runtime_engine.php \
  apps/api/database/migrations/2026_07_14_160000_create_runtime_engine_tables.php \
  apps/api/app/RuntimeEngine/Outbox/OutboxDispatcher.php \
  apps/api/app/RuntimeEngine/Commands/CommandWorker.php \
  apps/api/app/RuntimeEngine/Events/EventNormalizerWorker.php \
  apps/api/app/RuntimeEngine/Projection/ProjectionService.php \
  apps/api/app/RuntimeEngine/Reconciliation/ReconciliationWorker.php \
  apps/api/app/Infrastructure/RuntimeFencing/HttpKubernetesWorkloadClient.php \
  infrastructure/kubernetes/base/platform/outbox-dispatcher-deployment.yaml \
  infrastructure/kubernetes/base/platform/telephony-command-worker-deployment.yaml \
  infrastructure/kubernetes/base/platform/telephony-event-normalizer-deployment.yaml \
  infrastructure/kubernetes/base/platform/telephony-reconciler-deployment.yaml \
  infrastructure/kubernetes/components/runtime-fencing/infrastructure-worker-deployment.yaml \
  infrastructure/kubernetes/components/runtime-fencing/rbac.yaml \
  infrastructure/kubernetes/components/runtime-fencing/service-account.yaml \
  scripts/gateway/tls-apply
do
  [ -s "$file" ] || fail "missing required C3 file: $file"
done

find apps/api/app/RuntimeEngine -name '*.php' -print0 | xargs -0 -n1 php -l >/dev/null
php -l apps/api/config/runtime_engine.php >/dev/null
php -l apps/api/routes/console.php >/dev/null

php -r '
if (! function_exists("env")) {
  function env($key, $default = null) { return $default; }
}
$config = require "apps/api/config/runtime_engine.php";
foreach (["control-plane-outbox-dispatcher","telephony-command-worker","telephony-infrastructure-worker","telephony-event-normalizer","telephony-reconciler"] as $role) {
  if (! in_array($role, $config["roles"], true)) {
    fwrite(STDERR, "missing C3 role: {$role}\n");
    exit(1);
  }
}
foreach (["unobserved","unknown","connecting","ready","degraded","unavailable","stale"] as $state) {
  if (! in_array($state, $config["observed_states"], true)) {
    fwrite(STDERR, "missing observed state: {$state}\n");
    exit(1);
  }
}
'

for role in control-plane-outbox-dispatcher telephony-command-worker telephony-infrastructure-worker telephony-event-normalizer telephony-reconciler; do
  rg -n -- "runtime-engine:|$role" infrastructure/docker/api/entrypoint infrastructure/compose/compose.yaml infrastructure/kubernetes/base/platform infrastructure/kubernetes/components/runtime-fencing >/dev/null ||
    fail "process role is not wired: $role"
done

grep -q "includeOperationTypes" apps/api/app/ControlPlane/RuntimeOperations/RuntimeOperationRepository.php ||
  fail "runtime operation repository does not support include type filtering"
grep -q "excludeOperationTypes" apps/api/app/ControlPlane/RuntimeOperations/RuntimeOperationRepository.php ||
  fail "runtime operation repository does not support exclude type filtering"
rg -F "excludeOperationTypes: [(string) config('telephony_domain.operation_types.runtime_fence')]" apps/api/routes/console.php >/dev/null ||
  fail "generic command worker does not exclude runtime fence operations"
rg -F "includeOperationTypes: [(string) config('telephony_domain.operation_types.runtime_fence')]" apps/api/routes/console.php >/dev/null ||
  fail "infrastructure worker does not include only runtime fence operations"
grep -q "runtime-engine:infrastructure-worker {--once" apps/api/routes/console.php ||
  fail "missing dedicated infrastructure worker command"
grep -q "runtime-engine:infrastructure-probe {--once" apps/api/routes/console.php ||
  fail "missing read-only infrastructure probe command"
if rg -n "scaleDeployment|RuntimeOperationRepository|conference_runtime_bindings|runtime_operations" apps/api/app/Infrastructure/RuntimeFencing/InfrastructureConnectivityProbe.php >/dev/null; then
  fail "infrastructure probe contains mutation, operation, or binding vocabulary"
fi
if rg -n "\{--(namespace|deployment|pod|runtime-node|conference|operation|scale|force)" apps/api/routes/console.php >/dev/null; then
  fail "infrastructure probe exposes target or mutation options"
fi

if ! printf '%s\n' 'ari-worker' 'public AriController' 'NullRuntimeAdapter' | rg -n "AriController|EslController|(^|[^[:alnum:]-])ari-worker([^[:alnum:]-]|$)|(^|[^[:alnum:]-])esl-worker([^[:alnum:]-]|$)|freeswitch-esl-events|FakeAsterisk|FakeFreeSwitch|NullRuntimeAdapter|NoopRuntimeAdapter" >/dev/null; then
  fail "legacy runtime vocabulary regression fixture did not match prohibited names"
fi

if printf '%s\n' 'asterisk-ari-events' | rg -n "AriController|EslController|(^|[^[:alnum:]-])ari-worker([^[:alnum:]-]|$)|(^|[^[:alnum:]-])esl-worker([^[:alnum:]-]|$)|freeswitch-esl-events|FakeAsterisk|FakeFreeSwitch|NullRuntimeAdapter|NoopRuntimeAdapter" >/dev/null; then
  fail "canonical asterisk-ari-events listener role matched prohibited legacy vocabulary"
fi

if rg -n "AriController|EslController|(^|[^[:alnum:]-])ari-worker([^[:alnum:]-]|$)|(^|[^[:alnum:]-])esl-worker([^[:alnum:]-]|$)|freeswitch-esl-events|FakeAsterisk|FakeFreeSwitch|NullRuntimeAdapter|NoopRuntimeAdapter" apps/api/app apps/api/routes infrastructure/kubernetes infrastructure/compose >/dev/null; then
  fail "found forbidden runtime-specific worker, listener, fallback adapter, or no-op simulator"
fi

if rg -n "api/v1/admin/(ari|esl|asterisk|freeswitch)|runtime-commands/execute|/reconcile|/project" apps/api/routes apps/api/app/Http apps/web/src >/dev/null; then
  fail "found forbidden public C3 management route"
fi

if rg -n "Http::|curl_init|stream_socket_client|WebSocket|Ratchet|Ari|ARI|ESL|FreeSwitch|Asterisk" apps/api/app/RuntimeEngine >/dev/null; then
  fail "runtime engine contains live runtime client or vendor-specific implementation"
fi

if rg -n "ignoreHTTPSErrors|curl -k|--insecure|mkcert -install|openssl req -x509" scripts/gateway Makefile >/dev/null; then
  fail "TLS lifecycle contains HTTPS bypass, CA install, or local self-signed fallback"
fi

if rg -n "tenant_id|runtime_node_id|operation_id|event_id|request_id|user_id" infrastructure/kubernetes/observability/alerts apps/api/config/runtime_engine.php >/dev/null; then
  fail "C3 observability configuration includes high-cardinality labels"
fi

kubectl kustomize infrastructure/kubernetes/base >/dev/null
runtime_fencing_render="$(mktemp)"
kubectl kustomize infrastructure/kubernetes/components/runtime-fencing > "$runtime_fencing_render"
python3 - "$runtime_fencing_render" <<'PY'
import sys
import yaml

path = sys.argv[1]
with open(path, 'r', encoding='utf-8') as handle:
    docs = [doc for doc in yaml.safe_load_all(handle) if doc]

def fail(message: str) -> None:
    print(f"runtime engine config check failed: {message}", file=sys.stderr)
    raise SystemExit(1)

objects = {(doc.get('kind'), doc.get('metadata', {}).get('namespace'), doc.get('metadata', {}).get('name')): doc for doc in docs}
expected = {
    ('ServiceAccount', 'utcp-platform', 'utcp-runtime-fencer'),
    ('Deployment', 'utcp-platform', 'utcp-runtime-fence-worker'),
    ('Role', 'utcp-runtime', 'utcp-runtime-fencer'),
    ('RoleBinding', 'utcp-runtime', 'utcp-runtime-fencer'),
}
if set(objects) != expected:
    fail(f"runtime fencing component rendered unexpected objects: {sorted(objects)}")
if any(doc.get('kind') in {'ClusterRole', 'ClusterRoleBinding'} for doc in docs):
    fail('runtime fencing component rendered cluster-scoped RBAC')

deployment = objects[('Deployment', 'utcp-platform', 'utcp-runtime-fence-worker')]
pod_spec = deployment['spec']['template']['spec']
if pod_spec.get('serviceAccountName') != 'utcp-runtime-fencer':
    fail('runtime fence worker does not use the fencer ServiceAccount')
if pod_spec.get('automountServiceAccountToken') is not False:
    fail('runtime fence worker automounts the default ServiceAccount token')
containers = pod_spec.get('containers') or []
if len(containers) != 1:
    fail('runtime fence worker must render one container')
worker = containers[0]
if worker.get('args') != ['telephony-infrastructure-worker']:
    fail('runtime fence worker command changed unexpectedly')
env_from = worker.get('envFrom') or []
config_names = [entry.get('configMapRef', {}).get('name') for entry in env_from if 'configMapRef' in entry]
secret_names = [entry.get('secretRef', {}).get('name') for entry in env_from if 'secretRef' in entry]
if config_names != ['utcp-application-config'] or secret_names != ['utcp-local-data-credentials']:
    fail('runtime fence worker does not reference canonical platform ConfigMap and Secret')
projected = [
    volume for volume in pod_spec.get('volumes') or []
    if volume.get('name') == 'kubernetes-api-credentials' and 'projected' in volume
]
if len(projected) != 1:
    fail('runtime fence worker must mount one explicit projected Kubernetes credential volume')
sources = projected[0]['projected'].get('sources') or []
token_sources = [source.get('serviceAccountToken') for source in sources if 'serviceAccountToken' in source]
if len(token_sources) != 1 or token_sources[0].get('path') != 'token' or token_sources[0].get('expirationSeconds') != 3600:
    fail('runtime fence worker projected token contract is invalid')

role = objects[('Role', 'utcp-runtime', 'utcp-runtime-fencer')]
rules = role.get('rules') or []
expected_rules = [
    {'apiGroups': ['apps'], 'resources': ['deployments'], 'verbs': ['get', 'list']},
    {'apiGroups': ['apps'], 'resources': ['deployments/scale'], 'verbs': ['get', 'patch']},
    {'apiGroups': [''], 'resources': ['pods'], 'verbs': ['get', 'list']},
]
if rules != expected_rules:
    fail('runtime fence Role is not the exact least-privilege rule set')

binding = objects[('RoleBinding', 'utcp-runtime', 'utcp-runtime-fencer')]
subjects = binding.get('subjects') or []
if subjects != [{'kind': 'ServiceAccount', 'name': 'utcp-runtime-fencer', 'namespace': 'utcp-platform'}]:
    fail('runtime fence RoleBinding subject must bind the platform ServiceAccount')
role_ref = binding.get('roleRef') or {}
if role_ref.get('kind') != 'Role' or role_ref.get('name') != 'utcp-runtime-fencer':
    fail('runtime fence RoleBinding roleRef must stay namespaced to the runtime Role')
PY
rm -f "$runtime_fencing_render"

printf 'runtime engine config check passed\n'
