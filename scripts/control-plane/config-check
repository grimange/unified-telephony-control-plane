#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

required_files=(
  "apps/api/app/ControlPlane/Shared/ExecutionContext.php"
  "apps/api/app/ControlPlane/RuntimeOperations/RuntimeOperationRepository.php"
  "apps/api/app/ControlPlane/Messaging/OutboxRepository.php"
  "apps/api/app/ControlPlane/Messaging/InboxRepository.php"
  "apps/api/app/ControlPlane/Idempotency/IdempotencyStore.php"
  "apps/api/app/ControlPlane/Audit/AuditRepository.php"
  "apps/api/database/migrations/2026_07_14_090000_create_control_plane_kernel_tables.php"
)

for file in "${required_files[@]}"; do
  test -f "$file"
done

printf 'control-plane-config-check: required C0 files exist\n'

# C4 legitimately owns the deterministic-simulator vocabulary, T0 owns the
# explicit Asterisk ARI adapter/listener/observability vocabulary, and T1 owns
# the explicit Kamailio registrar/registration-observer vocabulary. Future
# telephony-vendor behavior remains forbidden outside its bounded phase surface,
# and the simulator module must stay adapter-neutral and vendor-free.
if rg -n --glob '*.php' --glob '*.yaml' --glob '*.yml' \
  --glob '!tests/**' --glob '!vendor/**' --glob '!database/migrations/**' \
  --glob '!apps/api/app/Simulator/**' --glob '!apps/api/app/Providers/AppServiceProvider.php' \
  --glob '!apps/api/app/RuntimeAdapters/Asterisk/**' \
  --glob '!apps/api/app/TelephonyDomain/Signaling/**' \
  --glob '!apps/api/app/Http/Controllers/Platform/MetricsController.php' \
  --glob '!apps/api/routes/console.php' \
  --glob '!infrastructure/kubernetes/base/platform/asterisk-ari-events-deployment.yaml' \
  --glob '!infrastructure/kubernetes/base/runtime/**' \
  --glob '!infrastructure/kubernetes/observability/alerts/utcp-alerts.yaml' \
  --glob '!infrastructure/kubernetes/security/platform/allow-asterisk-ari-egress.yaml' \
  --glob '!infrastructure/kubernetes/security/platform/allow-asterisk-ari-events.yaml' \
  --glob '!infrastructure/kubernetes/security/runtime/**' \
  'FreeSwitch|FreeSWITCH|Kamailio|rtpengine|SimulatorRuntimeAdapter|FakeAsterisk|FakeFreeSwitch|SimulatedConference|SimulatedRegistration|AriController|\bESL\b|\bSIP\b|\bWSS\b|ConfBridge|PJSIP' \
  apps/api/app apps/api/routes infrastructure/kubernetes >/tmp/utcp-c0-forbidden.txt; then
  printf 'control-plane-config-check: forbidden runtime-specific vocabulary found in production code:\n' >&2
  cat /tmp/utcp-c0-forbidden.txt >&2
  exit 1
fi

if rg -n --glob '*.php' 'Asterisk|FreeSwitch|FreeSWITCH|Kamailio|rtpengine|AriController|\bARI\b|\bESL\b|\bSIP\b|\bWSS\b' \
  apps/api/app/Simulator >/tmp/utcp-c4-vendor.txt; then
  printf 'control-plane-config-check: forbidden telephony-vendor vocabulary found in the simulator module:\n' >&2
  cat /tmp/utcp-c4-vendor.txt >&2
  exit 1
fi

printf 'control-plane-config-check: no runtime-specific production vocabulary found\n'

if rg -n '/api/(ari|asterisk|freeswitch|runtime-nodes|conferences|telephony-sessions)' apps/api/routes >/tmp/utcp-c0-routes.txt; then
  printf 'control-plane-config-check: forbidden runtime-specific public route found:\n' >&2
  cat /tmp/utcp-c0-routes.txt >&2
  exit 1
fi

printf 'control-plane-config-check: no runtime-specific public routes found\n'

if rg -n 'freeswitch-esl-events|ari-worker|esl-worker' infrastructure/kubernetes >/tmp/utcp-c0-workloads.txt; then
  printf 'control-plane-config-check: forbidden future process role deployed in Kubernetes manifests:\n' >&2
  cat /tmp/utcp-c0-workloads.txt >&2
  exit 1
fi

printf 'control-plane-config-check: no future process roles deployed\n'

rg -n 'runtime_ops_claim_idx|runtime_ops_idempotency_unique|inbox_consumer_key_unique|idempotency_scope_key_unique|control_plane_audit_no_update' \
  apps/api/database/migrations/2026_07_14_090000_create_control_plane_kernel_tables.php >/dev/null
rg -n -F 'PayloadSafety::assertSafe' apps/api/app/ControlPlane >/dev/null
rg -n -F 'PayloadSafety::redact' apps/api/app/ControlPlane >/dev/null
rg -n -F 'StableJson::fingerprint' apps/api/app/ControlPlane >/dev/null
rg -n -F 'lock(' apps/api/app/ControlPlane >/dev/null

printf 'control-plane-config-check: migration indexes, safety checks, and locking primitives are present\n'

find apps/api/app/ControlPlane apps/api/tests/Feature/ControlPlane apps/api/tests/Unit/ControlPlane -name '*.php' -print0 \
  | xargs -0 -n1 php -l >/dev/null

printf 'control-plane-config-check: PHP syntax valid\n'
printf 'control-plane-config-check: PASS\n'
