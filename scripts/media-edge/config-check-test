#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$BASH_SOURCE")/../.." && pwd)"
CHECK="$ROOT/scripts/media-edge/config-check"
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

cp "$ROOT/versions.env" "$tmpdir/versions.env"
cp "$ROOT/infrastructure/k3d/cluster-media-edge.yaml" "$tmpdir/cluster.yaml"
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/rtpengine-media-service.yaml" "$tmpdir/service.yaml"
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/allow-rtpengine-external-media.yaml" "$tmpdir/external-policy.yaml"
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/generated/public-media.env" "$tmpdir/public-media.env"
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/kustomization.yaml" "$tmpdir/kustomization.yaml"
cp "$ROOT/infrastructure/kubernetes/overlays/local/kustomization.yaml" "$tmpdir/local-kustomization.yaml"
cp "$ROOT/infrastructure/docker/rtpengine/entrypoint" "$tmpdir/entrypoint"

validation_passes() {
  sh -c '. "$1"; "$2" "$3" "$4"' sh "$ROOT/infrastructure/docker/rtpengine/address-validation" "$1" "$2" "$3"
}

validation_fails() {
  if validation_passes "$@"; then
    printf 'media-edge validation mutation unexpectedly passed: %s %s\n' "$1" "$2" >&2
    exit 1
  fi
}

run_check() {
  UTCP_MEDIA_EDGE_VERSIONS="$tmpdir/versions.env" \
    UTCP_MEDIA_EDGE_K3D_CONFIG="$tmpdir/cluster.yaml" \
    UTCP_MEDIA_EDGE_SERVICE="$tmpdir/service.yaml" \
    UTCP_MEDIA_EDGE_EXTERNAL_POLICY="$tmpdir/external-policy.yaml" \
    UTCP_MEDIA_EDGE_ENTRYPOINT="$tmpdir/entrypoint" \
    UTCP_MEDIA_EDGE_GENERATED_PROJECTION="$tmpdir/public-media.env" \
    UTCP_MEDIA_EDGE_KUSTOMIZATION="$tmpdir/kustomization.yaml" \
    UTCP_MEDIA_EDGE_LOCAL_KUSTOMIZATION="$tmpdir/local-kustomization.yaml" \
    "$CHECK" >/dev/null
}

expect_fail() {
  local label="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf 'media-edge mutation unexpectedly passed: %s\n' "$label" >&2
    exit 1
  fi
}

run_check

validation_passes require_advertised_for_pod 127.0.0.1 192.0.2.10
validation_fails require_bindable_ipv4 127.0.0.1 192.0.2.10
validation_passes require_bindable_ipv4 192.0.2.10 192.0.2.10
validation_passes require_advertised_for_pod 192.0.2.11 192.0.2.10
validation_fails require_advertised_for_pod 192.0.2.10 192.0.2.10
validation_fails require_advertised_for_pod 0.0.0.0 192.0.2.10
validation_fails require_advertised_for_pod 169.254.1.1 192.0.2.10
validation_fails require_advertised_for_pod 224.0.0.1 192.0.2.10
validation_fails require_advertised_for_pod 192.0.2.255 192.0.2.10
validation_fails require_advertised_for_pod malformed 192.0.2.10

sed -i '/^UTCP_PUBLIC_MEDIA_ADDRESS=/d' "$tmpdir/versions.env"
expect_fail "missing public-address authority" run_check
cp "$ROOT/versions.env" "$tmpdir/versions.env"

rm -f "$tmpdir/public-media.env"
expect_fail "missing generated projection" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/generated/public-media.env" "$tmpdir/public-media.env"
sed -i 's/127.0.0.1/192.0.2.11/' "$tmpdir/public-media.env"
expect_fail "generated projection drift" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/generated/public-media.env" "$tmpdir/public-media.env"
printf 'UNRELATED=value\n' >> "$tmpdir/public-media.env"
expect_fail "generated projection extra variable" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/generated/public-media.env" "$tmpdir/public-media.env"
sed -i '1d' "$tmpdir/public-media.env"
expect_fail "generated projection marker removal" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/generated/public-media.env" "$tmpdir/public-media.env"
sed -i 's#generated/public-media.env#../../../../versions.env#' "$tmpdir/kustomization.yaml"
expect_fail "out-of-root versions reference" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/kustomization.yaml" "$tmpdir/kustomization.yaml"
printf 'load-restrictor: LoadRestrictionsNone\n' >> "$tmpdir/kustomization.yaml"
expect_fail "unrestricted kustomize loading" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/kustomization.yaml" "$tmpdir/kustomization.yaml"
printf 'UTCP_PUBLIC_MEDIA_ADDRESS=192.0.2.10\n' >> "$tmpdir/versions.env"
expect_fail "duplicate public-address authority" run_check
cp "$ROOT/versions.env" "$tmpdir/versions.env"

sed -i 's/browser_advertised_address/127.0.0.1 browser_advertised_address/' "$tmpdir/entrypoint"
expect_fail "hard-coded advertised address" run_check
cp "$ROOT/infrastructure/docker/rtpengine/entrypoint" "$tmpdir/entrypoint"
sed -i 's/--interface="runtime\/${POD_IP}!${POD_IP}"/--interface="runtime\/${POD_IP}!${browser_advertised_address}"/' "$tmpdir/entrypoint"
expect_fail "runtime interface public advertisement" run_check
cp "$ROOT/infrastructure/docker/rtpengine/entrypoint" "$tmpdir/entrypoint"
sed -i 's/--interface="runtime\/${POD_IP}!${POD_IP}"/--interface="internal\/${POD_IP}!${POD_IP}"/' "$tmpdir/entrypoint"
expect_fail "runtime interface name drift" run_check
cp "$ROOT/infrastructure/docker/rtpengine/entrypoint" "$tmpdir/entrypoint"
sed -i 's/--interface="browser\/${POD_IP}!${browser_advertised_address}"/--interface="external\/${POD_IP}!${browser_advertised_address}"/' "$tmpdir/entrypoint"
expect_fail "browser interface name drift" run_check
cp "$ROOT/infrastructure/docker/rtpengine/entrypoint" "$tmpdir/entrypoint"
sed -i 's/browser_advertised_address="$POD_IP"/browser_advertised_address="192.0.2.11"/' "$tmpdir/entrypoint"
expect_fail "browser fallback does not use Pod IP" run_check
cp "$ROOT/infrastructure/docker/rtpengine/entrypoint" "$tmpdir/entrypoint"
sed -i 's/browser_advertised_address="$UTCP_PUBLIC_MEDIA_ADDRESS"/browser_advertised_address="$POD_IP"/' "$tmpdir/entrypoint"
expect_fail "public address projection removed" run_check
cp "$ROOT/infrastructure/docker/rtpengine/entrypoint" "$tmpdir/entrypoint"

sed -i '/- name: media-40099/,$d' "$tmpdir/service.yaml"
expect_fail "missing NodePort entry" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/rtpengine-media-service.yaml" "$tmpdir/service.yaml"

sed -i '/^  ingress:/,/^      ports:/ s/^    - ports:/    - from:\n        - ipBlock:\n            cidr: 0.0.0.0\/0\n      ports:/' "$tmpdir/external-policy.yaml"
expect_fail "external policy source ipBlock" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/allow-rtpengine-external-media.yaml" "$tmpdir/external-policy.yaml"
sed -i '/^    - ports:/a\      from:\n        - podSelector: {}' "$tmpdir/external-policy.yaml"
expect_fail "external policy source selector" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/allow-rtpengine-external-media.yaml" "$tmpdir/external-policy.yaml"
sed -i 's/protocol: UDP/protocol: TCP/' "$tmpdir/external-policy.yaml"
expect_fail "external policy TCP" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/allow-rtpengine-external-media.yaml" "$tmpdir/external-policy.yaml"
sed -i 's/endPort: 40099/endPort: 40100/' "$tmpdir/external-policy.yaml"
expect_fail "external policy widened range" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/allow-rtpengine-external-media.yaml" "$tmpdir/external-policy.yaml"
sed -i 's/port: 40000/port: 2223/' "$tmpdir/external-policy.yaml"
expect_fail "external policy control port" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/allow-rtpengine-external-media.yaml" "$tmpdir/external-policy.yaml"
sed -i 's/port: 40000/port: 21000/' "$tmpdir/external-policy.yaml"
expect_fail "external policy runtime port" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/allow-rtpengine-external-media.yaml" "$tmpdir/external-policy.yaml"
sed -i '/^  policyTypes:/a\  egress: []' "$tmpdir/external-policy.yaml"
expect_fail "external policy egress" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/allow-rtpengine-external-media.yaml" "$tmpdir/external-policy.yaml"
sed -i 's/utcp.io\/network-role: rtpengine-media/utcp.io\/network-role: freeswitch-sip/' "$tmpdir/external-policy.yaml"
expect_fail "external policy runtime selector" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/allow-rtpengine-external-media.yaml" "$tmpdir/external-policy.yaml"

rm -f "$tmpdir/external-policy.yaml"
expect_fail "missing external policy" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/allow-rtpengine-external-media.yaml" "$tmpdir/external-policy.yaml"

if grep -Fq 'allow-rtpengine-external-media.yaml' "$ROOT/infrastructure/kubernetes/overlays/local/kustomization.yaml"; then
  printf 'canonical local overlay unexpectedly includes external media policy\n' >&2
  exit 1
fi
printf '\n  - allow-rtpengine-external-media.yaml\n' >> "$tmpdir/local-kustomization.yaml"
expect_fail "external policy added to default local overlay" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local/kustomization.yaml" "$tmpdir/local-kustomization.yaml"
sed -i '0,/protocol: UDP/{s/protocol: UDP/protocol: TCP/}' "$tmpdir/service.yaml"
expect_fail "TCP media publication" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/rtpengine-media-service.yaml" "$tmpdir/service.yaml"
sed -i '0,/externalTrafficPolicy: Local/{s/externalTrafficPolicy: Local/externalTrafficPolicy: Cluster/}' "$tmpdir/service.yaml"
expect_fail "non-local external traffic policy" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/rtpengine-media-service.yaml" "$tmpdir/service.yaml"
sed -i '0,/nodePort: 40000/{s/nodePort: 40000/nodePort: 39999/}' "$tmpdir/service.yaml"
expect_fail "port mismatch" run_check
cp "$ROOT/infrastructure/kubernetes/overlays/local-media-edge/rtpengine-media-service.yaml" "$tmpdir/service.yaml"
sed -i 's/127.0.0.1:40000-40099:40000-40099\/udp/0.0.0.0:40000-40099:40000-40099\/udp/' "$tmpdir/cluster.yaml"
expect_fail "wildcard host publication" run_check
cp "$ROOT/infrastructure/k3d/cluster-media-edge.yaml" "$tmpdir/cluster.yaml"
sed -i 's/utcp.dev\/media-edge=true/utcp.dev\/wrong=true/' "$tmpdir/cluster.yaml"
expect_fail "node label mismatch" run_check
cp "$ROOT/infrastructure/k3d/cluster-media-edge.yaml" "$tmpdir/cluster.yaml"

sed -i '/rtpengine-media-service.yaml/d' "$tmpdir/kustomization.yaml"
expect_fail "parity service removal" grep -q 'rtpengine-media-service' "$tmpdir/kustomization.yaml"

printf 'media-edge config mutation checks passed\n'
