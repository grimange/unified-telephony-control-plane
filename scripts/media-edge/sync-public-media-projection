#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
VERSIONS_FILE="${UTCP_MEDIA_EDGE_VERSIONS:-$ROOT/versions.env}"
DEFAULT_OUTPUT="$ROOT/infrastructure/kubernetes/overlays/local-media-edge/generated/public-media.env"
OUTPUT="${1:-$DEFAULT_OUTPUT}"
VALIDATION="$ROOT/infrastructure/docker/rtpengine/address-validation"
MARKER="# Generated by scripts/media-edge/sync-public-media-projection. Do not edit."

fail() { printf 'media-edge projection generation failed: %s\n' "$1" >&2; exit 1; }

[ -r "$VERSIONS_FILE" ] || fail "versions authority is missing: $VERSIONS_FILE"
[ -r "$VALIDATION" ] || fail "shared address validator is missing"

mapfile -t values < <(awk -F= '$1 == "UTCP_PUBLIC_MEDIA_ADDRESS" { print substr($0, index($0, "=") + 1) }' "$VERSIONS_FILE")
[ "${#values[@]}" -eq 1 ] || fail "UTCP_PUBLIC_MEDIA_ADDRESS must be declared exactly once"
value="${values[0]}"
[ -n "$value" ] || fail "UTCP_PUBLIC_MEDIA_ADDRESS must not be empty"

if ! sh -c '. "$1"; require_advertisable_ipv4 "$2"' sh "$VALIDATION" "$value"; then
  fail "UTCP_PUBLIC_MEDIA_ADDRESS is not advertisable: $value"
fi

target_dir="$(dirname "$OUTPUT")"
mkdir -p "$target_dir"
temporary="$(mktemp "$target_dir/.public-media.env.XXXXXX")"
trap 'rm -f "$temporary"' EXIT
printf '%s\nUTCP_PUBLIC_MEDIA_ADDRESS=%s\n' "$MARKER" "$value" >"$temporary"
chmod 0644 "$temporary"
mv -f "$temporary" "$OUTPUT"
trap - EXIT
