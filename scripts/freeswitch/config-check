#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
fail() { printf 'FreeSWITCH config check failed: %s\n' "$1" >&2; exit 1; }

dockerfile="${UTCP_FREESWITCH_DOCKERFILE:-$ROOT/infrastructure/docker/freeswitch/Dockerfile}"
freeswitch_xml="${UTCP_FREESWITCH_XML:-$ROOT/infrastructure/docker/freeswitch/config/freeswitch.xml}"
internal_xml="${UTCP_FREESWITCH_INTERNAL_XML:-$ROOT/infrastructure/docker/freeswitch/config/sip_profiles/utcp-internal.xml}"
dialplan="${UTCP_FREESWITCH_DIALPLAN:-$ROOT/infrastructure/docker/freeswitch/config/dialplan/utcp.xml}"
entrypoint="${UTCP_FREESWITCH_ENTRYPOINT:-$ROOT/infrastructure/docker/freeswitch/entrypoint}"
healthcheck="$ROOT/infrastructure/docker/freeswitch/healthcheck"
modules_xml="${UTCP_FREESWITCH_MODULES_XML:-$ROOT/infrastructure/docker/freeswitch/config/autoload_configs/modules.conf.xml}"
switch_xml="${UTCP_FREESWITCH_SWITCH_XML:-$ROOT/infrastructure/docker/freeswitch/config/autoload_configs/switch.conf.xml}"
sofia_xml="${UTCP_FREESWITCH_SOFIA_XML:-$ROOT/infrastructure/docker/freeswitch/config/autoload_configs/sofia.conf.xml}"
event_socket_xml="${UTCP_FREESWITCH_EVENT_SOCKET_XML:-$ROOT/infrastructure/docker/freeswitch/config/autoload_configs/event_socket.conf.xml}"
startup_smoke="${UTCP_FREESWITCH_STARTUP_SMOKE:-$ROOT/scripts/freeswitch/startup-smoke-test}"
sip_probe="${UTCP_FREESWITCH_SIP_PROBE:-$ROOT/scripts/freeswitch/sip-invite-smoke.py}"

for file in "$dockerfile" "$freeswitch_xml" "$internal_xml" "$dialplan" "$entrypoint" "$healthcheck" "$modules_xml" "$switch_xml" "$sofia_xml" "$event_socket_xml" "$startup_smoke" "$sip_probe"; do
  [ -s "$file" ] || fail "required FreeSWITCH file is missing: $file"
done

grep -Eq '^ARG FREESWITCH_BASE_IMAGE=.*@sha256:[0-9a-f]{64}$' "$dockerfile" || fail "image must be immutably pinned"
grep -Fq 'USER 1000:1000' "$dockerfile" || fail "image must preserve runtime UID/GID 1000"
grep -Fq '21000-21099/udp' "$dockerfile" || fail "image must expose the canonical RTP range"
grep -Eq '^exec (/usr/bin/)?freeswitch \\' "$entrypoint" || fail "entrypoint must exec FreeSWITCH"
grep -Eq '^[[:space:]]+-c[[:space:]]*\\$' "$entrypoint" || fail "-c must be argument-less"
grep -Fq -- '-conf /etc/freeswitch' "$entrypoint" || fail "-conf must point to the config directory"
grep -Fq -- '-log /var/log/freeswitch' "$entrypoint" || fail "-log directory is missing"
grep -Fq -- '-db /var/lib/freeswitch/db' "$entrypoint" || fail "-db directory is missing"
grep -Fq -- '-run /var/run/freeswitch' "$entrypoint" || fail "-run directory is missing"
grep -Fq 'rtp-start-port" value="21000' "$switch_xml" || fail "explicit RTP start is missing"
grep -Fq 'rtp-end-port" value="21099' "$switch_xml" || fail "explicit RTP end is missing"
grep -Fq 'sip-port" value="5060' "$internal_xml" || fail "internal SIP listener is missing"
grep -Fq '<domain name="all" alias="false" parse="false"/>' "$internal_xml" || fail "application-peer domain semantics are missing"
if grep -Fq '<domain name="all" alias="true"' "$internal_xml"; then fail "registered-endpoint domain aliasing is forbidden"; fi
grep -Fq 'inbound-codec-prefs" value="PCMU' "$internal_xml" || fail "minimal PCMU codec contract is missing"
grep -Fq 'destination_number" expression="^9900$"' "$dialplan" || fail "9900 Echo fixture is missing"
grep -Fq 'application="answer"' "$dialplan" || fail "Echo fixture must answer"
grep -Fq 'application="echo"' "$dialplan" || fail "Echo fixture must echo media"
grep -Fq '<document type="freeswitch/xml">' "$freeswitch_xml" || fail "official XML document root is missing"
grep -Fq '<section name="configuration"' "$freeswitch_xml" || fail "configuration section is missing"
grep -Fq '<section name="dialplan"' "$freeswitch_xml" || fail "dialplan section is missing"
grep -Fq 'autoload_configs/*.xml' "$freeswitch_xml" || fail "autoload configuration include is missing"
grep -Fq 'dialplan/*.xml' "$freeswitch_xml" || fail "dialplan include is missing"
grep -Fq '<load module="mod_console"' "$modules_xml" || fail "mod_console is missing"
grep -Fq '<load module="mod_commands"' "$modules_xml" || fail "mod_commands is missing"
grep -Fq '<load module="mod_dialplan_xml"' "$modules_xml" || fail "mod_dialplan_xml is missing"
grep -Fq '<load module="mod_dptools"' "$modules_xml" || fail "mod_dptools is missing"
grep -Fq '<load module="mod_sofia"' "$modules_xml" || fail "mod_sofia is missing"
grep -Fq '<load module="mod_event_socket"' "$modules_xml" || fail "mod_event_socket is missing"
grep -Fq '../sip_profiles/*.xml' "$sofia_xml" || fail "normal Sofia profile include is missing"
grep -Fq 'listen-ip" value="127.0.0.1' "$event_socket_xml" || fail "Event Socket must bind loopback"
grep -Fq 'utcp_esl_password' "$event_socket_xml" || fail "Event Socket must use the injected secret"
grep -Fq 'exec-set' "$entrypoint" || fail "Event Socket secret expansion is missing"
test -x "$healthcheck" || fail "healthcheck must be executable"
if grep -Eiq 'ClueCon|listen-ip" value="(0\.0\.0\.0|::)' "$event_socket_xml"; then fail "unsafe Event Socket configuration"; fi
if grep -Eiq 'accept-blind-auth|accept-blind-reg|407[[:space:]]+retry|Authorization:|Proxy-Authorization:|auth[_-](user(name)?|pass(word)?)' "$internal_xml" "$ROOT/infrastructure/kubernetes/base/platform/kamailio-configmap.yaml"; then fail "downstream or blind authentication is forbidden"; fi
if grep -Fq 'tcpSocket' "$ROOT/infrastructure/kubernetes/components/freeswitch-instance/freeswitch-deployment.yaml"; then fail "TCP probes cannot target UDP SIP"; fi
if grep -Fq -- '-c /etc/freeswitch' "$entrypoint" || grep -Fq -- '-nf' "$entrypoint"; then fail "invalid startup flags remain"; fi
grep -Fq 'scripts/freeswitch/sip-invite-smoke.py' "$startup_smoke" || fail "startup smoke must execute the real SIP INVITE probe"
grep -Fq 'docker exec' "$startup_smoke" || fail "startup smoke must inspect the running FreeSWITCH container"
grep -Fq 'show channels' "$startup_smoke" || fail "startup smoke must verify the active channel"
grep -Fq 'show channels count' "$startup_smoke" || fail "startup smoke must verify channel cleanup"
grep -Fq 'INVITE ' "$sip_probe" || fail "SIP probe must send an INVITE"
grep -Fq 'Content-Type: application/sdp' "$sip_probe" || fail "SIP probe must send SDP"
grep -Fq 'remote_target' "$sip_probe" || fail "SIP probe must use the response Contact target"
grep -Fq 'ACK ' "$sip_probe" || fail "SIP probe must send ACK"
grep -Fq 'BYE ' "$sip_probe" || fail "SIP probe must send BYE"
if grep -Eiq '^[[:space:]]*(Authorization|Proxy-Authorization):' "$sip_probe"; then fail "SIP probe must not send downstream digest credentials"; fi
for status in 401 407 403; do
  grep -Fq "SIP/2.0 $status" "$sip_probe" || fail "SIP probe must reject $status"
done
grep -Fq 'SIP/2.0 200' "$sip_probe" || fail "SIP probe must require 200 OK"
python3 -m py_compile "$sip_probe" || fail "SIP probe must be valid Python"

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT
kubectl kustomize infrastructure/kubernetes/overlays/local-freeswitch >"$tmp_dir/render.yaml" || fail "FreeSWITCH overlay does not render"
kubectl kustomize infrastructure/kubernetes/security >"$tmp_dir/security.yaml" || fail "security overlay does not render"

python3 - "$ROOT" "$tmp_dir/render.yaml" "$tmp_dir/security.yaml" <<'PY'
from __future__ import annotations

import re
import sys
from pathlib import Path
from typing import Any

import yaml

root = Path(sys.argv[1])
render = [d for d in yaml.safe_load_all(Path(sys.argv[2]).read_text()) if isinstance(d, dict)]
security = [d for d in yaml.safe_load_all(Path(sys.argv[3]).read_text()) if isinstance(d, dict)]

def key(doc: dict[str, Any]) -> str:
    meta = doc.get("metadata") or {}
    return f"{doc.get('kind')}/{meta.get('namespace')}/{meta.get('name')}"

objects = {key(d): d for d in render}
security_objects = {key(d): d for d in security}

def fail(message: str) -> None:
    print(f"FreeSWITCH config check failed: {message}", file=sys.stderr)
    raise SystemExit(1)

def labels(doc: dict[str, Any]) -> dict[str, Any]:
    return ((doc.get("spec") or {}).get("template") or {}).get("metadata", {}).get("labels", {})

def exact_peer(peer: dict[str, Any], namespace: str, pod: dict[str, str]) -> bool:
    return "ipBlock" not in peer and (peer.get("namespaceSelector") or {}).get("matchLabels") == {"kubernetes.io/metadata.name": namespace} and (peer.get("podSelector") or {}).get("matchLabels") == pod

def has_rule(rules: list[dict[str, Any]], side: str, namespace: str, pod: dict[str, str], start: int, end: int | None = None) -> bool:
    for rule in rules:
        peers = rule.get(side) or []
        ports = rule.get("ports") or []
        expected = {"protocol": "UDP", "port": start}
        if end is not None:
            expected["endPort"] = end
        if len(peers) == 1 and ports == [expected] and exact_peer(peers[0], namespace, pod):
            return True
    return False

fs_pod = {
    "app.kubernetes.io/component": "freeswitch",
    "utcp.io/network-role": "freeswitch-sip",
    "utcp.dev/runtime-node": "local-freeswitch-esl",
}
fs_template_labels = {
    "app.kubernetes.io/part-of": "utcp",
    **fs_pod,
    "utcp.dev/runtime-selection": "selected-application-runtime",
}
rtp_pod = {"utcp.io/network-role": "rtpengine-media"}
kamailio_pod = {"utcp.io/network-role": "kamailio-signaling"}
deployment = objects.get("Deployment/utcp-runtime/freeswitch")
service = objects.get("Service/utcp-runtime/freeswitch-sip")
selected = objects.get("Service/utcp-runtime/application-runtime-sip")
if not deployment or not service or not selected:
    fail("FreeSWITCH Deployment and both internal SIP Services are required")
if service["spec"].get("type") != "ClusterIP" or selected["spec"].get("type") != "ClusterIP":
    fail("FreeSWITCH SIP Services must be ClusterIP")
if service["spec"].get("selector") != {"app.kubernetes.io/component": "freeswitch", "utcp.dev/runtime-node": "local-freeswitch-esl"}:
    fail("FreeSWITCH SIP Service selector is not canonical")
if selected["spec"].get("selector") != {"app.kubernetes.io/component": "freeswitch", "utcp.dev/runtime-node": "local-freeswitch-esl", "utcp.dev/runtime-selection": "selected-application-runtime"}:
    fail("selected-runtime Service must select exactly FreeSWITCH in this overlay")
if (deployment.get("spec") or {}).get("replicas") != 1:
    fail("FreeSWITCH must have one selected replica")
template = (deployment.get("spec") or {}).get("template") or {}
if labels(deployment) != fs_template_labels:
    fail("FreeSWITCH runtime labels are not canonical")
pod_spec = template.get("spec") or {}
if pod_spec.get("automountServiceAccountToken") is not False:
    fail("FreeSWITCH must not receive a Kubernetes API token")
security_context = pod_spec.get("securityContext") or {}
if security_context.get("runAsUser") != 1000 or security_context.get("runAsGroup") != 1000 or security_context.get("fsGroup") != 1000 or security_context.get("runAsNonRoot") is not True:
    fail("FreeSWITCH must run non-root as UID/GID 1000")
container = (pod_spec.get("containers") or [{}])[0]
if not str(container.get("image", "")).endswith("/freeswitch:0.1.0-t3-s2c"):
    fail("FreeSWITCH image authority drifted")
if (container.get("securityContext") or {}).get("readOnlyRootFilesystem") is not True:
    fail("FreeSWITCH root filesystem must be read-only")
volume_mounts = {mount.get("mountPath"): mount.get("name") for mount in container.get("volumeMounts") or []}
for path in ("/var/log/freeswitch", "/var/run/freeswitch", "/var/lib/freeswitch"):
    if path not in volume_mounts:
        fail(f"FreeSWITCH writable path is not mounted: {path}")
volume_names = {volume.get("name") for volume in pod_spec.get("volumes") or [] if volume.get("emptyDir") is not None}
if not volume_names or any(volume_mounts[path] not in volume_names for path in ("/var/log/freeswitch", "/var/run/freeswitch", "/var/lib/freeswitch")):
    fail("FreeSWITCH writable state must use bounded emptyDir storage")
if not (container.get("startupProbe") or {}).get("exec", {}).get("command") == ["/usr/local/bin/utcp-freeswitch-healthcheck"]:
    fail("FreeSWITCH startup probe must use the executable healthcheck")
if not (container.get("readinessProbe") or {}).get("exec", {}).get("command") == ["/usr/local/bin/utcp-freeswitch-healthcheck"]:
    fail("FreeSWITCH readiness probe must use the executable healthcheck")
if not (container.get("livenessProbe") or {}).get("exec", {}).get("command") == ["/usr/local/bin/utcp-freeswitch-healthcheck"]:
    fail("FreeSWITCH liveness probe must use the executable healthcheck")

fs_policy = security_objects.get("NetworkPolicy/utcp-runtime/allow-freeswitch-sip-from-kamailio")
rtp_policy = security_objects.get("NetworkPolicy/utcp-platform/allow-rtpengine-media")
kamailio_policy = security_objects.get("NetworkPolicy/utcp-platform/allow-kamailio-signaling-required-traffic")
if not fs_policy or not rtp_policy or not kamailio_policy:
    fail("FreeSWITCH reciprocal and Kamailio policies are required")
spec = fs_policy.get("spec") or {}
if (spec.get("podSelector") or {}).get("matchLabels") != fs_pod:
    fail("FreeSWITCH policy selector must be exact")
if not has_rule(spec.get("ingress") or [], "from", "utcp-platform", kamailio_pod, 5060):
    fail("FreeSWITCH ingress from Kamailio UDP 5060 is missing")
if not has_rule(spec.get("egress") or [], "to", "utcp-platform", kamailio_pod, 5060):
    fail("FreeSWITCH egress to Kamailio UDP 5060 is missing")
if not has_rule(spec.get("ingress") or [], "from", "utcp-platform", rtp_pod, 21000, 21099):
    fail("FreeSWITCH ingress from rtpengine must use destination RTP range 21000-21099")
if not has_rule(spec.get("egress") or [], "to", "utcp-platform", rtp_pod, 40000, 40099):
    fail("FreeSWITCH egress to rtpengine must use destination media range 40000-40099")
rtp_spec = rtp_policy.get("spec") or {}
if not has_rule(rtp_spec.get("ingress") or [], "from", "utcp-runtime", fs_pod, 40000, 40099):
    fail("rtpengine ingress from FreeSWITCH is missing")
if not has_rule(rtp_spec.get("egress") or [], "to", "utcp-runtime", fs_pod, 21000, 21099):
    fail("rtpengine egress to FreeSWITCH must use FreeSWITCH destination range")
if not has_rule((kamailio_policy.get("spec") or {}).get("ingress") or [], "from", "utcp-runtime", fs_pod, 5060):
    fail("Kamailio ingress from FreeSWITCH is missing")
if not has_rule((kamailio_policy.get("spec") or {}).get("egress") or [], "to", "utcp-runtime", fs_pod, 5060):
    fail("Kamailio egress to FreeSWITCH is missing")

kamailio = (root / "infrastructure/kubernetes/base/platform/kamailio-configmap.yaml").read_text()
if "route[APPLICATION_RUNTIME_RELAY]" not in kamailio or "application-runtime-sip.utcp-runtime.svc.cluster.local:5060" not in kamailio:
    fail("Kamailio must use the generic selected-runtime SIP destination")
if re.search(r"FREESWITCH|freeswitch|ESL|esl", kamailio):
    fail("generic Kamailio configuration must not contain provider-specific FreeSWITCH authority")
if "route[MEDIA_OFFER]" not in kamailio or "route[MEDIA_ANSWER]" not in kamailio or "route[MEDIA_DELETE]" not in kamailio:
    fail("generic media routes must remain present")
if "REGISTER" not in kamailio or "route[WITHINDLG]" not in kamailio:
    fail("generic REGISTER and dialog routes must remain present")
def block_after(config: str, marker: str) -> str:
    start = config.find(marker)
    if start < 0:
        fail(f"Kamailio route block is missing: {marker}")
    brace = config.find("{", start + len(marker))
    depth = 0
    for index in range(brace, len(config)):
        if config[index] == "{":
            depth += 1
        elif config[index] == "}":
            depth -= 1
            if depth == 0:
                return config[brace + 1:index]
    fail(f"Kamailio route block is unterminated: {marker}")
application_block = block_after(kamailio, "route[APPLICATION_DIALOG]")
register_block = block_after(kamailio, 'if ($rm == "REGISTER")')
if application_block.count("consume_credentials()") != 1:
    fail("authenticated application INVITE must consume credentials exactly once")
if not (application_block.find('www_authorize("$fd", "kamailio_signaling_auth_view")') < application_block.find("consume_credentials()") < application_block.find("route(APPLICATION_RUNTIME_RELAY)")):
    fail("credential consumption must follow authentication and precede runtime relay")
if "consume_credentials()" in register_block:
    fail("REGISTER must retain its existing authentication lifecycle")
if re.search(r"accept-blind-auth|accept-blind-reg|407|Authorization:|Proxy-Authorization:|auth[_-](user(name)?|pass(word)?)", kamailio, re.I):
    fail("downstream or blind authentication is forbidden in Kamailio")
if any("ipBlock" in peer for policy in security_objects.values() if policy.get("kind") == "NetworkPolicy" for rule in (policy.get("spec") or {}).get("ingress", []) + (policy.get("spec") or {}).get("egress", []) for peer in rule.get("from", []) + rule.get("to", [])):
    fail("FreeSWITCH security validation must not permit ipBlock peers")

for doc in render:
    if doc.get("kind") == "Service" and doc.get("metadata", {}).get("namespace") == "utcp-runtime" and doc.get("metadata", {}).get("name") in {"freeswitch-sip", "application-runtime-sip"}:
        if (doc.get("spec") or {}).get("type") != "ClusterIP":
            fail("public FreeSWITCH SIP exposure is forbidden")
    if "LoadBalancer" == (doc.get("spec") or {}).get("type") and "freeswitch" in str(doc).lower():
        fail("public FreeSWITCH exposure is forbidden")
    if doc.get("kind") == "Service" and "8021" in str(doc.get("spec") or {}):
        fail("Event Socket must not have a Kubernetes Service")

print("FreeSWITCH config check passed")
PY
