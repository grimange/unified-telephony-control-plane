#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
image="${UTCP_FREESWITCH_IMAGE:-utcp-freeswitch:dev}"
container="utcp-freeswitch-startup-smoke-$$"
tmp="$(mktemp -d)"
cleanup() {
  docker rm -f "$container" >/dev/null 2>&1 || true
  rm -rf "$tmp"
}
trap cleanup EXIT

make image-build-freeswitch UTCP_FREESWITCH_IMAGE="$image" >/dev/null
mkdir -p "$tmp/run" "$tmp/db"
chown -R 1000:1000 "$tmp"
esl_password=utcp_freeswitch_smoke_secret

docker run -d --name "$container" \
  --user 1000:1000 \
  --read-only \
  --cap-drop ALL \
  --tmpfs /tmp:rw,noexec,nosuid,nodev \
  -e UTCP_ESL_PASSWORD="$esl_password" \
  -v "$tmp/run:/var/run/freeswitch" \
  -v "$tmp/db:/var/lib/freeswitch" \
  "$image" >/dev/null

deadline=$((SECONDS + 45))
while :; do
  logs="$(docker logs "$container" 2>&1 || true)"
  if printf '%s\n' "$logs" | grep -Eiq 'Unknown option|parse error|markup outside of root|permission denied'; then
    printf '%s\n' "$logs" >&2
    exit 1
  fi
  if docker exec "$container" /usr/local/bin/utcp-freeswitch-healthcheck >/dev/null 2>&1; then
    break
  fi
  if [ "$SECONDS" -ge "$deadline" ]; then
    printf '%s\n' "$logs" >&2
    exit 1
  fi
  sleep 1
done

startup_logs="$(docker logs "$container" 2>&1 || true)"
grep -Eq 'FreeSWITCH|CONSOLE' <<<"$startup_logs" || {
  printf '%s\n' "$startup_logs" >&2
  printf 'FreeSWITCH console logs were not emitted to container stdout/stderr\n' >&2
  exit 1
}

docker exec "$container" sh -eu -c '
  modules="$(fs_cli -q -H 127.0.0.1 -P 8021 -p "$UTCP_ESL_PASSWORD" -x "show modules")"
  for module in mod_console mod_commands mod_dialplan_xml mod_dptools mod_sofia mod_event_socket; do
    printf "%s\n" "$modules" | grep -q "$module"
  done
  profile="$(fs_cli -q -H 127.0.0.1 -P 8021 -p "$UTCP_ESL_PASSWORD" -x "sofia status")"
  printf "%s\n" "$profile" | grep -E 'utcp-internal.*RUNNING'
  printf "%s\n" "$profile" | grep -q 5060
  fs_cli -q -H 127.0.0.1 -P 8021 -p "$UTCP_ESL_PASSWORD" -x "sofia status" | grep -q "utcp-internal"
  grep -q 'rtp-start-port.*21000' /etc/freeswitch/autoload_configs/switch.conf.xml
  grep -q 'rtp-end-port.*21099' /etc/freeswitch/autoload_configs/switch.conf.xml
  grep -q 9900 /etc/freeswitch/dialplan/utcp.xml
  test -w /var/run/freeswitch
  test -w /var/lib/freeswitch/db
'

container_ip="$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$container")"
[ -n "$container_ip" ] || { printf 'FreeSWITCH container IP is missing\n' >&2; exit 1; }
sip_log="$tmp/sip-smoke.log"
UTCP_SIP_SMOKE_HOLD_SECONDS=1 python3 scripts/freeswitch/sip-invite-smoke.py "$container_ip" >"$sip_log" 2>&1 &
sip_pid=$!
channel_deadline=$((SECONDS + 8))
channel_seen=0
while [ "$SECONDS" -lt "$channel_deadline" ]; do
  channels="$(docker exec "$container" fs_cli -q -H 127.0.0.1 -P 8021 -p "$esl_password" -x "show channels" 2>/dev/null || true)"
  if printf '%s\n' "$channels" | grep -Eq '9900|utcp-echo'; then
    channel_seen=1
    break
  fi
  sleep 0.2
done
if [ "$channel_seen" -ne 1 ]; then
  cat "$sip_log" >&2
  kill "$sip_pid" 2>/dev/null || true
  wait "$sip_pid" 2>/dev/null || true
  printf 'FreeSWITCH SIP smoke test did not reach extension 9900/Echo\n' >&2
  exit 1
fi
wait "$sip_pid" || { cat "$sip_log" >&2; exit 1; }
cat "$sip_log"
cleanup_deadline=$((SECONDS + 8))
final_channels=""
while [ "$SECONDS" -lt "$cleanup_deadline" ]; do
  final_channels="$(docker exec "$container" fs_cli -q -H 127.0.0.1 -P 8021 -p "$esl_password" -x "show channels count")"
  if printf '%s\n' "$final_channels" | grep -Eq '(^|[^0-9])0 (session\(s\)|total\.)'; then
    break
  fi
  sleep 0.2
done
printf '%s\n' "$final_channels" | grep -Eq '(^|[^0-9])0 (session\(s\)|total\.)' || {
  printf '%s\n' "$final_channels" >&2
  printf 'FreeSWITCH SIP smoke test left an active channel\n' >&2
  exit 1
}

docker kill --signal TERM "$container" >/dev/null
for _ in $(seq 1 15); do
  if ! docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null | grep -q true; then
    printf 'FreeSWITCH startup smoke test passed\n'
    exit 0
  fi
  sleep 1
done
printf '%s\n' "$(docker logs "$container" 2>&1)" >&2
exit 1
