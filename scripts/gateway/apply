#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/gateway/lib
. "$SCRIPT_DIR/lib"

required_tools
ensure_kubeconfig
if [ "$GATEWAY_ENVIRONMENT" = "native-k3s" ]; then
  kube get node utcp-dev01 -o jsonpath='{.metadata.name}' | grep -Fxq utcp-dev01
  "$ROOT/scripts/native-k3s/config-check" >/dev/null
else
  "$ROOT/scripts/k3d/runtime-ready" >/dev/null
  "$ROOT/scripts/kubernetes/config-check" >/dev/null
  "$ROOT/scripts/kubernetes/status" >/dev/null
  check_edge_bindings
fi
"$SCRIPT_DIR/install-crds"
"$SCRIPT_DIR/install-traefik"
if [ "$GATEWAY_ENVIRONMENT" = "native-k3s" ]; then
  check_edge_bindings
fi
kube apply -k "$GATEWAY_KUSTOMIZATION"
"$SCRIPT_DIR/tls-apply"
wait_gateway
"$SCRIPT_DIR/status"
printf 'K2 gateway applied. Proof command: make gateway-proof\n'
