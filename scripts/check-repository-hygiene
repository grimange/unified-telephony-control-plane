#!/usr/bin/env bash
set -euo pipefail

required_docs=(
  "README.md"
  "CONTRIBUTING.md"
  "SECURITY.md"
  "docs/architecture/overview.md"
  "docs/architecture/authority-boundaries.md"
  "docs/roadmap/implementation-roadmap.md"
  "docs/roadmap/phase-status.md"
  "infrastructure/kubernetes/README.md"
  "docs/provenance.md"
)

required_adrs=(
  "docs/decisions/ADR-001-modular-monolith.md"
  "docs/decisions/ADR-002-compose-and-kubernetes.md"
  "docs/decisions/ADR-003-kustomize-and-helm.md"
  "docs/decisions/ADR-004-traefik-web-ingress.md"
  "docs/decisions/ADR-005-simulator-first.md"
  "docs/decisions/ADR-006-hybrid-deployment-targets.md"
  "docs/decisions/ADR-007-postgresql-canonical-redis-transient.md"
  "docs/decisions/ADR-008-container-process-contract.md"
  "docs/decisions/ADR-009-local-compose-gateway-topology.md"
)

for path in "${required_docs[@]}" "${required_adrs[@]}"; do
  if [ ! -s "$path" ]; then
    printf 'missing required documentation: %s\n' "$path" >&2
    exit 1
  fi
done

declared_phase="$(sed -n 's/^UTCP_PHASE=//p' versions.env | tail -n 1)"
if [ "$declared_phase" != "T1" ]; then
  printf 'UTCP_PHASE must match the authoritative completed phase T1, found: %s\n' "$declared_phase" >&2
  exit 1
fi

if ! python3 scripts/validate-phase-status \
  docs/roadmap/phase-status.md \
  'T1 Kamailio SIP-over-WSS signaling' \
  'Complete'; then
  printf 'phase-status document does not mark T1 complete while UTCP_PHASE=%s\n' "$declared_phase" >&2
  exit 1
fi

scripts/local/config-check

python3 - <<'PY'
from pathlib import Path
import re
import sys

style_path = Path("apps/web/src/style.css")
css = style_path.read_text(encoding="utf-8")
production_layout_sources = [style_path, *Path("apps/web/src").glob("**/*.vue")]

for source_path in production_layout_sources:
    source = source_path.read_text(encoding="utf-8")
    if re.search(r"overflow-x\s*:\s*hidden", source):
        sys.stderr.write(f"responsive overflow must not be masked with overflow-x:hidden: {source_path}\n")
        sys.exit(1)

for selector in ["#app", ".app-shell", ".shell", ".workspace", ".shell-content"]:
    selector_pattern = re.escape(selector).replace(r"\ ", r"\s+")
    if re.search(rf"{selector_pattern}\s*\{{[^}}]*overflow-x\s*:\s*(hidden|clip)", css, re.S):
        sys.stderr.write(f"{selector} must not clip horizontal overflow at the root or page boundary\n")
        sys.exit(1)

if not re.search(r"#app\s*\{[^}]*min-width\s*:\s*0", css, re.S):
    sys.stderr.write("App root must keep bounded sizing semantics with min-width:0\n")
    sys.exit(1)

if not re.search(r"\.app-shell\s*\{[^}]*width\s*:\s*min\([^}]*min-width\s*:\s*0", css, re.S):
    sys.stderr.write("AppShell must retain viewport-bounded width and min-width:0\n")
    sys.exit(1)

if not re.search(r"\.workspace\s*\{[^}]*width\s*:\s*100%[^}]*max-width\s*:\s*100%", css, re.S):
    sys.stderr.write("stable route page containers must be width-bounded\n")
    sys.exit(1)

if not re.search(r"\.topbar,\s*[\s\S]*?\.section-heading\s*\{[^}]*flex-wrap\s*:\s*wrap", css, re.S):
    sys.stderr.write("AppShell and page headings must retain shared wrapping behavior\n")
    sys.exit(1)

if not re.search(r"\.topbar-actions\s*\{[^}]*flex-wrap\s*:\s*wrap[^}]*max-width\s*:\s*100%", css, re.S):
    sys.stderr.write("AppShell action groups must retain wrapping and width containment\n")
    sys.exit(1)

if not re.search(r"\.ui-filter-bar__controls\s*\{[^}]*grid-template-columns\s*:\s*repeat\(2,\s*minmax\(0,\s*1fr\)\)[^}]*min-width\s*:\s*0", css, re.S):
    sys.stderr.write("filter controls must use bounded responsive grid tracks\n")
    sys.exit(1)

if not re.search(r"\.inline-form\s*\{[^}]*min-width\s*:\s*0", css, re.S):
    sys.stderr.write("inline forms must use bounded sizing semantics\n")
    sys.exit(1)

if not re.search(r"\.data-row strong,\s*[\s\S]*?code\s*\{[^}]*overflow-wrap\s*:\s*anywhere", css, re.S):
    sys.stderr.write("long identifiers and inline code must retain wrapping behavior\n")
    sys.exit(1)

if not re.search(r"\.ui-panel,\s*[\s\S]*?\.detail-section\s*\{[^}]*min-width\s*:\s*0[^}]*max-width\s*:\s*100%", css, re.S):
    sys.stderr.write("shared panels and detail panels must remain width-contained\n")
    sys.exit(1)

match = re.search(r"@media \(max-width: 720px\) \{(?P<body>.*)\n\}", css, re.S)
if not match:
    sys.stderr.write("missing narrow responsive media block in apps/web/src/style.css\n")
    sys.exit(1)

body = match.group("body")
if not re.search(r"\.data-row\s*\{[^}]*flex-wrap\s*:\s*nowrap[^}]*height\s*:\s*auto", body, re.S):
    sys.stderr.write("narrow .data-row must set flex-wrap: nowrap and height: auto\n")
    sys.exit(1)

if not re.search(r"\.topbar,\s*\.section-heading,\s*\.data-row\s*\{[^}]*flex-direction\s*:\s*column", body, re.S):
    sys.stderr.write("narrow .data-row must remain a vertical flex column\n")
    sys.exit(1)

if not re.search(r"\.section-heading\s*\{[^}]*min-width\s*:\s*0[^}]*flex-wrap\s*:\s*wrap", css, re.S):
    sys.stderr.write("RuntimeNodes heading must permit narrow wrapping with min-width:0\n")
    sys.exit(1)

if not re.search(r"\.live-updates-badge\s*\{[^}]*max-width\s*:\s*100%[^}]*white-space\s*:\s*normal[^}]*overflow-wrap\s*:\s*anywhere", css, re.S):
    sys.stderr.write("RuntimeNodes live-update badge must remain readable in narrow layouts\n")
    sys.exit(1)

if not re.search(r"\.topbar,\s*\.section-heading,\s*\.data-row\s*\{[^}]*align-items\s*:\s*stretch[^}]*flex-direction\s*:\s*column", body, re.S):
    sys.stderr.write("narrow RuntimeNodes heading must stack without page-level overflow\n")
    sys.exit(1)

if not re.search(r"\.conference-detail-grid,\s*\.runtime-operation-detail-grid,\s*\.runtime-reconciliation-detail-grid,\s*\.audit-record-detail-grid\s*\{[^}]*grid-template-columns\s*:\s*minmax\(0,\s*0\.9fr\)\s*minmax\(0,\s*1\.1fr\)", css, re.S):
    sys.stderr.write("Conference, Runtime Operation, Runtime Reconciliation, and Audit detail layout must bound grid tracks with minmax(0,...)\n")
    sys.exit(1)

if not re.search(r"\.conference-row,\s*\.operation-row,\s*\.audit-record-row,\s*\.participant-row\s*\{[^}]*max-width\s*:\s*100%", css, re.S):
    sys.stderr.write("Conference, Runtime Operation, and Audit rows must remain bounded in narrow layouts\n")
    sys.exit(1)

if not re.search(r"\.conference-detail-grid,\s*\.runtime-operation-detail-grid,\s*\.runtime-reconciliation-detail-grid,\s*\.audit-record-detail-grid,\s*\.definition-grid\s*\{[^}]*grid-template-columns\s*:\s*1fr", body, re.S):
    sys.stderr.write("Conference, Runtime Operation, Runtime Reconciliation, and Audit detail grids must collapse to one column in narrow layouts\n")
    sys.exit(1)
PY

python3 - <<'PY'
from pathlib import Path
import re
import sys

runtime_view = Path("apps/web/src/views/RuntimeNodesView.vue").read_text(encoding="utf-8")
runtime_operations_view = Path("apps/web/src/views/RuntimeOperationsView.vue").read_text(encoding="utf-8")
audit_records_view = Path("apps/web/src/views/AuditRecordsView.vue").read_text(encoding="utf-8")
app_state = Path("apps/web/src/state/appState.ts").read_text(encoding="utf-8")
notifications = Path("apps/web/src/state/notifications.ts").read_text(encoding="utf-8")

if 'id="credential-secret"' in runtime_view:
    sys.stderr.write("RuntimeNode credential fields must use scoped deterministic IDs\n")
    sys.exit(1)

refresh_match = re.search(r"export async function refreshRuntimeNodes\(\): Promise<void> \{(?P<body>.*?)\n\}", app_state, re.S)
if not refresh_match:
    sys.stderr.write("missing refreshRuntimeNodes implementation\n")
    sys.exit(1)

if "loadRuntimeNodeDetails" in refresh_match.group("body"):
    sys.stderr.write("refreshRuntimeNodes must not eagerly fetch every RuntimeNode detail\n")
    sys.exit(1)

restricted_storage_sources = runtime_view + "\n" + runtime_operations_view + "\n" + audit_records_view + "\n" + notifications
if re.search(r"\b(localStorage|sessionStorage|indexedDB)\b", restricted_storage_sources):
    sys.stderr.write("RuntimeNode, Runtime Operation, Audit, and notification state must not use browser persistence\n")
    sys.exit(1)

if re.search(r"notify\([^)]*(credentialForm\.secret|temporaryPassword|oneTimeSignalingCredential|sip_secret|temporary_password)", app_state, re.S):
    sys.stderr.write("notifications must not include one-time secret values\n")
    sys.exit(1)

if re.search(r"const\s+(roles|roleCatalog|adapterCatalog|capabilityCatalog)\s*=", runtime_view):
    sys.stderr.write("frontend role, adapter, or capability catalogs must remain server-provided\n")
    sys.exit(1)

runtime_field_renderer = Path("apps/web/src/components/runtime/RuntimeNodeCatalogField.vue").read_text(encoding="utf-8")
adapter_authority_sources = runtime_view + "\n" + app_state

for forbidden in [
    "adapter_key === 'asterisk-ari'",
    'adapter_key === "asterisk-ari"',
    "saveAsteriskAdapterConfiguration",
    "asteriskConfigurationForm",
    "asteriskNumberFields",
]:
    if forbidden in adapter_authority_sources:
        sys.stderr.write(f"RuntimeNode forms must not retain frontend Asterisk-specific form authority: {forbidden}\n")
        sys.exit(1)

if "RuntimeNodeCatalogField" not in runtime_view:
    sys.stderr.write("RuntimeNodesView must consume the shared catalog field renderer\n")
    sys.exit(1)

if not all(token in runtime_field_renderer for token in ["field.input_type === 'text'", "field.input_type === 'integer'", "field.input_type === 'json'"]):
    sys.stderr.write("RuntimeNode catalog field renderer must cover the supported server descriptor types\n")
    sys.exit(1)

if re.search(r"fields\s*:\s*\[[^\]]*(application_name|connect_timeout_ms|scenario_key|parameters)", adapter_authority_sources, re.S):
    sys.stderr.write("frontend production code must not define checked-in adapter field catalogs\n")
    sys.exit(1)

if re.search(r"if\s*\([^)]*(asterisk-ari|simulator-deterministic)", adapter_authority_sources):
    sys.stderr.write("frontend RuntimeNode configuration payload/rendering must not branch by adapter key\n")
    sys.exit(1)

for view_name in ["TenantsView.vue", "MembershipsView.vue", "UsersView.vue", "UserDetailView.vue", "RuntimeNodesView.vue"]:
    view_source = Path("apps/web/src/views") / view_name
    if "useAsyncActionMap" not in view_source.read_text(encoding="utf-8"):
        sys.stderr.write(f"{view_name} management mutations must use shared keyed action state\n")
        sys.exit(1)
PY

python3 - <<'PY'
from pathlib import Path
import re
import sys

frontend_sources = "\n".join(
    path.read_text(encoding="utf-8")
    for path in [
        Path("apps/web/src/composables/listQueryState.ts"),
        Path("apps/web/src/views/UsersView.vue"),
        Path("apps/web/src/views/MembershipsView.vue"),
        Path("apps/web/src/views/TenantsView.vue"),
        Path("apps/web/src/views/RuntimeNodesView.vue"),
        Path("apps/web/src/views/RuntimeOperationsView.vue"),
        Path("apps/web/src/views/AuditRecordsView.vue"),
        Path("apps/web/src/views/ConferenceOperationsView.vue"),
    ]
)

if re.search(r"\b(pushState|replaceState)\s*\(", frontend_sources):
    sys.stderr.write("list query state must use Vue Router, not manual history APIs\n")
    sys.exit(1)

if re.search(r"\b(localStorage|sessionStorage|indexedDB)\b", frontend_sources):
    sys.stderr.write("list query state must not persist protected list data in browser storage\n")
    sys.exit(1)

if re.search(r"\b(users|memberships|tenants|runtimeNodes|runtimeOperations|auditRecords)\.value\.sort\s*\(", frontend_sources):
    sys.stderr.write("frontend must not fake global sorting over one server-paginated page\n")
    sys.exit(1)

for view_name in ["UsersView.vue", "MembershipsView.vue", "TenantsView.vue", "RuntimeNodesView.vue", "RuntimeOperationsView.vue", "AuditRecordsView.vue"]:
    source = Path("apps/web/src/views") / view_name
    if "useListQueryState" not in source.read_text(encoding="utf-8"):
        sys.stderr.write(f"{view_name} must use the shared list query state contract\n")
        sys.exit(1)

users_source = Path("apps/web/src/views/UsersView.vue").read_text(encoding="utf-8")
if "pagination: true" not in users_source or "allowedPerPage: [10, 20, 50]" not in users_source:
    sys.stderr.write("UsersView must preserve URL-backed canonical pagination state\n")
    sys.exit(1)
PY

while IFS= read -r path; do
  if [ "$path" = "versions.env" ]; then
    continue
  fi

  case "$path" in
    *.env.example|*/.env.example)
      continue
      ;;
    infrastructure/kubernetes/overlays/local-media-edge/generated/public-media.env)
      continue
      ;;
  esac

  case "$path" in
    *.env|*.env.*|*id_rsa*|*id_dsa*|*id_ecdsa*|*id_ed25519*|*.pem|*.p12|*.pfx|*secret*key*|*private*key*)
      printf 'likely secret filename is tracked: %s\n' "$path" >&2
      exit 1
      ;;
  esac
done < <(git ls-files --cached --others --exclude-standard)

printf 'repository hygiene checks passed\n'
