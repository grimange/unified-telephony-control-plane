#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=scripts/simulator/lib
. "$ROOT/scripts/simulator/lib"

json_body_get() {
  cat "$SIM_BODY_FILE" | sim_json_get "$1"
}

login_member() {
  local email="$1" password="$2" tenant_id="$3" new_password="$4" cookie_jar="$5"
  local csrf_json csrf login_payload login_code change_payload change_code tenant_payload tenant_code
  csrf_json="$("${sim_curl[@]}" --cookie-jar "$cookie_jar" "$SIM_BASE/api/v1/auth/csrf")"
  csrf="$(printf '%s' "$csrf_json" | sim_json_get csrf_token)"
  login_payload="$(php -r 'echo json_encode(["email"=>$argv[1],"password"=>$argv[2]], JSON_UNESCAPED_SLASHES);' "$email" "$password")"
  login_code="$("${sim_curl[@]}" --cookie "$cookie_jar" --cookie-jar "$cookie_jar" --header "Content-Type: application/json" --header "X-CSRF-TOKEN: $csrf" --data "$login_payload" --output "$SIM_BODY_FILE" --write-out '%{http_code}' "$SIM_BASE/api/v1/auth/login")"
  [ "$login_code" = "200" ] || { printf 'member login failed with HTTP %s\n' "$login_code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }

  csrf_json="$("${sim_curl[@]}" --cookie "$cookie_jar" --cookie-jar "$cookie_jar" "$SIM_BASE/api/v1/auth/csrf")"
  csrf="$(printf '%s' "$csrf_json" | sim_json_get csrf_token)"
  change_payload="$(php -r 'echo json_encode(["current_password"=>$argv[1],"new_password"=>$argv[2]], JSON_UNESCAPED_SLASHES);' "$password" "$new_password")"
  change_code="$("${sim_curl[@]}" --cookie "$cookie_jar" --cookie-jar "$cookie_jar" --header "Content-Type: application/json" --header "X-CSRF-TOKEN: $csrf" --data "$change_payload" --output "$SIM_BODY_FILE" --write-out '%{http_code}' "$SIM_BASE/api/v1/auth/change-password")"
  [ "$change_code" = "200" ] || { printf 'member password change failed with HTTP %s\n' "$change_code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }

  csrf_json="$("${sim_curl[@]}" --cookie "$cookie_jar" --cookie-jar "$cookie_jar" "$SIM_BASE/api/v1/auth/csrf")"
  csrf="$(printf '%s' "$csrf_json" | sim_json_get csrf_token)"
  tenant_payload="$(php -r 'echo json_encode(["tenant_id"=>$argv[1]], JSON_UNESCAPED_SLASHES);' "$tenant_id")"
  tenant_code="$("${sim_curl[@]}" --cookie "$cookie_jar" --cookie-jar "$cookie_jar" --header "Content-Type: application/json" --header "X-CSRF-TOKEN: $csrf" --data "$tenant_payload" --output "$SIM_BODY_FILE" --write-out '%{http_code}' "$SIM_BASE/api/v1/auth/tenant-context")"
  [ "$tenant_code" = "200" ] || { printf 'member tenant selection failed with HTTP %s\n' "$tenant_code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }
  printf '%s' "$csrf"
}

member_api() {
  local cookie_jar="$1" csrf="$2" method="$3" path="$4" payload="${5:-}"
  shift 5 2>/dev/null || shift $#
  if [ -n "$payload" ]; then
    "${sim_curl[@]}" --cookie "$cookie_jar" --header "Content-Type: application/json" --header "X-CSRF-TOKEN: $csrf" --request "$method" --data "$payload" --output "$SIM_BODY_FILE" --write-out '%{http_code}' "$@" "$SIM_BASE$path"
  else
    "${sim_curl[@]}" --cookie "$cookie_jar" --header "X-CSRF-TOKEN: $csrf" --request "$method" --output "$SIM_BODY_FILE" --write-out '%{http_code}' "$@" "$SIM_BASE$path"
  fi
}

create_member_session() {
  local suffix="$1" cookie_jar="$2"
  local user_payload code member_id member_email member_password membership_payload member_csrf session_id
  user_payload="$(php -r 'echo json_encode(["email"=>"c5-runtime-member-".$argv[1]."@utcp.local.test","display_name"=>"C5 Runtime Member ".$argv[1]], JSON_UNESCAPED_SLASHES);' "$suffix")"
  code="$(sim_api POST /api/v1/admin/users "$user_payload")"
  [ "$code" = "201" ] || { printf 'runtime member user create failed with HTTP %s\n' "$code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }
  member_id="$(json_body_get user.id)"
  member_email="$(json_body_get user.email)"
  member_password="$(json_body_get temporary_password)"
  membership_payload="$(php -r 'echo json_encode(["user_id"=>$argv[1],"role_key"=>"tenant-member"], JSON_UNESCAPED_SLASHES);' "$member_id")"
  code="$(sim_api POST /api/v1/admin/memberships "$membership_payload" --header "Idempotency-Key: c5-runtime-membership-${suffix}")"
  [ "$code" = "201" ] || { printf 'runtime member membership failed with HTTP %s\n' "$code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }
  member_csrf="$(login_member "$member_email" "$member_password" "$SIM_TENANT_ID" "C5RuntimeProof${suffix}!" "$cookie_jar")"
  code="$(member_api "$cookie_jar" "$member_csrf" POST /api/v1/telephony/sessions '' --header "Idempotency-Key: c5-runtime-session-${suffix}")"
  [ "$code" = "201" ] || { printf 'runtime telephony session create failed with HTTP %s\n' "$code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }
  session_id="$(json_body_get telephony_session.id)"
  printf '%s:%s' "$member_csrf" "$session_id"
}

delete_pod_for_deployment() {
  local deployment="$1"
  local pod
  pod="$(kubectl --kubeconfig "$KUBECONFIG_FILE" --context "$KUBE_CONTEXT" -n utcp-platform get pod -l "app.kubernetes.io/component=${deployment}" -o jsonpath='{.items[0].metadata.name}')"
  [ -n "$pod" ] || { printf 'no pod found for %s\n' "$deployment" >&2; exit 1; }
  kubectl --kubeconfig "$KUBECONFIG_FILE" --context "$KUBE_CONTEXT" -n utcp-platform delete pod "$pod" >/dev/null
  kubectl --kubeconfig "$KUBECONFIG_FILE" --context "$KUBE_CONTEXT" -n utcp-platform rollout status "deployment/${deployment}" --timeout=180s >/dev/null
  printf 'restarted_%s_pod=%s\n' "$deployment" "$pod"
}

suffix="$(date +%s)"
member_cookie_jar="$(mktemp)"
expiry_cookie_jar="$(mktemp)"
draining_cookie_jar="$(mktemp)"
trap 'rm -f "$member_cookie_jar" "$expiry_cookie_jar" "$draining_cookie_jar"; sim_cleanup' EXIT

sim_login
node_id="$(sim_create_or_reuse_node "c5-runtime-proof-simulator-${suffix}" "C5 Runtime Proof Simulator ${suffix}")"
sim_set_capabilities "$node_id"
sim_configure "$node_id" "steady-ready" "c5-runtime-proof-${suffix}" '{"max_delay_seconds":0}'
sim_activate "$node_id"

conference_payload="$(php -r 'echo json_encode(["slug"=>"c5-runtime-proof-".$argv[1],"display_name"=>"C5 Runtime Proof ".$argv[1],"runtime_node_id"=>$argv[2]], JSON_UNESCAPED_SLASHES);' "$suffix" "$node_id")"
code="$(sim_api POST /api/v1/admin/conferences "$conference_payload" --header "Idempotency-Key: c5-runtime-conference-${suffix}")"
[ "$code" = "201" ] || { printf 'conference create failed with HTTP %s\n' "$code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }
conference_id="$(json_body_get conference.id)"

code="$(sim_api POST "/api/v1/admin/conferences/$conference_id/desired-state" '{"desired_state":"open"}')"
[ "$code" = "200" ] || { printf 'conference open failed with HTTP %s\n' "$code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }

sim_wait_until "conference_ready" 240 5 "select count(*) from conferences where id='${conference_id}' and desired_state='open' and observed_state='ready';"
sim_wait_until "conference_reconciliation_converged" 180 5 "select count(*) from runtime_reconciliation_states where target_type='conference' and target_id='${conference_id}' and status='converged';"
printf 'conference_ensure_operations=%s\n' "$(sim_psql "select count(*) from runtime_operations where operation_type='conference.ensure' and payload->>'conference_id'='${conference_id}';")"
printf 'conference_ready_receipts=%s\n' "$(sim_psql "select count(*) from runtime_event_receipts where runtime_node_id='${node_id}' and event_type='simulator.conference.ready' and status='processed';")"
printf 'conference_ready_observations=%s\n' "$(sim_psql "select count(*) from runtime_observations where subject_type='conference' and subject_id='${conference_id}' and observed_state='ready';")"
printf 'conference_checkpoints=%s\n' "$(sim_psql "select count(*) from runtime_projection_checkpoints where runtime_node_id='${node_id}';")"
printf 'conference open->ready live proof passed\n'

member_pair="$(create_member_session "$suffix" "$member_cookie_jar")"
member_csrf="${member_pair%%:*}"
session_id="${member_pair##*:}"
code="$(member_api "$member_cookie_jar" "$member_csrf" POST "/api/v1/conferences/$conference_id/participants/self" '' --header "Idempotency-Key: c5-runtime-join-${suffix}")"
[ "$code" = "201" ] || { printf 'participant admission failed with HTTP %s\n' "$code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }
participant_id="$(json_body_get participant.id)"
delete_pod_for_deployment telephony-command-worker
sim_wait_until "participant_joined" 240 5 "select count(*) from conference_participants where id='${participant_id}' and desired_state='admitted' and observed_state='joined';"
sim_wait_until "participant_reconciliation_converged" 180 5 "select count(*) from runtime_reconciliation_states where target_type='conference_participant' and target_id='${participant_id}' and status='converged';"
printf 'participant_ensure_operations=%s\n' "$(sim_psql "select count(*) from runtime_operations where operation_type='conference.participant.ensure' and payload->>'participant_id'='${participant_id}';")"
printf 'participant_joined_observations=%s\n' "$(sim_psql "select count(*) from runtime_observations where subject_type='conference_participant' and subject_id='${participant_id}' and observed_state='joined';")"
printf 'participant admit->joined live proof passed\n'

code="$(member_api "$member_cookie_jar" "$member_csrf" DELETE "/api/v1/conferences/$conference_id/participants/self")"
[ "$code" = "200" ] || { printf 'participant self removal failed with HTTP %s\n' "$code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }
delete_pod_for_deployment simulator-event-source
sim_wait_until "participant_left" 240 5 "select count(*) from conference_participants where id='${participant_id}' and desired_state='removed' and observed_state='left';"
printf 'participant_remove_operations=%s\n' "$(sim_psql "select count(*) from runtime_operations where operation_type='conference.participant.remove' and payload->>'participant_id'='${participant_id}';")"
printf 'participant remove->left live proof passed\n'

expiry_pair="$(create_member_session "${suffix}-expiry" "$expiry_cookie_jar")"
expiry_csrf="${expiry_pair%%:*}"
expiry_session_id="${expiry_pair##*:}"
code="$(member_api "$expiry_cookie_jar" "$expiry_csrf" POST "/api/v1/conferences/$conference_id/participants/self" '' --header "Idempotency-Key: c5-runtime-expiry-join-${suffix}")"
[ "$code" = "201" ] || { printf 'expiry participant admission failed with HTTP %s\n' "$code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }
expiry_participant_id="$(json_body_get participant.id)"
sim_wait_until "expiry_participant_joined" 240 5 "select count(*) from conference_participants where id='${expiry_participant_id}' and observed_state='joined';"
sim_wait_until "session_expired" 180 5 "select count(*) from telephony_sessions where id='${expiry_session_id}' and status='expired';"
sim_wait_until "expiry_participant_left" 240 5 "select count(*) from conference_participants where id='${expiry_participant_id}' and desired_state='removed' and observed_state='left';"
code="$(member_api "$expiry_cookie_jar" "$expiry_csrf" POST "/api/v1/conferences/$conference_id/participants/self" '' || true)"
[ "$code" = "422" ] || { printf 'expired session admission was not rejected with HTTP 422: %s\n' "$code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }
printf 'session expiry live proof passed\n'

code="$(sim_api POST "/api/v1/admin/conferences/$conference_id/desired-state" '{"desired_state":"draining"}')"
[ "$code" = "200" ] || { printf 'conference draining failed with HTTP %s\n' "$code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }
draining_pair="$(create_member_session "${suffix}-draining" "$draining_cookie_jar")"
draining_csrf="${draining_pair%%:*}"
before_ensure="$(sim_psql "select count(*) from runtime_operations where operation_type='conference.participant.ensure' and payload->>'conference_id'='${conference_id}';")"
code="$(member_api "$draining_cookie_jar" "$draining_csrf" POST "/api/v1/conferences/$conference_id/participants/self" '' || true)"
[ "$code" = "422" ] || { printf 'draining admission was not rejected with HTTP 422: %s\n' "$code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }
after_ensure="$(sim_psql "select count(*) from runtime_operations where operation_type='conference.participant.ensure' and payload->>'conference_id'='${conference_id}';")"
[ "$before_ensure" = "$after_ensure" ] || { printf 'draining rejection created a participant ensure operation\n' >&2; exit 1; }
printf 'conference draining live proof passed\n'

code="$(sim_api POST "/api/v1/admin/conferences/$conference_id/desired-state" '{"desired_state":"closed"}')"
[ "$code" = "200" ] || { printf 'conference close desired state failed with HTTP %s\n' "$code" >&2; cat "$SIM_BODY_FILE" >&2; exit 1; }
sim_wait_until "conference_closed" 240 5 "select count(*) from conferences where id='${conference_id}' and desired_state='closed' and observed_state='closed';"
sim_wait_until "conference_closed_reconciled" 180 5 "select count(*) from runtime_reconciliation_states where target_type='conference' and target_id='${conference_id}' and status='converged';"
admitted_remaining="$(sim_psql "select count(*) from conference_participants where conference_id='${conference_id}' and desired_state='admitted';")"
[ "$admitted_remaining" = "0" ] || { printf 'conference closed with admitted participants remaining: %s\n' "$admitted_remaining" >&2; exit 1; }
printf 'conference_close_operations=%s\n' "$(sim_psql "select count(*) from runtime_operations where operation_type='conference.close' and payload->>'conference_id'='${conference_id}';")"
printf 'conference close->closed live proof passed\n'

printf 'telephony domain runtime proof passed\n'
printf 'proof_runtime_node_id=%s\n' "$node_id"
printf 'proof_conference_id=%s\n' "$conference_id"
printf 'proof_session_id=%s\n' "$session_id"
printf 'proof_participant_id=%s\n' "$participant_id"
