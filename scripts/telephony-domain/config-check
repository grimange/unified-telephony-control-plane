grep -q "CANONICAL_RUNTIME_NAMESPACE = 'utcp-runtime'" apps/api/app/Infrastructure/RuntimeFencing/RuntimeNodeWorkloadIdentityValidator.php
grep -q "fromLabelValue" apps/api/app/Infrastructure/RuntimeFencing/RuntimeNodeWorkloadIdentityValidator.php
grep -q "RuntimeNodeWorkloadIdentityValidator::RESERVED_LABEL_KEY" apps/api/app/RuntimeRegistry/RuntimeRegistryService.php
grep -q "KubernetesRuntimeWorkloadInspector" apps/api/app/Infrastructure/RuntimeFencing/KubernetesRuntimeFenceAdapter.php
grep -q "app.kubernetes.io/part-of" apps/api/app/Infrastructure/RuntimeFencing/KubernetesRuntimeWorkloadInspector.php
grep -q "app.kubernetes.io/component" apps/api/app/Infrastructure/RuntimeFencing/KubernetesRuntimeWorkloadInspector.php
grep -q "utcp.dev/runtime-node" apps/api/app/Infrastructure/RuntimeFencing/KubernetesRuntimeWorkloadInspector.php
