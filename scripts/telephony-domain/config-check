#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../.."

test -f apps/api/config/telephony_domain.php
test -f apps/api/database/migrations/2026_07_15_090000_create_telephony_session_conference_domain_tables.php

grep -Eq '^UTCP_PHASE=C[45]$|^UTCP_PHASE=T[01]$' versions.env
grep -q "'conference.lifecycle'" apps/api/config/runtime_registry.php
grep -q "'conference.participation'" apps/api/config/runtime_registry.php
grep -q "telephony.sessions.create_own" apps/api/config/identity.php
grep -q "conference.ensure" apps/api/config/telephony_domain.php
grep -q "conference.participant.ensure" apps/api/config/telephony_domain.php
grep -q "runtime.node.verify_conference_absent" apps/api/config/telephony_domain.php
grep -q "runtime.node.runtime.fence" apps/api/config/telephony_domain.php
grep -q "verify_conference_absent" apps/api/app/Providers/AppServiceProvider.php
grep -q "RuntimeFenceOperationHandler" apps/api/app/Providers/AppServiceProvider.php
grep -q "InfrastructureAdapterRegistry" apps/api/app/Providers/AppServiceProvider.php
grep -q "KubernetesRuntimeFenceAdapter" apps/api/app/Providers/AppServiceProvider.php
grep -q "HttpKubernetesWorkloadClient" apps/api/app/Providers/AppServiceProvider.php
grep -q "telephony_sessions_total" apps/api/app/Http/Controllers/Platform/MetricsController.php
grep -q "conference_participant_reconciliation_total" apps/api/app/Http/Controllers/Platform/MetricsController.php
grep -q "UTCPTelephonyConferenceReconciliationStuck" infrastructure/kubernetes/observability/alerts/utcp-alerts.yaml
grep -q "UTCPTelephonyExpiredActiveSessions" infrastructure/kubernetes/observability/alerts/utcp-alerts.yaml
grep -q "conference_runtime_bindings_one_active" apps/api/database/migrations/2026_07_15_090000_create_telephony_session_conference_domain_tables.php
grep -q "failoverRebindConference" apps/api/app/TelephonyDomain/TelephonyDomainService.php
grep -q "hasDistinctEligibleReplacement" apps/api/app/TelephonyDomain/TelephonyDomainService.php
grep -q "selectRuntimeNodeForConference" apps/api/app/TelephonyDomain/TelephonyDomainService.php
grep -q "excludeRuntimeNodeId" apps/api/app/TelephonyDomain/TelephonyDomainService.php
grep -q "\\['active'\\]" apps/api/app/TelephonyDomain/TelephonyDomainService.php
grep -q "runtime_binding_replaced" apps/api/app/TelephonyDomain/TelephonyDomainService.php
grep -q "bound_runtime_node_ready" apps/api/app/TelephonyDomain/TelephonyDomainService.php
grep -q "where('observed_state', 'ready')" apps/api/app/TelephonyDomain/TelephonyDomainService.php
grep -q "wakeTarget" apps/api/app/TelephonyDomain/TelephonyDomainService.php
grep -q "class ConferenceFailoverCoordinator" apps/api/app/TelephonyDomain/Failover/ConferenceFailoverCoordinator.php
grep -q "class RuntimeFencingCoordinator" apps/api/app/TelephonyDomain/Failover/RuntimeFencingCoordinator.php
grep -q "failoverRebindConferenceAfterFence" apps/api/app/TelephonyDomain/Failover/RuntimeFencingCoordinator.php
grep -q "required_fence_operation_id" apps/api/app/TelephonyDomain/TelephonyDomainService.php
grep -q "conference.runtime_fence_verified" apps/api/app/RuntimeAdapters/Asterisk/AsteriskRuntimeAdapter.php
grep -q "conference.runtime_fence_terminated" apps/api/app/Infrastructure/RuntimeFencing/RuntimeFenceOperationHandler.php
grep -q "operationAuthorityCurrent" apps/api/app/Infrastructure/RuntimeFencing/RuntimeFenceOperationHandler.php
grep -q "no_replacement_available" apps/api/app/Infrastructure/RuntimeFencing/RuntimeFenceOperationHandler.php
grep -q "hasDistinctEligibleReplacement" apps/api/app/Infrastructure/RuntimeFencing/RuntimeFenceOperationHandler.php
grep -q "absent_verified" apps/api/app/TelephonyDomain/Failover/RuntimeFencingCoordinator.php
grep -q "external_runtime_fenced" apps/api/app/TelephonyDomain/Failover/RuntimeFencingCoordinator.php
grep -q "no_replacement_available" apps/api/app/TelephonyDomain/Failover/RuntimeFencingCoordinator.php
grep -q "runtime.node.runtime.fence" apps/api/app/TelephonyDomain/Failover/RuntimeFencingCoordinator.php
grep -q "runtime.node.runtime.fence" apps/api/app/Infrastructure/RuntimeFencing/RuntimeFenceOperationHandler.php
grep -q "class InfrastructureAdapterRegistry" apps/api/app/Infrastructure/RuntimeFencing/InfrastructureAdapterRegistry.php
grep -q "interface KubernetesWorkloadClient" apps/api/app/Infrastructure/RuntimeFencing/KubernetesWorkloadClient.php
grep -q "class HttpKubernetesWorkloadClient" apps/api/app/Infrastructure/RuntimeFencing/HttpKubernetesWorkloadClient.php
grep -q "class UnavailableKubernetesWorkloadClient" apps/api/app/Infrastructure/RuntimeFencing/UnavailableKubernetesWorkloadClient.php
grep -q "class KubernetesRuntimeFenceAdapter" apps/api/app/Infrastructure/RuntimeFencing/KubernetesRuntimeFenceAdapter.php
grep -q "kubernetes_workload" apps/api/app/Infrastructure/RuntimeFencing/RuntimeNodeWorkloadIdentityResolver.php
grep -q "utcp-runtime" apps/api/app/Infrastructure/RuntimeFencing/RuntimeNodeWorkloadIdentityResolver.php
grep -q "app.kubernetes.io/part-of" apps/api/app/Infrastructure/RuntimeFencing/KubernetesRuntimeFenceAdapter.php
grep -q "app.kubernetes.io/component" apps/api/app/Infrastructure/RuntimeFencing/KubernetesRuntimeFenceAdapter.php
grep -q "utcp.dev/runtime-node" apps/api/app/Infrastructure/RuntimeFencing/KubernetesRuntimeFenceAdapter.php
grep -q "scaleDeployment" apps/api/app/Infrastructure/RuntimeFencing/KubernetesRuntimeFenceAdapter.php
grep -q "listOwnedPods" apps/api/app/Infrastructure/RuntimeFencing/KubernetesRuntimeFenceAdapter.php
grep -q "owned_pods_remaining" apps/api/app/Infrastructure/RuntimeFencing/KubernetesRuntimeFenceAdapter.php
grep -q "KubernetesWorkloadClient::class, HttpKubernetesWorkloadClient::class" apps/api/app/Providers/AppServiceProvider.php
grep -q "runtime-engine:infrastructure-worker {--once" apps/api/routes/console.php
grep -q "telephony-infrastructure-worker" infrastructure/docker/api/entrypoint
grep -q "serviceAccountName: utcp-runtime-fencer" infrastructure/kubernetes/components/runtime-fencing/infrastructure-worker-deployment.yaml
grep -q "automountServiceAccountToken: false" infrastructure/kubernetes/components/runtime-fencing/infrastructure-worker-deployment.yaml
grep -q "serviceAccountToken:" infrastructure/kubernetes/components/runtime-fencing/infrastructure-worker-deployment.yaml
rg -F 'resources: ["deployments/scale"]' infrastructure/kubernetes/components/runtime-fencing/rbac.yaml >/dev/null
rg -F 'verbs: ["get", "patch"]' infrastructure/kubernetes/components/runtime-fencing/rbac.yaml >/dev/null
grep -q "kind: RoleBinding" infrastructure/kubernetes/components/runtime-fencing/rbac.yaml
grep -q "'fenced', 'already_fenced'" apps/api/app/TelephonyDomain/TelephonyDomainService.php
grep -q "stale_observation_seconds" apps/api/app/TelephonyDomain/Failover/ConferenceFailoverCoordinator.php
grep -q "for update skip locked" apps/api/app/TelephonyDomain/Failover/ConferenceFailoverCoordinator.php
grep -q "whereIn('runtime_nodes.observed_state', self::QUALIFYING_BOUND_STATES)" apps/api/app/TelephonyDomain/Failover/ConferenceFailoverCoordinator.php
grep -q "'replacement_desired_states' => self::AUTOMATIC_REPLACEMENT_DESIRED_STATES" apps/api/app/TelephonyDomain/Failover/RuntimeFencingCoordinator.php
grep -q "telephony-domain:failover-coordinator {--once" apps/api/routes/console.php
grep -q "Schedule::command('telephony-domain:failover-coordinator --once')->everyMinute()->withoutOverlapping()" apps/api/routes/console.php

php -l apps/api/app/TelephonyDomain/TelephonyDomainService.php >/dev/null
php -l apps/api/app/TelephonyDomain/Failover/ConferenceFailoverCoordinator.php >/dev/null
php -l apps/api/app/TelephonyDomain/Failover/RuntimeFencingCoordinator.php >/dev/null
php -l apps/api/app/TelephonyDomain/Reconciliation/ConferenceReconciler.php >/dev/null
php -l apps/api/app/TelephonyDomain/Reconciliation/ConferenceParticipantReconciler.php >/dev/null
php -l apps/api/app/TelephonyDomain/Runtime/ConferenceOperationHandler.php >/dev/null
php -l apps/api/database/migrations/2026_07_15_090000_create_telephony_session_conference_domain_tables.php >/dev/null
find apps/api/app/Infrastructure/RuntimeFencing -name '*.php' -print0 | xargs -0 -n1 php -l >/dev/null

if rg -n "sip|webrtc|ari|esl|kamailio|rtpengine|asterisk|freeswitch|media" apps/api/app/TelephonyDomain apps/api/routes/web.php -g '!apps/api/app/TelephonyDomain/Signaling/**'; then
  printf 'C5 domain or route surface contains forbidden vendor/media vocabulary.\n' >&2
  exit 1
fi

if rg -n "adapter->execute|runtime_operations.*insert" apps/api/app/Http/Controllers/TelephonyDomain apps/api/app/TelephonyDomain/TelephonyDomainService.php; then
  printf 'C5 controller/service boundary contains direct runtime execution or operation insertion.\n' >&2
  exit 1
fi

if rg -n "AsteriskAriClient|RuntimeAdapter|adapter_key.*asterisk|runtime_node_id.*allowlist|UTCP_.*(FAILOVER|REBIN[D]|FENCE|RUNTIME_NODE|ALLOWLIST)" apps/api/app/TelephonyDomain/TelephonyDomainService.php apps/api/app/TelephonyDomain/Failover apps/api/app/Http/Controllers/TelephonyDomain apps/api/routes/web.php; then
  printf 'C5 controller/service boundary contains a vendor branch, allowlist, or environment-gated rebind path.\n' >&2
  exit 1
fi

if rg -n "failoverRebindConference\\(" apps/api/app/TelephonyDomain/Failover/ConferenceFailoverCoordinator.php; then
  printf 'C5 failover coordinator bypasses former-runtime absence verification.\n' >&2
  exit 1
fi

if rg -n "failoverRebindConference\\(" apps/api/app/TelephonyDomain/Failover/RuntimeFencingCoordinator.php | grep -v "failoverRebindConferenceAfterFence"; then
  printf 'C5 runtime fencing coordinator bypasses fence evidence validation.\n' >&2
  exit 1
fi

handler_guard_line="$(rg -n "hasDistinctEligibleReplacement" apps/api/app/Infrastructure/RuntimeFencing/RuntimeFenceOperationHandler.php | cut -d: -f1 | head -n1)"
handler_fence_line="$(rg -n -- "->fence\\(" apps/api/app/Infrastructure/RuntimeFencing/RuntimeFenceOperationHandler.php | cut -d: -f1 | head -n1)"
if [ -z "$handler_guard_line" ] || [ -z "$handler_fence_line" ] || [ "$handler_guard_line" -ge "$handler_fence_line" ]; then
  printf 'C5 runtime fence handler does not check replacement availability before fence mutation.\n' >&2
  exit 1
fi

if rg -n "replacement_.*node_id|replacement_node|replacementRuntimeNodeId" apps/api/app/Infrastructure/RuntimeFencing apps/api/app/TelephonyDomain/Failover/RuntimeFencingCoordinator.php; then
  printf 'C5 runtime fencing operation or coordinator carries a replacement RuntimeNode identity outside the domain authority.\n' >&2
  exit 1
fi

if rg -n "kubectl|shell_exec|exec\\(|proc_open|passthru|system\\(" apps/api/app/Infrastructure/RuntimeFencing; then
  printf 'C5 infrastructure fencing uses shell or kubectl execution.\n' >&2
  exit 1
fi

if rg -n "delete.*Pod|pod.*delete|deleteCollection|pods/.*/delete" apps/api/app/Infrastructure/RuntimeFencing; then
  printf 'C5 infrastructure fencing contains a direct Pod deletion path.\n' >&2
  exit 1
fi

if rg -n "kubectl|shell_exec|exec\\(|proc_open|passthru|system\\(" apps/api/app/Infrastructure/RuntimeFencing; then
  printf 'C5 infrastructure fencing or worker surface uses shell or kubectl execution.\n' >&2
  exit 1
fi

if rg -n "delete" infrastructure/kubernetes/components/runtime-fencing/rbac.yaml; then
  printf 'C5 fencing RBAC contains delete permission.\n' >&2
  exit 1
fi

if rg -n "ClusterRole|resources: \\[\"\\*\"\\]|verbs: \\[\"\\*\"\\]|resources: \\[\"secrets\"\\]" infrastructure/kubernetes/components/runtime-fencing; then
  printf 'C5 fencing manifests contain broad or secret permissions.\n' >&2
  exit 1
fi

if rg -n "runtime-fencing" infrastructure/kubernetes/overlays/local infrastructure/kubernetes/base/kustomization.yaml infrastructure/kubernetes/base/platform/kustomization.yaml infrastructure/kubernetes/base/runtime/kustomization.yaml; then
  printf 'C5 active single-node overlays include the staged runtime-fencing worker.\n' >&2
  exit 1
fi

if rg -n "Http::|curl_init|Kubernetes|KubernetesWorkloadClient|scaleDeployment" apps/api/app/TelephonyDomain apps/api/app/RuntimeAdapters/Asterisk | grep -v "RuntimeFencingCoordinator.php"; then
  printf 'C5 domain or runtime adapter contains direct Kubernetes infrastructure access.\n' >&2
  exit 1
fi

if rg -n "hangup|deleteBridge|destroyBridge|ensureConferenceBridge|ensureParticipantChannel|removeParticipantChannel" apps/api/app/RuntimeAdapters/Asterisk/AsteriskRuntimeAdapter.php | grep -F "verifyConferenceAbsent"; then
  printf 'C5 Asterisk absence verification is not read-only.\n' >&2
  exit 1
fi

if rg -n "update\\([^\\n]*observed_state|->update\\(\\[[^]]*observed_state" apps/api/app/Http/Controllers/TelephonyDomain apps/api/app/TelephonyDomain/TelephonyDomainService.php apps/api/app/TelephonyDomain/Failover; then
  printf 'C5 controller/service boundary contains direct observed-state mutation.\n' >&2
  exit 1
fi

if rg -n "'(tenant_id|user_id|session_id|conference_id|participant_id|runtime_node_id|operation_id|event_id|request_id)'[[:space:]]*=>" apps/api/app/Http/Controllers/Platform/MetricsController.php; then
  printf 'C5 metrics contain high-cardinality exported labels.\n' >&2
  exit 1
fi

if rg -n "tenant_id|user_id|session_id|conference_id|participant_id|runtime_node_id|operation_id|event_id|request_id" infrastructure/kubernetes/observability/alerts/utcp-alerts.yaml; then
  printf 'C5 metrics or alerts contain high-cardinality identity labels.\n' >&2
  exit 1
fi

cd apps/api
php artisan route:list --path=api/v1/conferences >/tmp/utcp-c5-routes.txt
php artisan route:list --path=api/v1/telephony/sessions >>/tmp/utcp-c5-routes.txt
if grep -E "reconcile|project|runtime.*execute|sip|media|ari|esl" /tmp/utcp-c5-routes.txt; then
  printf 'C5 route surface exposes forbidden manual/vendor/media route.\n' >&2
  exit 1
fi
if php artisan route:list | grep -Ei "failover|rebind"; then
  printf 'C5 route surface exposes a forbidden manual failover or rebind route.\n' >&2
  exit 1
fi
if rg -n "runtime.node.runtime.fence|runtime_fence|RuntimeFenceOperationHandler" routes app/Http | grep -v "operation_types.runtime_fence"; then
  printf 'C5 route or controller surface exposes a forbidden manual runtime fence path.\n' >&2
  exit 1
fi
if rg -n "failover|rebind" routes/console.php | grep -v "failover-coordinator" | grep -v "ConferenceFailoverCoordinator" | grep -v "telephony_domain_failover_" | grep -v "automatic conference failover coordinator"; then
  printf 'C5 console or application surface exposes a forbidden manual failover or rebind command outside the scheduled coordinator.\n' >&2
  exit 1
fi
if rg -n -- "--(conference|runtime-node|replacement|force|grace|bypass|fence)" routes/console.php app/TelephonyDomain/Failover app/Infrastructure/RuntimeFencing; then
  printf 'C5 failover coordinator exposes forbidden targeted/manual/bypass options.\n' >&2
  exit 1
fi
if rg -n "env\\([^)]*(FAILOVER|FENCE|RUNTIME_NODE|ALLOWLIST)|UTCP_.*(FAILOVER|FENCE|RUNTIME_NODE|ALLOWLIST)|(FAILOVER|FENCE)_.*UTCP|failover_grace|allowlist|allowed_runtime" config routes/console.php app/TelephonyDomain/Failover app/Infrastructure/RuntimeFencing; then
  printf 'C5 failover coordinator contains forbidden environment gate or allowlist.\n' >&2
  exit 1
fi
if rg -n "table\\('conference_runtime_bindings'\\)->(insert|update|delete)|conference_runtime_bindings'\\)->where.*->update" app/TelephonyDomain/Failover app/Http/Controllers/TelephonyDomain; then
  printf 'C5 failover coordinator writes bindings outside the canonical domain service.\n' >&2
  exit 1
fi
if [ -d app/Console ] && find app/Console -type f -name '*.php' -print0 | xargs -0 rg -n "failover|rebind"; then
  printf 'C5 console surface exposes a forbidden manual failover or rebind command.\n' >&2
  exit 1
fi

printf 'telephony_domain_config_check=ok\n'
