#!/usr/bin/env python3
from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path


SKIP_DIRS = {
    ".git",
    "vendor",
    "node_modules",
    "dist",
    "coverage",
    ".pytest_cache",
    "__pycache__",
    "storage/logs",
}
TEXT_SUFFIXES = {
    ".env",
    ".example",
    ".json",
    ".lock",
    ".md",
    ".php",
    ".py",
    ".sh",
    ".ts",
    ".tsx",
    ".vue",
    ".js",
    ".cjs",
    ".mjs",
    ".css",
    ".ini",
    ".conf",
    ".yaml",
    ".yml",
    ".toml",
    ".txt",
    ".properties",
}
SECRET_PATTERNS = [
    re.compile(r"-----BEGIN (?:RSA |DSA |EC |OPENSSH |)PRIVATE KEY-----"),
    re.compile(r"(?i)\b(?:aws_access_key_id|aws_secret_access_key)\s*=\s*[A-Z0-9/+=]{16,}"),
    re.compile(r"(?i)\b(?:token|secret|password|private_key)\s*[:=]\s*['\"]?(?!synthetic|placeholder|example|local-only|local_dev_only|changeme|not-a-secret|unknown)[A-Za-z0-9_./+=:-]{20,}"),
    re.compile(r"\bgh[pousr]_[A-Za-z0-9_]{30,}\b"),
    re.compile(r"\bgithub_pat_[A-Za-z0-9_]{40,}\b"),
    re.compile(r"\bsk-[A-Za-z0-9]{32,}\b"),
]


def git_paths() -> list[Path]:
    output = subprocess.check_output(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
        text=False,
    )
    return [Path(item.decode()) for item in output.split(b"\0") if item]


def should_scan(path: Path) -> bool:
    text = path.as_posix()
    for skip in SKIP_DIRS:
        if text == skip or text.startswith(f"{skip}/"):
            return False
    if path.name.endswith(".env.example") or path.as_posix().endswith("/env.example"):
        return True
    if path.name.startswith(".env") and not path.name.endswith(".example"):
        return True
    return path.suffix in TEXT_SUFFIXES or path.name in {"Makefile", "Dockerfile"}


def main() -> int:
    failures: list[str] = []
    for path in git_paths():
        if path.is_dir() or not path.exists() or not should_scan(path):
            continue

        if path.name.startswith(".env") and not path.name.endswith(".example"):
            failures.append(f"forbidden environment file present: {path}")
            continue

        try:
            content = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue

        for line_number, line in enumerate(content.splitlines(), start=1):
            for pattern in SECRET_PATTERNS:
                if pattern.search(line):
                    failures.append(f"possible secret material: {path}:{line_number}")

    if failures:
        for failure in failures:
            print(failure, file=sys.stderr)
        return 1

    print("secret-oriented repository scan passed")
    return 0


if __name__ == "__main__":
    os.chdir(Path(__file__).resolve().parents[2])
    raise SystemExit(main())
