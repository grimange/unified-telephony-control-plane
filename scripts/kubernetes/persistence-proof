#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/kubernetes/lib
. "$SCRIPT_DIR/lib"

required_tools
ensure_kubeconfig
wait_data

postgres_pod="$(kube -n "$K8S_DATA_NAMESPACE" get pod -l app.kubernetes.io/component=postgres -o jsonpath='{.items[0].metadata.name}')"
kube -n "$K8S_DATA_NAMESPACE" exec "$postgres_pod" -- sh -ec 'PGPASSWORD="$POSTGRES_PASSWORD" psql -h 127.0.0.1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" -v ON_ERROR_STOP=1 -c "CREATE TABLE IF NOT EXISTS k1_persistence_proof (marker text primary key);" -c "INSERT INTO k1_persistence_proof(marker) VALUES (\$\$postgres-proof\$\$) ON CONFLICT DO NOTHING;"' >/dev/null
kube -n "$K8S_DATA_NAMESPACE" delete pod "$postgres_pod" >/dev/null
wait_data
postgres_pod="$(kube -n "$K8S_DATA_NAMESPACE" get pod -l app.kubernetes.io/component=postgres -o jsonpath='{.items[0].metadata.name}')"
postgres_count="$(kube -n "$K8S_DATA_NAMESPACE" exec "$postgres_pod" -- sh -ec 'PGPASSWORD="$POSTGRES_PASSWORD" psql -h 127.0.0.1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc "SELECT count(*) FROM k1_persistence_proof WHERE marker = \$\$postgres-proof\$\$;"')"
if [ "$postgres_count" != "1" ]; then
  printf 'PostgreSQL persistence marker was not preserved\n' >&2
  exit 1
fi
kube -n "$K8S_DATA_NAMESPACE" exec "$postgres_pod" -- sh -ec 'PGPASSWORD="$POSTGRES_PASSWORD" psql -h 127.0.0.1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" -v ON_ERROR_STOP=1 -c "DROP TABLE k1_persistence_proof;"' >/dev/null

redis_pod="$(kube -n "$K8S_DATA_NAMESPACE" get pod -l app.kubernetes.io/component=redis -o jsonpath='{.items[0].metadata.name}')"
kube -n "$K8S_DATA_NAMESPACE" exec "$redis_pod" -- redis-cli set k1:persistence-proof ok >/dev/null
kube -n "$K8S_DATA_NAMESPACE" delete pod "$redis_pod" >/dev/null
wait_data
redis_pod="$(kube -n "$K8S_DATA_NAMESPACE" get pod -l app.kubernetes.io/component=redis -o jsonpath='{.items[0].metadata.name}')"
redis_value="$(kube -n "$K8S_DATA_NAMESPACE" exec "$redis_pod" -- redis-cli get k1:persistence-proof)"
if [ "$redis_value" != "ok" ]; then
  printf 'Redis persistence marker was not preserved\n' >&2
  exit 1
fi
kube -n "$K8S_DATA_NAMESPACE" exec "$redis_pod" -- redis-cli del k1:persistence-proof >/dev/null

printf 'K1 persistence proof passed\n'
