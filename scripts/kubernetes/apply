#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/kubernetes/lib
. "$SCRIPT_DIR/lib"

ensure_cluster
"$SCRIPT_DIR/config-check" >/dev/null
"$SCRIPT_DIR/image-build"
"$SCRIPT_DIR/image-push"

kube apply -k "$K8S_DATA_OVERLAY"
wait_data

kube apply -f "$ROOT/infrastructure/kubernetes/base/platform/service-account.yaml"
delete_migration_job
kube apply -k "$K8S_MIGRATION_OVERLAY"
wait_migration

kube apply -k "$K8S_PLATFORM_OVERLAY"
wait_platform

"$SCRIPT_DIR/status"
printf 'K1 platform applied. Proof command: make k8s-proof\n'
