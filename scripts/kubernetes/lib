#!/usr/bin/env bash
set -euo pipefail

repo_root() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  cd "$script_dir/../.." && pwd
}

ROOT="$(repo_root)"
VERSIONS_FILE="$ROOT/versions.env"

# shellcheck disable=SC1090
. "$VERSIONS_FILE"

K3D_CLUSTER_NAME="${K3D_CLUSTER_NAME:-utcp-local}"
K3D_CONTEXT_NAME="${K3D_CONTEXT_NAME:-k3d-utcp-local}"
K3D_REGISTRY_NAME="${K3D_REGISTRY_NAME:-utcp-local-registry}"
K3D_REGISTRY_HOST="${K3D_REGISTRY_HOST:-127.0.0.1}"
K3D_REGISTRY_HOST_PORT="${K3D_REGISTRY_HOST_PORT:-5001}"
KUBECONFIG_FILE="$ROOT/.runtime/kubeconfig/utcp-local.yaml"
K8S_OVERLAY="$ROOT/infrastructure/kubernetes/overlays/local"
K8S_DATA_OVERLAY="$K8S_OVERLAY/data"
K8S_MIGRATION_OVERLAY="$K8S_OVERLAY/migration"
K8S_PLATFORM_OVERLAY="$K8S_OVERLAY/platform"
K8S_RUNTIME_OVERLAY="$K8S_OVERLAY/runtime"
K8S_ASTERISK_CREDENTIALS_FILE="$K8S_RUNTIME_OVERLAY/local-asterisk-ari-credentials.properties"
K8S_KAMAILIO_PLATFORM_CREDENTIALS_FILE="$K8S_PLATFORM_OVERLAY/local-kamailio-db-credentials.properties"
K8S_KAMAILIO_MIGRATION_CREDENTIALS_FILE="$K8S_MIGRATION_OVERLAY/local-kamailio-db-credentials.properties"
K8S_REVERB_CREDENTIALS_FILE="$K8S_PLATFORM_OVERLAY/local-reverb-credentials.properties"
K8S_PLATFORM_NAMESPACE="utcp-platform"
K8S_DATA_NAMESPACE="utcp-data"
K8S_RUNTIME_NAMESPACE="utcp-runtime"
K8S_PROOF_PORT="${K8S_PROOF_PORT:-18089}"
K1_IMAGE_TAG="${K1_IMAGE_TAG:-0.1.0-k1-dev}"
HOST_REGISTRY="${K3D_REGISTRY_HOST}:${K3D_REGISTRY_HOST_PORT}"
CLUSTER_REGISTRY="${K3D_REGISTRY_NAME}:5000"
API_LOCAL_IMAGE="${UTCP_API_IMAGE:-utcp-api:dev}"
WEB_LOCAL_IMAGE="${UTCP_WEB_IMAGE:-utcp-web:dev}"
GATEWAY_LOCAL_IMAGE="${UTCP_GATEWAY_IMAGE:-utcp-gateway:dev}"
ASTERISK_LOCAL_IMAGE="${UTCP_ASTERISK_IMAGE:-utcp-asterisk-ari:dev}"
RTPENGINE_LOCAL_IMAGE="${UTCP_RTPENGINE_IMAGE:-utcp-rtpengine:dev}"
API_HOST_IMAGE="$HOST_REGISTRY/utcp/api:$K1_IMAGE_TAG"
WEB_HOST_IMAGE="$HOST_REGISTRY/utcp/web:$K1_IMAGE_TAG"
GATEWAY_HOST_IMAGE="$HOST_REGISTRY/utcp/gateway:$K1_IMAGE_TAG"
ASTERISK_HOST_IMAGE="$HOST_REGISTRY/utcp/asterisk-ari:$K1_IMAGE_TAG"
RTPENGINE_HOST_IMAGE="$HOST_REGISTRY/utcp/rtpengine:$K1_IMAGE_TAG"

required_tools() {
  local missing=0
  for tool in docker k3d kubectl curl awk grep sed; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      printf 'missing required K1 tool: %s\n' "$tool" >&2
      missing=1
    fi
  done
  if [ "$missing" -ne 0 ]; then
    exit 1
  fi
  if ! kubectl kustomize --help >/dev/null 2>&1; then
    printf 'missing required K1 capability: kubectl kustomize\n' >&2
    exit 1
  fi
}

kube() {
  KUBECONFIG="$KUBECONFIG_FILE" kubectl --context "$K3D_CONTEXT_NAME" "$@"
}

ensure_kubeconfig() {
  if [ ! -s "$KUBECONFIG_FILE" ]; then
    printf 'repository kubeconfig is missing: %s\n' "$KUBECONFIG_FILE" >&2
    exit 1
  fi
}

ensure_cluster() {
  required_tools
  ensure_kubeconfig
  "$ROOT/scripts/k3d/verify" >/dev/null
}

ensure_registry() {
  if ! k3d registry list -o json 2>/dev/null | grep -q "\"name\":\"$K3D_REGISTRY_NAME\""; then
    printf 'missing k3d registry: %s\n' "$K3D_REGISTRY_NAME" >&2
    exit 1
  fi
  docker ps --format '{{.Names}}\t{{.Status}}\t{{.Ports}}' \
    | "$ROOT/scripts/k3d/registry-container-check" "$K3D_REGISTRY_NAME" "$K3D_REGISTRY_HOST" "$K3D_REGISTRY_HOST_PORT" >/dev/null
}

check_k1_tag() {
  if [ -z "$K1_IMAGE_TAG" ] || [ "$K1_IMAGE_TAG" = "latest" ]; then
    printf 'K1_IMAGE_TAG must be explicit and must not be latest\n' >&2
    exit 1
  fi
}

render_overlay() {
  ensure_local_asterisk_credentials
  ensure_local_kamailio_credentials
  ensure_local_reverb_credentials
  kubectl kustomize "$K8S_OVERLAY"
}

ensure_local_asterisk_credentials() {
  if [ -s "$K8S_ASTERISK_CREDENTIALS_FILE" ]; then
    return
  fi

  mkdir -p "$(dirname "$K8S_ASTERISK_CREDENTIALS_FILE")"
  umask 077
  {
    printf 'ARI_USERNAME=utcp_ari\n'
    printf 'ARI_PASSWORD='
    od -An -N24 -tx1 /dev/urandom | tr -d ' \n'
    printf '\n'
  } >"$K8S_ASTERISK_CREDENTIALS_FILE"
}

ensure_local_kamailio_credentials() {
  if [ -s "$K8S_KAMAILIO_PLATFORM_CREDENTIALS_FILE" ] && [ -s "$K8S_KAMAILIO_MIGRATION_CREDENTIALS_FILE" ]; then
    return
  fi

  mkdir -p "$(dirname "$K8S_KAMAILIO_PLATFORM_CREDENTIALS_FILE")" "$(dirname "$K8S_KAMAILIO_MIGRATION_CREDENTIALS_FILE")"
  local tmp_file
  tmp_file="$(mktemp)"
  umask 077
  {
    printf 'KAMAILIO_AUTH_DB_USER=utcp_kamailio_auth_reader\n'
    printf 'KAMAILIO_AUTH_DB_PASSWORD='
    od -An -N24 -tx1 /dev/urandom | tr -d ' \n'
    printf '\n'
    printf 'KAMAILIO_USRLOC_DB_USER=utcp_kamailio_usrloc_writer\n'
    printf 'KAMAILIO_USRLOC_DB_PASSWORD='
    od -An -N24 -tx1 /dev/urandom | tr -d ' \n'
    printf '\n'
    printf 'KAMAILIO_OBSERVER_DB_USER=utcp_kamailio_observer_reader\n'
    printf 'KAMAILIO_OBSERVER_DB_PASSWORD='
    od -An -N24 -tx1 /dev/urandom | tr -d ' \n'
    printf '\n'
  } >"$tmp_file"
  cp "$tmp_file" "$K8S_KAMAILIO_PLATFORM_CREDENTIALS_FILE"
  cp "$tmp_file" "$K8S_KAMAILIO_MIGRATION_CREDENTIALS_FILE"
  rm -f "$tmp_file"
}

ensure_local_reverb_credentials() {
  if [ -s "$K8S_REVERB_CREDENTIALS_FILE" ]; then
    return
  fi

  mkdir -p "$(dirname "$K8S_REVERB_CREDENTIALS_FILE")"
  umask 077
  {
    printf 'REVERB_APP_ID=utcp-local\n'
    printf 'REVERB_APP_KEY='
    od -An -N16 -tx1 /dev/urandom | tr -d ' \n'
    printf '\n'
    printf 'REVERB_APP_SECRET='
    od -An -N32 -tx1 /dev/urandom | tr -d ' \n'
    printf '\n'
  } >"$K8S_REVERB_CREDENTIALS_FILE"
}

wait_data() {
  kube -n "$K8S_DATA_NAMESPACE" rollout status statefulset/postgres --timeout=240s
  kube -n "$K8S_DATA_NAMESPACE" rollout status statefulset/redis --timeout=180s
  kube -n "$K8S_DATA_NAMESPACE" wait --for=condition=Ready pod -l app.kubernetes.io/component=postgres --timeout=180s
  kube -n "$K8S_DATA_NAMESPACE" wait --for=condition=Ready pod -l app.kubernetes.io/component=redis --timeout=180s
}

delete_migration_job() {
  kube -n "$K8S_PLATFORM_NAMESPACE" delete job utcp-migrate --ignore-not-found >/dev/null
  kube -n "$K8S_PLATFORM_NAMESPACE" wait --for=delete job/utcp-migrate --timeout=60s >/dev/null 2>&1 || true
}

wait_migration() {
  if ! kube -n "$K8S_PLATFORM_NAMESPACE" wait --for=condition=Complete job/utcp-migrate --timeout=180s; then
    kube -n "$K8S_PLATFORM_NAMESPACE" logs job/utcp-migrate --tail=100 >&2 || true
    exit 1
  fi
}

wait_platform() {
  for deployment in api worker scheduler reverb web gateway telephony-command-worker telephony-event-normalizer telephony-reconciler simulator-event-source asterisk-ari-events kamailio; do
    kube -n "$K8S_PLATFORM_NAMESPACE" rollout status "deployment/$deployment" --timeout=240s
  done
}

wait_runtime() {
  kube -n "$K8S_RUNTIME_NAMESPACE" rollout status deployment/asterisk-ari --timeout=240s
  kube -n "$K8S_RUNTIME_NAMESPACE" wait --for=condition=Ready pod -l app.kubernetes.io/component=asterisk-ari --timeout=180s
}

http_get() {
  local path="$1"
  curl --fail --silent --show-error --max-time 10 "http://127.0.0.1:${K8S_PROOF_PORT}${path}"
}

port_forward_gateway() {
  local log_file="$1"
  kube -n "$K8S_PLATFORM_NAMESPACE" port-forward --address 127.0.0.1 service/gateway "${K8S_PROOF_PORT}:8080" >"$log_file" 2>&1 &
  printf '%s\n' "$!"
}
