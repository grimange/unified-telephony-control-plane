#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/kubernetes/lib
. "$SCRIPT_DIR/lib"

required_tools
ensure_kubeconfig

kube delete -k "$K8S_PLATFORM_OVERLAY" --ignore-not-found
kube delete -k "$K8S_MIGRATION_OVERLAY" --ignore-not-found
kube delete -k "$K8S_DATA_OVERLAY" --ignore-not-found

if [ "${CONFIRM:-}" = "delete-k1-pvcs" ]; then
  kube -n "$K8S_DATA_NAMESPACE" delete pvc -l app.kubernetes.io/part-of=utcp --ignore-not-found
  printf 'deleted K1 PVCs in namespace %s\n' "$K8S_DATA_NAMESPACE"
else
  printf 'K1 PVCs retained. To delete local K1 data, re-run with CONFIRM=delete-k1-pvcs.\n'
fi
