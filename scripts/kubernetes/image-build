#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/kubernetes/lib
. "$SCRIPT_DIR/lib"

required_tools
check_k1_tag
ensure_local_reverb_credentials

# shellcheck disable=SC1090
. "$K8S_REVERB_CREDENTIALS_FILE"

docker build \
  --file "$ROOT/infrastructure/docker/api/Dockerfile" \
  --target app-prod \
  --tag "$API_LOCAL_IMAGE" \
  --build-arg "BUILD_VERSION=${UTCP_CONTRACT_VERSION:-0.1.0-dev}" \
  --build-arg "BUILD_COMMIT=unknown" \
  --build-arg "BUILD_CREATED=unknown" \
  --build-arg "IMAGE_SOURCE=local" \
  "$ROOT"

docker build \
  --file "$ROOT/infrastructure/docker/web/Dockerfile" \
  --target app-prod \
  --tag "$WEB_LOCAL_IMAGE" \
  --build-arg "BUILD_VERSION=${UTCP_CONTRACT_VERSION:-0.1.0-dev}" \
  --build-arg "BUILD_COMMIT=unknown" \
  --build-arg "BUILD_CREATED=unknown" \
  --build-arg "IMAGE_SOURCE=local" \
  --build-arg "VITE_UTCP_REVERB_APP_KEY=$REVERB_APP_KEY" \
  --build-arg "VITE_UTCP_WS_HOST=app.utcp.local.test" \
  --build-arg "VITE_UTCP_WS_PORT=443" \
  --build-arg "VITE_UTCP_WS_SCHEME=wss" \
  --build-arg "VITE_UTCP_WS_PATH=/app" \
  "$ROOT"

docker build \
  --file "$ROOT/infrastructure/docker/gateway/Dockerfile" \
  --tag "$GATEWAY_LOCAL_IMAGE" \
  --build-arg "BUILD_VERSION=${UTCP_CONTRACT_VERSION:-0.1.0-dev}" \
  --build-arg "BUILD_COMMIT=unknown" \
  --build-arg "BUILD_CREATED=unknown" \
  --build-arg "IMAGE_SOURCE=local" \
  "$ROOT"

docker build \
  --file "$ROOT/infrastructure/docker/asterisk/Dockerfile" \
  --tag "$ASTERISK_LOCAL_IMAGE" \
  --build-arg "ASTERISK_BASE_IMAGE=${ASTERISK_BASE_IMAGE:-debian:12.11-slim}" \
  "$ROOT"

docker build \
  --file "$ROOT/infrastructure/docker/rtpengine/Dockerfile" \
  --tag "$RTPENGINE_LOCAL_IMAGE" \
  --build-arg "BUILD_VERSION=${UTCP_CONTRACT_VERSION:-0.1.0-dev}" \
  --build-arg "BUILD_COMMIT=unknown" \
  --build-arg "BUILD_CREATED=unknown" \
  --build-arg "IMAGE_SOURCE=local" \
  --build-arg "RTPENGINE_VERSION=${RTPENGINE_VERSION:-mr26.0.1.19}" \
  --build-arg "RTPENGINE_SOURCE_COMMIT=${RTPENGINE_SOURCE_COMMIT:-3552ac76cceb24e3ec176b77ec9c25554ae5923b}" \
  --build-arg "RTPENGINE_BASE_IMAGE=${RTPENGINE_BASE_IMAGE:-debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd}" \
  "$ROOT"

docker build \
  --file "$ROOT/infrastructure/docker/freeswitch/Dockerfile" \
  --tag "$FREESWITCH_LOCAL_IMAGE" \
  --build-arg "FREESWITCH_BASE_IMAGE=${FREESWITCH_BASE_IMAGE}" \
  "$ROOT"

printf 'K1/T0/T3/T4C1 images built: %s %s %s %s %s %s\n' "$API_LOCAL_IMAGE" "$WEB_LOCAL_IMAGE" "$GATEWAY_LOCAL_IMAGE" "$ASTERISK_LOCAL_IMAGE" "$RTPENGINE_LOCAL_IMAGE" "$FREESWITCH_LOCAL_IMAGE"
