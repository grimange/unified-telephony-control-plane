#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/kubernetes/lib
. "$SCRIPT_DIR/lib"

required_tools
ensure_kubeconfig
check_k1_tag

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
render_overlay > "$tmp"

kube apply --dry-run=server -f "$tmp" >/dev/null
"$SCRIPT_DIR/static-check" "$tmp"

printf 'K1 Kubernetes config check passed\n'
