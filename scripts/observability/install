#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/observability/lib
. "$SCRIPT_DIR/lib"

ensure_cluster
"$SCRIPT_DIR/config-check" >/dev/null
apply_grafana_secret

helm_cmd upgrade --install kube-prometheus-stack kube-prometheus-stack \
  --repo "$KUBE_PROMETHEUS_STACK_HELM_REPOSITORY" \
  --version "$KUBE_PROMETHEUS_STACK_HELM_CHART_VERSION" \
  --namespace "$OBSERVABILITY_NAMESPACE" \
  --values "$OBSERVABILITY_HELM_DIR/kube-prometheus-stack-values.yaml" \
  --wait \
  --timeout 10m

helm_cmd upgrade --install loki loki \
  --repo "$LOKI_HELM_REPOSITORY" \
  --version "$LOKI_HELM_CHART_VERSION" \
  --namespace "$OBSERVABILITY_NAMESPACE" \
  --values "$OBSERVABILITY_HELM_DIR/loki-values.yaml" \
  --wait \
  --timeout 10m

helm_cmd upgrade --install alloy alloy \
  --repo "$ALLOY_HELM_REPOSITORY" \
  --version "$ALLOY_HELM_CHART_VERSION" \
  --namespace "$OBSERVABILITY_NAMESPACE" \
  --values "$OBSERVABILITY_HELM_DIR/alloy-values.yaml" \
  --wait \
  --timeout 10m

printf 'K4 observability Helm releases installed\n'
