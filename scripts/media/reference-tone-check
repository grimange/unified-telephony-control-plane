#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
asset="${UTCP_REFERENCE_TONE_ASSET:-$ROOT/infrastructure/docker/media/reference-tone.wav.base64}"
python3 - "$asset" <<'PY'
from __future__ import annotations

import base64
import hashlib
import io
import struct
import sys
import wave
from pathlib import Path

asset = Path(sys.argv[1])
try:
    raw = base64.b64decode("".join(asset.read_text().split()), validate=True)
    with wave.open(io.BytesIO(raw), "rb") as wav:
        channels = wav.getnchannels()
        sample_width = wav.getsampwidth()
        sample_rate = wav.getframerate()
        frames = wav.getnframes()
        pcm = wav.readframes(frames)
except (OSError, ValueError, EOFError, wave.Error) as exc:
    raise SystemExit(f"reference tone is not a valid base64-encoded WAV: {exc}")

if channels != 1 or sample_width != 2 or sample_rate != 8000:
    raise SystemExit("reference tone must be mono, 16-bit PCM, 8000 Hz")
if not 4.9 <= frames / sample_rate <= 5.1:
    raise SystemExit(f"reference tone duration is not approximately 5 seconds: {frames / sample_rate:.3f}s")
samples = struct.unpack(f"<{len(pcm) // 2}h", pcm)
peak = max(abs(sample) for sample in samples)
if peak < 8_000 or peak >= 32_767:
    raise SystemExit(f"reference tone is silent or clipping: peak={peak}")
digest = hashlib.sha256(raw).hexdigest()
print(f"reference tone: duration={frames / sample_rate:.3f}s rate={sample_rate} channels={channels} width={sample_width} peak={peak} sha256={digest}")
PY
