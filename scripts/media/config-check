#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
VERSIONS_FILE="$ROOT/versions.env"

# shellcheck disable=SC1090
. "$VERSIONS_FILE"

fail() {
  printf 'media config check failed: %s\n' "$1" >&2
  exit 1
}

command -v kubectl >/dev/null 2>&1 || fail "kubectl is required"
command -v python3 >/dev/null 2>&1 || fail "python3 is required"

[ "${RTPENGINE_VERSION:-}" = "mr26.0.1.19" ] || fail "RTPENGINE_VERSION must be mr26.0.1.19"
[ "${RTPENGINE_SOURCE_COMMIT:-}" = "3552ac76cceb24e3ec176b77ec9c25554ae5923b" ] || fail "RTPENGINE_SOURCE_COMMIT must match the selected upstream tag"
[ -n "${RTPENGINE_BASE_IMAGE:-}" ] || fail "RTPENGINE_BASE_IMAGE must be set"
case "$RTPENGINE_BASE_IMAGE" in
  *@sha256:*) ;;
  *) fail "RTPENGINE_BASE_IMAGE must include an immutable sha256 digest" ;;
esac
case "$RTPENGINE_BASE_IMAGE" in
  *:latest*) fail "RTPENGINE_BASE_IMAGE must not use latest" ;;
esac
[ "${RTPENGINE_NG_PORT:-}" = "2223" ] || fail "RTPENGINE_NG_PORT must be 2223"
[ "${RTPENGINE_MEDIA_PORT_MIN:-}" = "40000" ] || fail "RTPENGINE_MEDIA_PORT_MIN must be 40000"
[ "${RTPENGINE_MEDIA_PORT_MAX:-}" = "40099" ] || fail "RTPENGINE_MEDIA_PORT_MAX must be 40099"

dockerfile="${UTCP_RTPENGINE_DOCKERFILE:-$ROOT/infrastructure/docker/rtpengine/Dockerfile}"
entrypoint="${UTCP_RTPENGINE_ENTRYPOINT:-$ROOT/infrastructure/docker/rtpengine/entrypoint}"
deployment_source="${UTCP_RTPENGINE_DEPLOYMENT:-$ROOT/infrastructure/kubernetes/base/platform/rtpengine-deployment.yaml}"
platform_dir="${UTCP_PLATFORM_DIR:-$ROOT/infrastructure/kubernetes/base/platform}"
security_dir="${UTCP_SECURITY_DIR:-$ROOT/infrastructure/kubernetes/security}"
observability_dir="${UTCP_OBSERVABILITY_DIR:-$ROOT/infrastructure/kubernetes/observability}"
gateway_dir="${UTCP_GATEWAY_DIR:-$ROOT/infrastructure/kubernetes/gateway-api}"
readiness="$ROOT/infrastructure/docker/rtpengine/readiness"
[ -f "$dockerfile" ] || fail "rtpengine Dockerfile is missing"
[ -x "$entrypoint" ] || fail "rtpengine entrypoint must be executable"
[ -f "$deployment_source" ] || fail "rtpengine Deployment source is missing"
[ -d "$platform_dir" ] || fail "platform Kustomize directory is missing"
[ -d "$security_dir" ] || fail "security Kustomize directory is missing"
[ -d "$observability_dir" ] || fail "observability Kustomize directory is missing"
[ -d "$gateway_dir" ] || fail "gateway Kustomize directory is missing"
[ -x "$readiness" ] || fail "rtpengine ng ping helper must be executable"

grep -Fq "ARG RTPENGINE_VERSION=$RTPENGINE_VERSION" "$dockerfile" || fail "Dockerfile must pin the selected rtpengine version"
grep -Fq "ARG RTPENGINE_SOURCE_COMMIT=$RTPENGINE_SOURCE_COMMIT" "$dockerfile" || fail "Dockerfile must record the selected upstream commit"
grep -Fq "ARG RTPENGINE_BASE_IMAGE=$RTPENGINE_BASE_IMAGE" "$dockerfile" || fail "Dockerfile must use the pinned base image"
grep -Fq "sha256sum --check" "$dockerfile" || fail "Dockerfile must checksum official upstream package assets"
grep -Fq "USER 1000:1000" "$dockerfile" || fail "Dockerfile must run as UID/GID 1000"
python3 - "$dockerfile" "$RTPENGINE_VERSION" <<'PY'
from __future__ import annotations

import re
import sys
from pathlib import Path


dockerfile = Path(sys.argv[1])
rtpengine_version = sys.argv[2]
source = dockerfile.read_text(encoding="utf-8")
expected_package_version = rtpengine_version[2:] if rtpengine_version.startswith("mr") else rtpengine_version
expected_segment = f"+0.{rtpengine_version}"
assignment_pattern = re.compile(r'package="(?P<package>[^"]+)"')
package_pattern = re.compile(
    r"^rtpengine-daemon_"
    r"(?P<package_version>\d+\.\d+\.\d+\.\d+)"
    r"\+0\.(?P<release_version>mr\d+\.\d+\.\d+\.\d+)"
    r"\+gh\+trixie_(?P<arch>amd64|arm64)\.deb$"
)
packages: dict[str, str] = {}


def fail(message: str) -> None:
    print(f"media config check failed: {message}", file=sys.stderr)
    raise SystemExit(1)


for line_number, line in enumerate(source.splitlines(), start=1):
    match = assignment_pattern.search(line)
    if not match:
        continue

    package = match.group("package")
    arch_match = re.search(r"_(amd64|arm64)\.deb$", package)
    arch = arch_match.group(1) if arch_match else "unknown"

    if ":latest" in package or package == "latest":
        fail(f"Dockerfile package assignment for {arch} uses latest; expected convention is {expected_segment}")
    if f"+0~{rtpengine_version}" in package:
        fail(f"Dockerfile package assignment for {arch} uses '+0~'; expected convention is {expected_segment}: {package}")
    parsed = package_pattern.match(package)
    if not parsed:
        fail(
            f"Dockerfile package assignment for {arch} must match "
            f"rtpengine-daemon_{expected_package_version}{expected_segment}+gh+trixie_<arch>.deb: {package}"
        )
    if parsed.group("package_version") != expected_package_version:
        fail(
            f"Dockerfile package assignment for {arch} uses package version "
            f"{parsed.group('package_version')}; expected {expected_package_version}: {package}"
        )
    if parsed.group("release_version") != rtpengine_version:
        fail(
            f"Dockerfile package assignment for {arch} uses release version "
            f"{parsed.group('release_version')}; expected {rtpengine_version}: {package}"
        )
    packages[parsed.group("arch")] = package

expected_arches = {"amd64", "arm64"}
if set(packages) != expected_arches:
    fail(f"Dockerfile must define package assignments for amd64 and arm64; found {sorted(packages)}")
for arch, package in packages.items():
    expected = f"rtpengine-daemon_{expected_package_version}{expected_segment}+gh+trixie_{arch}.deb"
    if package != expected:
        fail(f"Dockerfile package assignment for {arch} is {package}; expected {expected}")
PY
grep -Fq -- "--table=-1" "$entrypoint" || fail "rtpengine entrypoint must select userspace forwarding with --table=-1"
grep -Fq 'fieldPath: status.podIP' "$deployment_source" || fail "POD_IP must come from status.podIP"
grep -Fq '6:result4:pong' "$readiness" || fail "ng ping helper must validate result=pong"

tmp_platform="$(mktemp)"
tmp_security="$(mktemp)"
tmp_observability="$(mktemp)"
tmp_gateway="$(mktemp)"
trap 'rm -f "$tmp_platform" "$tmp_security" "$tmp_observability" "$tmp_gateway"' EXIT

kubectl kustomize "$platform_dir" >"$tmp_platform"
kubectl kustomize "$security_dir" >"$tmp_security"
kubectl kustomize "$observability_dir" >"$tmp_observability"
kubectl kustomize "$gateway_dir" >"$tmp_gateway"

python3 - "$tmp_platform" "$tmp_security" "$tmp_observability" "$ROOT" "$entrypoint" "$deployment_source" <<'PY'
from __future__ import annotations

import re
import sys
from pathlib import Path
from typing import Any

import yaml


platform_path = Path(sys.argv[1])
security_path = Path(sys.argv[2])
observability_path = Path(sys.argv[3])
root = Path(sys.argv[4])
entrypoint_path = Path(sys.argv[5])
deployment_source_path = Path(sys.argv[6])
EXPECTED_PIDFILE = "/run/rtpengine/rtpengine.pid"
EXPECTED_WRITABLE_MOUNT = "/run/rtpengine"
TMP_MOUNT = "/tmp"


def fail(message: str) -> None:
    print(f"media config check failed: {message}", file=sys.stderr)
    raise SystemExit(1)


def docs(path: Path) -> list[dict[str, Any]]:
    return [doc for doc in yaml.safe_load_all(path.read_text(encoding="utf-8")) if isinstance(doc, dict)]


def key(doc: dict[str, Any]) -> str:
    metadata = doc.get("metadata") or {}
    return f"{doc.get('kind')}/{metadata.get('namespace')}/{metadata.get('name')}"


def selector_labels(selector: dict[str, Any]) -> dict[str, Any]:
    return selector.get("matchLabels") or {}


def selector_expressions(selector: dict[str, Any]) -> list[dict[str, Any]]:
    return selector.get("matchExpressions") or []


def exact_peer(
    peer: dict[str, Any],
    namespace: str,
    *,
    pod_labels: dict[str, str] | None = None,
    pod_expression: dict[str, Any] | None = None,
) -> bool:
    if "ipBlock" in peer:
        return False
    namespace_selector = selector_labels(peer.get("namespaceSelector") or {})
    if namespace_selector != {"kubernetes.io/metadata.name": namespace}:
        return False
    pod_selector = peer.get("podSelector") or {}
    if pod_labels is not None:
        return selector_labels(pod_selector) == pod_labels and not selector_expressions(pod_selector)
    if pod_expression is not None:
        return not selector_labels(pod_selector) and selector_expressions(pod_selector) == [pod_expression]
    return False


def exact_ports(ports: list[dict[str, Any]], protocol: str, port: int, end_port: int | None = None) -> bool:
    expected: dict[str, Any] = {"protocol": protocol, "port": port}
    if end_port is not None:
        expected["endPort"] = end_port
    return ports == [expected]


def has_exact_policy_rule(
    rules: list[dict[str, Any]],
    direction: str,
    namespace: str,
    protocol: str,
    port: int,
    *,
    pod_labels: dict[str, str] | None = None,
    pod_expression: dict[str, Any] | None = None,
    end_port: int | None = None,
) -> bool:
    peer_key = "from" if direction == "ingress" else "to"
    for rule in rules:
        peers = rule.get(peer_key) or []
        ports = rule.get("ports") or []
        if len(peers) != 1:
            continue
        if exact_peer(peers[0], namespace, pod_labels=pod_labels, pod_expression=pod_expression) and exact_ports(
            ports, protocol, port, end_port
        ):
            return True
    return False


def reject_overbroad_destination(policy: dict[str, Any], policy_name: str) -> None:
    for rule in (policy.get("spec") or {}).get("egress") or []:
        for peer in rule.get("to") or []:
            if "ipBlock" in peer:
                fail(f"{policy_name} rtpengine egress must not use ipBlock")
            namespace_selector = selector_labels(peer.get("namespaceSelector") or {})
            if namespace_selector == {"kubernetes.io/metadata.name": "utcp-platform"} and "podSelector" not in peer:
                fail(f"{policy_name} rtpengine egress has overbroad destination namespace without rtpengine Pod selector")


platform = {key(doc): doc for doc in docs(platform_path)}
security = {key(doc): doc for doc in docs(security_path)}
observability = {key(doc): doc for doc in docs(observability_path)}
source_deployments = [
    doc
    for doc in docs(deployment_source_path)
    if doc.get("kind") == "Deployment" and (doc.get("metadata") or {}).get("name") == "rtpengine"
]

deployment = platform.get("Deployment/utcp-platform/rtpengine")
service = platform.get("Service/utcp-platform/rtpengine")
config = platform.get("ConfigMap/utcp-platform/rtpengine-config")
if not deployment:
    fail("rtpengine Deployment is missing")
if not service:
    fail("rtpengine control Service is missing")
if not config:
    fail("rtpengine ConfigMap is missing")
if len(source_deployments) != 1:
    fail("rtpengine Deployment source must define exactly one rtpengine Deployment")
deployment_source = source_deployments[0]

if (deployment.get("metadata") or {}).get("labels", {}).get("app.kubernetes.io/component") != "rtpengine":
    fail("Deployment must carry app.kubernetes.io/component=rtpengine")
if (deployment.get("spec") or {}).get("replicas") != 1:
    fail("Deployment replica count must be one")

template = ((deployment.get("spec") or {}).get("template") or {})
pod_spec = template.get("spec") or {}
pod_labels = (template.get("metadata") or {}).get("labels") or {}
if pod_labels.get("utcp.io/network-role") != "rtpengine-media":
    fail("Pod must carry utcp.io/network-role=rtpengine-media")
if pod_spec.get("automountServiceAccountToken") is not False:
    fail("Pod must not automount a Kubernetes API credential")
for field in ("hostNetwork", "hostPID", "hostIPC"):
    if pod_spec.get(field) is True:
        fail(f"Pod must not enable {field}")
for volume in pod_spec.get("volumes") or []:
    if "hostPath" in volume:
        fail("Pod must not use hostPath volumes")

pod_security = pod_spec.get("securityContext") or {}
if pod_security.get("runAsNonRoot") is not True:
    fail("Pod must set runAsNonRoot=true")
if pod_security.get("runAsUser") != 1000 or pod_security.get("runAsGroup") != 1000:
    fail("Pod must run as UID/GID 1000")
if (pod_security.get("seccompProfile") or {}).get("type") != "RuntimeDefault":
    fail("Pod must use RuntimeDefault seccomp")

containers = pod_spec.get("containers") or []
if len(containers) != 1:
    fail("Deployment must define exactly one container")
container = containers[0]
if container.get("image") != "utcp-rtpengine":
    fail("Deployment must use the repository-built utcp-rtpengine image authority")
security_context = container.get("securityContext") or {}
if security_context.get("allowPrivilegeEscalation") is not False:
    fail("Container must set allowPrivilegeEscalation=false")
if security_context.get("readOnlyRootFilesystem") is not True:
    fail("Container must set readOnlyRootFilesystem=true")
if (security_context.get("capabilities") or {}).get("drop") != ["ALL"]:
    fail("Container must drop all Linux capabilities")
if (security_context.get("capabilities") or {}).get("add"):
    fail("Container must not add Linux capabilities")

resources = container.get("resources") or {}
if not all(resources.get(part, {}).get(name) for part in ("requests", "limits") for name in ("cpu", "memory")):
    fail("Container must define CPU and memory requests and limits")

ports = {(port.get("name"), port.get("protocol")): port.get("containerPort") for port in container.get("ports") or []}
if ports.get(("ng", "UDP")) != 2223:
    fail("Container must expose UDP ng port 2223")
if ports.get(("media", "UDP")) != 40000:
    fail("Container must expose media anchor port 40000 for the bounded range")
if ports.get(("metrics", "TCP")) != 2224:
    fail("Container must expose internal metrics port 2224")

env = container.get("env") or []
pod_ip = [entry for entry in env if entry.get("name") == "POD_IP"]
if not pod_ip or (((pod_ip[0].get("valueFrom") or {}).get("fieldRef") or {}).get("fieldPath") != "status.podIP"):
    fail("POD_IP must be supplied by downward API status.podIP")
if not any((entry.get("configMapRef") or {}).get("name") == "rtpengine-config" for entry in container.get("envFrom") or []):
    fail("Container must load the rtpengine ConfigMap")

data = config.get("data") or {}
if data != {
    "RTPENGINE_NG_PORT": "2223",
    "RTPENGINE_MEDIA_PORT_MIN": "40000",
    "RTPENGINE_MEDIA_PORT_MAX": "40099",
    "RTPENGINE_METRICS_PORT": "2224",
}:
    fail("rtpengine ConfigMap values must be the canonical T3-S1 ports")

for probe_name in ("readinessProbe", "livenessProbe"):
    command = (((container.get(probe_name) or {}).get("exec") or {}).get("command") or [])
    if command != ["/usr/local/bin/utcp-rtpengine-ng-ping"]:
        fail(f"{probe_name} must use real ng ping helper")

source_template = ((deployment_source.get("spec") or {}).get("template") or {})
source_pod_spec = source_template.get("spec") or {}
source_containers = source_pod_spec.get("containers") or []
if len(source_containers) != 1:
    fail("rtpengine Deployment source must define exactly one container")
source_container = source_containers[0]
source_volumes = {volume.get("name"): volume for volume in source_pod_spec.get("volumes") or []}
source_mounts = {
    mount.get("mountPath"): mount
    for mount in source_container.get("volumeMounts") or []
    if mount.get("mountPath")
}
entrypoint_text = entrypoint_path.read_text(encoding="utf-8")
pidfiles = re.findall(r"--pidfile=([^\\\s]+)", entrypoint_text)
if len(pidfiles) != 1:
    fail(
        f"entrypoint must define exactly one --pidfile argument; found {len(pidfiles)}; "
        f"entrypoint PID path must be {EXPECTED_PIDFILE}; expected writable mount {EXPECTED_WRITABLE_MOUNT}"
    )
pidfile = pidfiles[0].strip("'\"")
tmp_mount = source_mounts.get(TMP_MOUNT)
if pidfile.startswith(f"{TMP_MOUNT}/") or pidfile == TMP_MOUNT:
    conflict = TMP_MOUNT if tmp_mount else "missing /tmp mount"
    fail(
        f"entrypoint PID path {pidfile} is below the conflicting parent mount {conflict}; "
        f"expected writable mount {EXPECTED_WRITABLE_MOUNT}"
    )
if pidfile != EXPECTED_PIDFILE:
    fail(
        f"entrypoint PID path {pidfile} must be {EXPECTED_PIDFILE}; "
        f"expected writable mount {EXPECTED_WRITABLE_MOUNT}; conflicting parent mount {TMP_MOUNT}"
    )
run_mount = source_mounts.get(EXPECTED_WRITABLE_MOUNT)
if not run_mount:
    fail(
        f"entrypoint PID path {pidfile} requires expected writable mount "
        f"{EXPECTED_WRITABLE_MOUNT}; conflicting parent mount {TMP_MOUNT}"
    )
if run_mount.get("readOnly") is True:
    fail(
        f"entrypoint PID path {pidfile} requires writable mount {EXPECTED_WRITABLE_MOUNT}; "
        f"readOnly=true; conflicting parent mount {TMP_MOUNT}"
    )
run_volume = source_volumes.get(run_mount.get("name"))
if not run_volume or "emptyDir" not in run_volume:
    volume_name = run_mount.get("name", "unknown")
    fail(
        f"entrypoint PID path {pidfile} requires expected writable mount "
        f"{EXPECTED_WRITABLE_MOUNT} backed by emptyDir; volume {volume_name} is not emptyDir; "
        f"conflicting parent mount {TMP_MOUNT}"
    )
pid_parent = str(Path(pidfile).parent)
if not (pid_parent == EXPECTED_WRITABLE_MOUNT or pid_parent.startswith(f"{EXPECTED_WRITABLE_MOUNT}/")):
    fail(
        f"entrypoint PID path {pidfile} is outside expected writable mount "
        f"{EXPECTED_WRITABLE_MOUNT}; conflicting parent mount {TMP_MOUNT}"
    )

service_spec = service.get("spec") or {}
if service_spec.get("type") != "ClusterIP":
    fail("control Service must be ClusterIP")
if service_spec.get("ports") != [{"name": "ng", "protocol": "UDP", "port": 2223, "targetPort": "ng"}]:
    fail("control Service must expose only UDP 2223")

policy = security.get("NetworkPolicy/utcp-platform/allow-rtpengine-media")
if not policy:
    fail("allow-rtpengine-media NetworkPolicy is missing")
policy_spec = policy.get("spec") or {}
ingress = policy_spec.get("ingress") or []
egress = policy_spec.get("egress") or []
policy_text = yaml.safe_dump(policy, sort_keys=True)
for forbidden in ("utcp-data", "postgres", "redis", "kube-system", "0.0.0.0/0", "::/0"):
    if forbidden in policy_text:
        fail(f"NetworkPolicy must not allow {forbidden}")
for required in (
    "utcp.io/network-role: rtpengine-media",
    "utcp.io/network-role: kamailio-signaling",
    "utcp.io/network-role: asterisk-ari",
    "app.kubernetes.io/name",
    "prometheus",
    "port: 2223",
    "port: 40000",
    "endPort: 40099",
    "port: 2224",
):
    if required not in policy_text:
        fail(f"NetworkPolicy missing required selector or port: {required}")
if (policy_spec.get("podSelector") or {}).get("matchLabels") != {"utcp.io/network-role": "rtpengine-media"}:
    fail("allow-rtpengine-media must target only rtpengine-media Pods")
if not has_exact_policy_rule(
    ingress,
    "ingress",
    "utcp-platform",
    "UDP",
    2223,
    pod_labels={"utcp.io/network-role": "kamailio-signaling"},
):
    fail("rtpengine destination ingress missing Kamailio identity to rtpengine UDP 2223")
if not has_exact_policy_rule(
    ingress,
    "ingress",
    "utcp-observability",
    "TCP",
    2224,
    pod_expression={"key": "app.kubernetes.io/name", "operator": "In", "values": ["prometheus"]},
):
    fail("rtpengine destination ingress missing Prometheus identity to rtpengine TCP 2224")

kamailio_policy = security.get("NetworkPolicy/utcp-platform/allow-kamailio-signaling-required-traffic")
if not kamailio_policy:
    fail("missing source policy allow-kamailio-signaling-required-traffic")
kamailio_spec = kamailio_policy.get("spec") or {}
if (kamailio_spec.get("podSelector") or {}).get("matchLabels") != {"utcp.io/network-role": "kamailio-signaling"}:
    fail("Kamailio source policy selector drifted from kamailio-signaling")
reject_overbroad_destination(kamailio_policy, "Kamailio source policy")
if not has_exact_policy_rule(
    kamailio_spec.get("egress") or [],
    "egress",
    "utcp-platform",
    "UDP",
    2223,
    pod_labels={"app.kubernetes.io/component": "rtpengine"},
):
    fail("missing source policy Kamailio egress to rtpengine UDP 2223 with exact destination selector")

prometheus_policy = observability.get("NetworkPolicy/utcp-observability/allow-prometheus-egress-to-application-metrics")
if not prometheus_policy:
    fail("missing source policy allow-prometheus-egress-to-application-metrics")
prometheus_spec = prometheus_policy.get("spec") or {}
if selector_expressions(prometheus_spec.get("podSelector") or {}) != [
    {"key": "app.kubernetes.io/name", "operator": "In", "values": ["prometheus"]}
] or selector_labels(prometheus_spec.get("podSelector") or {}):
    fail("Prometheus source policy selector drifted from prometheus")
reject_overbroad_destination(prometheus_policy, "Prometheus source policy")
if not has_exact_policy_rule(
    prometheus_spec.get("egress") or [],
    "egress",
    "utcp-platform",
    "TCP",
    2224,
    pod_labels={"app.kubernetes.io/component": "rtpengine"},
):
    fail("missing source policy Prometheus egress to rtpengine TCP 2224 with exact destination selector")

pod_monitor = observability.get("PodMonitor/utcp-observability/rtpengine")
if not pod_monitor:
    fail("missing scrape target PodMonitor/utcp-observability/rtpengine")
monitor_spec = pod_monitor.get("spec") or {}
if monitor_spec.get("namespaceSelector") != {"matchNames": ["utcp-platform"]}:
    fail("rtpengine scrape target must select only namespace utcp-platform")
if (monitor_spec.get("selector") or {}).get("matchLabels") != {
    "app.kubernetes.io/part-of": "utcp",
    "app.kubernetes.io/component": "rtpengine",
}:
    fail("rtpengine scrape selector drifted from app.kubernetes.io/component=rtpengine")
endpoints = monitor_spec.get("podMetricsEndpoints") or []
if endpoints != [{"port": "metrics", "path": "/metrics", "interval": "30s", "scrapeTimeout": "10s"}]:
    fail("rtpengine scrape target must use /metrics on the named metrics port with repository-standard interval")
if ports.get(("metrics", "TCP")) != 2224:
    fail("rtpengine scrape port metrics must resolve to TCP 2224")

for object_id, doc in {**platform, **observability}.items():
    if doc.get("kind") != "Service":
        continue
    spec = doc.get("spec") or {}
    service_text = yaml.safe_dump(doc, sort_keys=True)
    if "rtpengine" in service_text and spec.get("type") in {"NodePort", "LoadBalancer"}:
        fail(f"public metrics resource exists through {object_id}")
    for service_port in spec.get("ports") or []:
        if service_port.get("port") == 2224 and spec.get("type") in {"NodePort", "LoadBalancer"}:
            fail(f"public metrics resource exposes TCP 2224 through {object_id}")

cluster_config = (root / "infrastructure/k3d/cluster.yaml").read_text(encoding="utf-8")
for forbidden in ("2223", "40000", "40099", "rtpengine"):
    if forbidden in cluster_config:
        fail("k3d cluster config must not publish rtpengine host UDP ports")

kamailio_config = (root / "infrastructure/kubernetes/base/platform/kamailio-configmap.yaml").read_text(encoding="utf-8")
for forbidden in ("rtpengine_offer", "rtpengine_answer", "rtpengine_manage", "rtpengine_delete"):
    if forbidden in kamailio_config:
        fail("T3-S1 must not add production Kamailio media routing")
PY

if grep -Eiq 'kind:[[:space:]]*(UDPRoute|TCPRoute|TLSRoute)|rtpengine|40000|40099|2223|2224' "$tmp_gateway"; then
  fail "Gateway API render must not expose RTP or rtpengine control"
fi

if rg -n "rtpengine|media_session|media_sessions|rtp_media|create_.*media" "$ROOT/apps/api/database" "$ROOT/apps/api/app" >/dev/null; then
  fail "T3-S1 must not introduce durable media authority in the application"
fi

printf 'T3-S1 media config check passed\n'
