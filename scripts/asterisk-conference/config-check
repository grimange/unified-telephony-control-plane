grep -q "kube -n.*exec" scripts/asterisk-conference/status || fail "conference status does not execute in the deployed application context"
grep -q "scripts/kubernetes/lib" scripts/asterisk-conference/recovery-status || fail "conference recovery status does not use Kubernetes status helper"
grep -q "kube -n.*exec" scripts/asterisk-conference/recovery-status || fail "conference recovery status does not execute in the deployed application context"
grep -q -- "--corridor" scripts/asterisk-conference/recovery-runtime-proof || fail "conference recovery proof does not expose corridor selection"
