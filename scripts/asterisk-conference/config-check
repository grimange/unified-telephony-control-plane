grep -q "conference_runtime_bindings.runtime_node_id', (string) \$receipt->runtime_node_id" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriEventNormalizer.php || fail "Asterisk normalizer does not fence events by receipt RuntimeNode"
