#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TARGET="$ROOT/apps/api/app/Simulator/SimulatorCatalog.php"
TMP="$(mktemp -d)"
trap 'cp "$TMP/SimulatorCatalog.php" "$TARGET"; rm -rf "$TMP"' EXIT
cp "$TARGET" "$TMP/SimulatorCatalog.php"

make simulator-config-check >"$TMP/out" 2>"$TMP/err"

printf '%s\n' '// forbidden vendor client: new AriClient and ESL connect' >> "$TARGET"
if make simulator-config-check >"$TMP/out" 2>"$TMP/err"; then
  printf 'simulator vendor-client mutation unexpectedly passed\n' >&2
  exit 1
fi
grep -Fq 'simulator contains live runtime client' "$TMP/err" || { cat "$TMP/err" >&2; exit 1; }

cp "$TMP/SimulatorCatalog.php" "$TARGET"
printf 'Simulator word-boundary and vendor-client tests passed\n'
