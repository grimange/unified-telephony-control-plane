#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

KUBECONFIG_FILE="${KUBECONFIG:-$ROOT/.runtime/kubeconfig/utcp-local.yaml}"
KUBE_CONTEXT="${KUBE_CONTEXT:-k3d-utcp-local}"

if [ -f "$KUBECONFIG_FILE" ] && kubectl --kubeconfig "$KUBECONFIG_FILE" --context "$KUBE_CONTEXT" -n utcp-platform get deploy/api >/dev/null 2>&1; then
  kubectl --kubeconfig "$KUBECONFIG_FILE" --context "$KUBE_CONTEXT" -n utcp-platform exec deploy/api -- php artisan simulator:status
  printf 'simulator_event_source_deployments='
  kubectl --kubeconfig "$KUBECONFIG_FILE" --context "$KUBE_CONTEXT" -n utcp-platform get deploy simulator-event-source -o jsonpath='{.status.readyReplicas}/{.spec.replicas}' 2>/dev/null || printf 'missing'
  printf '\n'
  exit 0
fi

if [ -f apps/api/artisan ] && cd "$ROOT/apps/api" && php artisan list --raw 2>/dev/null | grep -qx 'simulator:status'; then
  php artisan simulator:status
else
  printf 'simulator_status=unavailable\n'
fi
