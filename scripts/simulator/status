#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

if [ -f .runtime/kubeconfig ] && kubectl --kubeconfig .runtime/kubeconfig -n utcp-platform get deploy/api >/dev/null 2>&1; then
  kubectl --kubeconfig .runtime/kubeconfig -n utcp-platform exec deploy/api -- php artisan simulator:status
  printf 'simulator_event_source_deployments='
  kubectl --kubeconfig .runtime/kubeconfig -n utcp-platform get deploy simulator-event-source -o jsonpath='{.status.readyReplicas}/{.spec.replicas}' 2>/dev/null || printf 'missing'
  printf '\n'
  exit 0
fi

if [ -f apps/api/artisan ] && cd "$ROOT/apps/api" && php artisan list --raw 2>/dev/null | grep -qx 'simulator:status'; then
  php artisan simulator:status
else
  printf 'simulator_status=unavailable\n'
fi
