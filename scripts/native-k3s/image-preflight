#!/usr/bin/env bash
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"
require_image_lock
ensure_target
scheme="${UTCP_SERVER_IMAGE_REGISTRY_SCHEME:-https}"
for variable in UTCP_SERVER_POSTGRES_IMAGE UTCP_SERVER_REDIS_IMAGE UTCP_SERVER_API_IMAGE UTCP_SERVER_WEB_IMAGE UTCP_SERVER_GATEWAY_IMAGE UTCP_SERVER_ASTERISK_IMAGE UTCP_SERVER_FREESWITCH_IMAGE UTCP_SERVER_RTPENGINE_IMAGE UTCP_SERVER_KAMAILIO_IMAGE; do
  reference="${!variable}"
  registry="${reference%%/*}"
  repository="${reference#*/}"
  repository="${repository%@*}"
  digest="${reference#*@}"
  printf 'required=%s\n' "$reference"
  manifest_url="$scheme://$registry/v2/$repository/manifests/$digest"
  case "$registry" in
    ghcr.io)
      token="$(curl --connect-timeout 5 --max-time 10 --fail --silent --show-error --get \
        --data-urlencode "service=$registry" \
        --data-urlencode "scope=repository:$repository:pull" \
        "$scheme://$registry/token" | jq -er '.token')"
      code="$(curl --connect-timeout 5 --max-time 10 --silent --show-error --location --output /dev/null --write-out '%{http_code}' \
        -H "Authorization: Bearer $token" \
        -H 'Accept: application/vnd.oci.image.index.v1+json' \
        -H 'Accept: application/vnd.docker.distribution.manifest.list.v2+json' \
        -H 'Accept: application/vnd.oci.image.manifest.v1+json' \
        -H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
        "$manifest_url" || true)"
      ;;
    *)
      code="$(curl --connect-timeout 5 --max-time 10 --silent --show-error --location --output /dev/null --write-out '%{http_code}' \
        -H 'Accept: application/vnd.oci.image.index.v1+json' \
        -H 'Accept: application/vnd.docker.distribution.manifest.list.v2+json' \
        -H 'Accept: application/vnd.oci.image.manifest.v1+json' \
        -H 'Accept: application/vnd.docker.distribution.manifest.v2+json' \
        "$manifest_url" || true)"
      ;;
  esac
  [ "$code" = 200 ] || fail "$variable is not anonymously pullable from $scheme://$registry (HTTP $code)"
done
printf 'native image preflight passed target, immutable-lock, registry, and image-manifest checks\n'
