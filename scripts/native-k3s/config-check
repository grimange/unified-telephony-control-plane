#!/usr/bin/env bash
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"
require_image_lock
ensure_target
manifest="$(mktemp)"
trap 'rm -f "$manifest"' EXIT
render_server > "$manifest"
grep -Fq 'storageClassName: local-path' "$manifest" || fail 'server overlay must use local-path persistence'
if grep -Eq 'utcp-local-registry|127\.0\.0\.1:5001|hostPort:' "$manifest"; then fail 'native manifest contains a local-registry or hostPort resource'; fi
python3 - "$manifest" <<'PY'
from pathlib import Path
import sys
import yaml

docs = [doc for doc in yaml.safe_load_all(Path(sys.argv[1]).read_text()) if isinstance(doc, dict)]
services = [doc for doc in docs if doc.get("kind") == "Service"]
external = [doc for doc in services if (doc.get("metadata") or {}).get("name") == "kamailio-sip-external"]
if len(external) != 1:
    raise SystemExit("native-k3s: exactly one kamailio-sip-external Service is required")

service = external[0]
spec = service.get("spec") or {}
if spec.get("type") != "NodePort":
    raise SystemExit("native-k3s: external Kamailio SIP Service must be NodePort")
if spec.get("externalTrafficPolicy") != "Local":
    raise SystemExit("native-k3s: external Kamailio SIP Service must use externalTrafficPolicy Local")
if spec.get("ports") != [{
    "name": "sip-udp", "protocol": "UDP", "port": 5060,
    "targetPort": "sip-ext-udp", "nodePort": 30560,
}]:
    raise SystemExit("native-k3s: external Kamailio SIP Service must expose UDP/5060 through NodePort 30560")

for candidate in services:
    if candidate is not service and (candidate.get("spec") or {}).get("type") in {"NodePort", "LoadBalancer"}:
        meta = candidate.get("metadata") or {}
        raise SystemExit(f"native-k3s: unapproved externally exposed Service {meta.get('namespace')}/{meta.get('name')}")
PY
printf 'native k3s configuration check passed\n'
