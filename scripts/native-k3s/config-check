#!/usr/bin/env bash
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"
validate_provider_sip_identity
require_image_lock
ensure_target
manifest="$(mktemp)"
trap 'rm -f "$manifest"' EXIT
render_server > "$manifest"
grep -Fq 'storageClassName: local-path' "$manifest" || fail 'server overlay must use local-path persistence'
if grep -Eq 'utcp-local-registry|127\.0\.0\.1:5001|hostPort:' "$manifest"; then fail 'native manifest contains a local-registry or hostPort resource'; fi
python3 - "$manifest" <<'PY'
from pathlib import Path
import sys
import yaml

docs = [doc for doc in yaml.safe_load_all(Path(sys.argv[1]).read_text()) if isinstance(doc, dict)]
services = [doc for doc in docs if doc.get("kind") == "Service"]
config_maps = [doc for doc in docs if doc.get("kind") == "ConfigMap"]
external = [doc for doc in services if (doc.get("metadata") or {}).get("name") == "kamailio-sip-external"]
if len(external) != 1:
    raise SystemExit("native-k3s: exactly one kamailio-sip-external Service is required")

application_configs = [
    doc for doc in config_maps
    if (doc.get("metadata") or {}).get("namespace") == "utcp-platform"
    and (doc.get("metadata") or {}).get("name", "").startswith("utcp-application-config-")
]
if len(application_configs) != 1:
    raise SystemExit("native-k3s: exactly one generated platform application ConfigMap is required")
if (application_configs[0].get("data") or {}).get("KAMAILIO_REGISTRATION_CONTROL_URL") != "http://kamailio-registration-control.utcp-platform.svc.cluster.local:8090/rpc":
    raise SystemExit("native-k3s: application ConfigMap must define the canonical Kamailio registration-control URL")

fixtures = [
    doc for doc in config_maps
    if (doc.get("metadata") or {}).get("namespace") == "utcp-runtime"
    and (doc.get("metadata") or {}).get("name") == "asterisk-local-sip-fixtures"
]
if len(fixtures) != 1:
    raise SystemExit("native-k3s: canonical Asterisk SIP fixture ConfigMap is required")
fixture_data = (fixtures[0].get("data") or {}).get("extensions.local.conf", "")
fixture_lines = fixture_data.splitlines()
fixture_starts = [index for index, line in enumerate(fixture_lines) if line.startswith("exten => 9900,1")]
if len(fixture_starts) != 1:
    raise SystemExit("native-k3s: Asterisk SIP fixture must define exactly one 9900 extension")
fixture_start = fixture_starts[0]
fixture_end = next((index for index in range(fixture_start + 1, len(fixture_lines)) if fixture_lines[index].startswith("exten => ")), len(fixture_lines))
fixture_route = "\n".join(fixture_lines[fixture_start:fixture_end])
answer_position = fixture_route.find("Answer()")
echo_position = fixture_route.find("Echo()")
if answer_position < 0 or echo_position < 0 or answer_position > echo_position:
    raise SystemExit("native-k3s: Asterisk 9900 fixture must answer before Echo")

asterisk_deployments = [
    doc for doc in docs
    if doc.get("kind") == "Deployment"
    and (doc.get("metadata") or {}).get("namespace") == "utcp-runtime"
    and (doc.get("metadata") or {}).get("name") == "asterisk-ari"
]
if len(asterisk_deployments) != 1:
    raise SystemExit("native-k3s: canonical Asterisk Deployment is required")
asterisk_spec = (((asterisk_deployments[0].get("spec") or {}).get("template") or {}).get("spec") or {})
fixture_volume = next((
    volume for volume in asterisk_spec.get("volumes") or []
    if volume.get("name") == "asterisk-local-config"
), None)
if not fixture_volume or (fixture_volume.get("configMap") or {}).get("name") != "asterisk-local-sip-fixtures":
    raise SystemExit("native-k3s: Asterisk Deployment must consume the canonical SIP fixture ConfigMap")

registration_services = [
    doc for doc in services
    if (doc.get("metadata") or {}).get("name") == "kamailio-registration-control"
    and (doc.get("metadata") or {}).get("namespace") == "utcp-platform"
]
if len(registration_services) != 1:
    raise SystemExit("native-k3s: canonical Kamailio registration-control Service is required")
if (registration_services[0].get("spec") or {}).get("ports") != [{
    "name": "jsonrpc", "protocol": "TCP", "port": 8090, "targetPort": "reg-control",
}]:
    raise SystemExit("native-k3s: Kamailio registration-control Service must expose TCP/8090 to reg-control")

service = external[0]
spec = service.get("spec") or {}
if spec.get("type") != "NodePort":
    raise SystemExit("native-k3s: external Kamailio SIP Service must be NodePort")
if spec.get("externalTrafficPolicy") != "Local":
    raise SystemExit("native-k3s: external Kamailio SIP Service must use externalTrafficPolicy Local")
if spec.get("ports") != [{
    "name": "sip-udp", "protocol": "UDP", "port": 5060,
    "targetPort": "sip-ext-udp", "nodePort": 30560,
}]:
    raise SystemExit("native-k3s: external Kamailio SIP Service must expose UDP/5060 through NodePort 30560")

for candidate in services:
    if candidate is not service and (candidate.get("spec") or {}).get("type") in {"NodePort", "LoadBalancer"}:
        meta = candidate.get("metadata") or {}
        raise SystemExit(f"native-k3s: unapproved externally exposed Service {meta.get('namespace')}/{meta.get('name')}")
PY
printf 'native k3s configuration check passed\n'
