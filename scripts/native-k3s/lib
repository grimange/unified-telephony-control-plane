#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
. "$ROOT/versions.env"

SERVER_OVERLAY="$ROOT/infrastructure/kubernetes/overlays/server"
SERVER_STATE_DIR="${UTCP_SERVER_STATE_DIR:-$ROOT/.runtime/native-k3s}"
SERVER_KUBECONFIG="${UTCP_SERVER_KUBECONFIG:-${KUBECONFIG:-$HOME/.kube/config}}"
SERVER_CONTEXT="${UTCP_SERVER_CONTEXT:-default}"
SERVER_NODE_NAME="${UTCP_SERVER_NODE_NAME:-utcp-dev01}"
SERVER_IMAGE_LOCK="${UTCP_SERVER_IMAGE_LOCK:-$SERVER_STATE_DIR/image-lock.env}"
SERVER_PROVIDER_SIP_ADDRESS="${UTCP_SERVER_PROVIDER_SIP_ADDRESS:-}"
SERVER_PROVIDER_SIP_PORT="${UTCP_SERVER_PROVIDER_SIP_PORT:-}"
SERVER_PROOF_PORT="${UTCP_SERVER_PROOF_PORT:-18090}"
SERVER_NAMESPACE_PLATFORM="utcp-platform"
SERVER_NAMESPACE_DATA="utcp-data"
SERVER_NAMESPACE_RUNTIME="utcp-runtime"

server_kube() {
  kubectl --kubeconfig "$SERVER_KUBECONFIG" --context "$SERVER_CONTEXT" "$@"
}

fail() { printf 'native-k3s: %s\n' "$1" >&2; exit 1; }

validate_provider_sip_identity() {
  [ -n "$SERVER_PROVIDER_SIP_ADDRESS" ] && [ -n "$SERVER_PROVIDER_SIP_PORT" ] \
    || fail 'provider-facing SIP signaling identity is not configured (set UTCP_SERVER_PROVIDER_SIP_ADDRESS and UTCP_SERVER_PROVIDER_SIP_PORT)'

  printf '%s' "$SERVER_PROVIDER_SIP_PORT" | grep -Eq '^[0-9]+$' \
    || fail 'UTCP_SERVER_PROVIDER_SIP_PORT must be a bare integer'
  [ "$SERVER_PROVIDER_SIP_PORT" -ge 1 ] 2>/dev/null && [ "$SERVER_PROVIDER_SIP_PORT" -le 65535 ] 2>/dev/null \
    || fail 'UTCP_SERVER_PROVIDER_SIP_PORT must be between 1 and 65535'

  case "$SERVER_PROVIDER_SIP_ADDRESS" in
    *[[:space:]]*|sip:*|sips:*|*'/'*|*'@'*|*'?'*|*';'*|*'<'*|*'>'*|*'{'*|*'}'*|*'$'*|__*)
      fail 'UTCP_SERVER_PROVIDER_SIP_ADDRESS must be a host-only address without a URI, port, or unresolved placeholder'
      ;;
    *.svc|*.svc.cluster.local|localhost|localhost.localdomain|127.*|0.0.0.0|::1|10.42.*|10.43.*)
      fail 'UTCP_SERVER_PROVIDER_SIP_ADDRESS must not be loopback or a cluster-internal identity'
      ;;
  esac

  if printf '%s' "$SERVER_PROVIDER_SIP_ADDRESS" | grep -q ':'; then
    python3 - "$SERVER_PROVIDER_SIP_ADDRESS" <<'PY' || fail 'UTCP_SERVER_PROVIDER_SIP_ADDRESS must be a valid IPv6 literal or hostname'
import ipaddress
import sys

try:
    value = ipaddress.ip_address(sys.argv[1])
except ValueError:
    raise SystemExit(1)
if not isinstance(value, ipaddress.IPv6Address) or value.is_loopback or value.is_unspecified:
    raise SystemExit(1)
PY
  elif printf '%s' "$SERVER_PROVIDER_SIP_ADDRESS" | grep -Eq '^[0-9.]+$'; then
    python3 - "$SERVER_PROVIDER_SIP_ADDRESS" <<'PY' || fail 'UTCP_SERVER_PROVIDER_SIP_ADDRESS must be a valid IPv4 literal'
import ipaddress
import sys

try:
    value = ipaddress.ip_address(sys.argv[1])
except ValueError:
    raise SystemExit(1)
if not isinstance(value, ipaddress.IPv4Address) or value.is_loopback or value.is_unspecified:
    raise SystemExit(1)
PY
  elif ! printf '%s' "$SERVER_PROVIDER_SIP_ADDRESS" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$'; then
    fail 'UTCP_SERVER_PROVIDER_SIP_ADDRESS must be a valid IPv4 literal or DNS hostname'
  fi
}

provider_sip_advertise() {
  validate_provider_sip_identity
  if printf '%s' "$SERVER_PROVIDER_SIP_ADDRESS" | grep -q ':'; then
    printf '[%s]:%s' "$SERVER_PROVIDER_SIP_ADDRESS" "$SERVER_PROVIDER_SIP_PORT"
  else
    printf '%s:%s' "$SERVER_PROVIDER_SIP_ADDRESS" "$SERVER_PROVIDER_SIP_PORT"
  fi
}

require_canonical_identity() {
  [ "$SERVER_CONTEXT" = "default" ] || fail "canonical native context must be default: $SERVER_CONTEXT"
  [ "$SERVER_NODE_NAME" = "utcp-dev01" ] || fail "canonical native node must be utcp-dev01: $SERVER_NODE_NAME"
}

ensure_no_historical_edge_collision() {
  command -v docker >/dev/null 2>&1 || fail 'docker is required to verify historical k3d edge ownership'
  local owners
  owners="$(docker ps --filter 'name=k3d-utcp-local' --format '{{.Names}}\t{{.Ports}}' 2>/dev/null || true)"
  if printf '%s\n' "$owners" | grep -Eq '(:80->80/tcp|:443->443/tcp|:5060->30560/udp)'; then
    printf '%s\n' "$owners" >&2
    fail 'canonical native edge collision: historical k3d UTCP environment owns UDP/5060 or TCP/80/TCP/443'
  fi
}

require_registry() {
  load_image_lock
  [ -n "$SERVER_REGISTRY" ] || fail 'image lock has no UTCP_SERVER_IMAGE_REGISTRY'
  printf '%s' "$SERVER_REGISTRY" | grep -Eq '^[a-zA-Z0-9.-]+(:[0-9]+)?(/[a-zA-Z0-9._-]+)+$' || fail 'image lock registry must be a registry authority with an owner path'
  case "$SERVER_REGISTRY" in *utcp-local-registry*|127.0.0.1:5001|localhost:5001) fail 'the native registry must not be the k3d local registry';; esac
}

load_image_lock() {
  [ -r "$SERVER_IMAGE_LOCK" ] || fail "native image lock is not readable: $SERVER_IMAGE_LOCK"
  # The publication workflow writes a data-only shell environment file.
  # shellcheck disable=SC1090
  . "$SERVER_IMAGE_LOCK"
  SERVER_REGISTRY="${UTCP_SERVER_IMAGE_REGISTRY:-}"
}

require_image_lock() {
  require_registry
  printf '%s' "${UTCP_SERVER_IMAGE_TAG:-}" | grep -Eq '^sha-[0-9a-f]{40}$' || fail 'UTCP_SERVER_IMAGE_TAG must identify a full source commit'
  printf '%s' "${UTCP_SERVER_SOURCE_COMMIT:-}" | grep -Eq '^[0-9a-f]{40}$' || fail 'UTCP_SERVER_SOURCE_COMMIT must be a full source commit'
  for name in UTCP_SERVER_POSTGRES_IMAGE UTCP_SERVER_REDIS_IMAGE UTCP_SERVER_API_IMAGE UTCP_SERVER_WEB_IMAGE UTCP_SERVER_GATEWAY_IMAGE UTCP_SERVER_ASTERISK_IMAGE UTCP_SERVER_FREESWITCH_IMAGE UTCP_SERVER_RTPENGINE_IMAGE UTCP_SERVER_KAMAILIO_IMAGE; do
    value="${!name:-}"
    printf '%s' "$value" | grep -Eq '^[a-zA-Z0-9.-]+(/[a-zA-Z0-9._-]+)+@sha256:[0-9a-f]{64}$' || fail "$name must be an immutable image reference"
  done
}

ensure_target() {
  [ -r "$SERVER_KUBECONFIG" ] || fail "native kubeconfig is not readable: $SERVER_KUBECONFIG"
  require_canonical_identity
  server_kube config get-contexts "$SERVER_CONTEXT" >/dev/null 2>&1 || fail "native context is not present: $SERVER_CONTEXT"
  server_kube get node "$SERVER_NODE_NAME" -o jsonpath='{.metadata.name}' 2>/dev/null | grep -Fxq "$SERVER_NODE_NAME" || fail "validated native node is unavailable: $SERVER_NODE_NAME"
  ensure_no_historical_edge_collision
}

write_credentials() {
  mkdir -p "$SERVER_STATE_DIR"
  umask 077
  if [ ! -s "$SERVER_STATE_DIR/server-data-credentials.properties" ]; then
    db_password="$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')"
    {
      printf 'APP_KEY=%s\n' "$(generate_app_key)"
      printf 'DB_PASSWORD=%s\n' "$db_password"
      printf 'POSTGRES_DB=utcp\nPOSTGRES_USER=utcp\nPOSTGRES_PASSWORD=%s\n' "$db_password"
    } > "$SERVER_STATE_DIR/server-data-credentials.properties"
  elif ! valid_app_key_file "$SERVER_STATE_DIR/server-data-credentials.properties"; then
    replace_app_key "$SERVER_STATE_DIR/server-data-credentials.properties"
  fi
  if [ ! -s "$SERVER_STATE_DIR/server-kamailio-db-credentials.properties" ]; then
    {
      for role in AUTH USRLOC OBSERVER REGISTRATION; do
        case "$role" in AUTH) user=utcp_kamailio_auth_reader;; USRLOC) user=utcp_kamailio_usrloc_writer;; OBSERVER) user=utcp_kamailio_observer_reader;; REGISTRATION) user=utcp_kamailio_registration_reader;; esac
        printf 'KAMAILIO_%s_DB_USER=%s\nKAMAILIO_%s_DB_PASSWORD=' "$role" "$user" "$role"
        od -An -N24 -tx1 /dev/urandom | tr -d ' \n'; printf '\n'
      done
    } > "$SERVER_STATE_DIR/server-kamailio-db-credentials.properties"
  fi
  if [ ! -s "$SERVER_STATE_DIR/server-reverb-credentials.properties" ]; then
    {
      printf 'REVERB_APP_ID=utcp-server\nREVERB_APP_KEY='; od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; printf '\nREVERB_APP_SECRET='; od -An -N32 -tx1 /dev/urandom | tr -d ' \n'; printf '\n'
    } > "$SERVER_STATE_DIR/server-reverb-credentials.properties"
  fi
  if [ ! -s "$SERVER_STATE_DIR/server-asterisk-ari-credentials.properties" ]; then
    {
      printf 'ARI_USERNAME=utcp_ari\nARI_PASSWORD='
      od -An -N24 -tx1 /dev/urandom | tr -d ' \n'
      printf '\n'
    } > "$SERVER_STATE_DIR/server-asterisk-ari-credentials.properties"
  fi
}

generate_app_key() {
  # Laravel's base64: AES-256 key is the base64 encoding of exactly 32 bytes.
  printf 'base64:%s' "$(openssl rand -base64 32 | tr -d '\n')"
}

valid_app_key_file() {
  local credentials_file="$1" app_key encoded decoded_length
  app_key="$(awk -F= '$1 == "APP_KEY" {sub(/^[^=]*=/, ""); print; exit}' "$credentials_file")"
  case "$app_key" in base64:*) ;; *) return 1 ;; esac
  encoded="${app_key#base64:}"
  [ -n "$encoded" ] || return 1
  decoded_length="$(printf '%s' "$encoded" | base64 --decode 2>/dev/null | wc -c)"
  [ "$decoded_length" -eq 32 ]
}

replace_app_key() {
  local credentials_file="$1" temporary_file app_key replaced=0 line
  app_key="$(generate_app_key)"
  temporary_file="$(mktemp "${credentials_file}.XXXXXX")"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      APP_KEY=*)
        if [ "$replaced" -eq 0 ]; then
          printf 'APP_KEY=%s\n' "$app_key" >> "$temporary_file"
          replaced=1
        fi
        ;;
      *) printf '%s\n' "$line" >> "$temporary_file" ;;
    esac
  done < "$credentials_file"
  if [ "$replaced" -eq 0 ]; then printf 'APP_KEY=%s\n' "$app_key" >> "$temporary_file"; fi
  chmod 600 "$temporary_file"
  mv "$temporary_file" "$credentials_file"
}

render_server() {
  require_image_lock
  provider_advertise="$(provider_sip_advertise)"
  write_credentials
  render_root="$(mktemp -d)"
  render_dir="$render_root/infrastructure/kubernetes/overlays/server"
  mkdir -p "$render_dir"
  cp -R "$ROOT/infrastructure/kubernetes"/. "$render_root/infrastructure/kubernetes/"
  provider_config="$render_root/infrastructure/kubernetes/base/platform/kamailio-configmap.yaml"
  escaped_provider_advertise="$(printf '%s' "$provider_advertise" | sed 's/[&|]/\\&/g')"
  sed -i "s|advertise kamailio-sip-external.utcp-platform.svc.cluster.local:5060 name|advertise $escaped_provider_advertise name|" "$provider_config"
  provider_config_checksum="$(python3 - "$provider_config" <<'PY'
import hashlib
import sys
import yaml

with open(sys.argv[1], encoding="utf-8") as stream:
    document = yaml.safe_load(stream)
print(hashlib.sha256(document["data"]["kamailio.cfg"].encode("utf-8")).hexdigest())
PY
)"
  sed -i "s|utcp.io/kamailio-config-sha256: [0-9a-f]*|utcp.io/kamailio-config-sha256: $provider_config_checksum|" "$render_root/infrastructure/kubernetes/base/platform/kamailio-deployment.yaml"
  render_kustomization "$render_dir/kustomization.yaml"
  sed -e "s#__UTCP_ASTERISK_IMAGE__#$UTCP_SERVER_ASTERISK_IMAGE#g" -e "s#__UTCP_FREESWITCH_IMAGE__#$UTCP_SERVER_FREESWITCH_IMAGE#g" "$SERVER_OVERLAY/application-config.properties.in" > "$render_dir/application-config.properties"
  cp "$SERVER_STATE_DIR/server-data-credentials.properties" "$render_dir/server-data-credentials.properties"
  cp "$SERVER_STATE_DIR/server-kamailio-db-credentials.properties" "$render_dir/server-kamailio-db-credentials.properties"
  cp "$SERVER_STATE_DIR/server-reverb-credentials.properties" "$render_dir/server-reverb-credentials.properties"
  cp "$SERVER_STATE_DIR/server-asterisk-ari-credentials.properties" "$render_dir/server-asterisk-ari-credentials.properties"
  kubectl kustomize "$render_dir"
  rm -rf "$render_root"
}

image_name() { printf '%s' "${1%@*}"; }
image_digest() { printf '%s' "${1#*@}"; }

render_kustomization() {
  local output="$1"
  sed \
    -e "s#__UTCP_API_IMAGE_NAME__#$(image_name "$UTCP_SERVER_API_IMAGE")#g" -e "s#__UTCP_API_DIGEST__#$(image_digest "$UTCP_SERVER_API_IMAGE")#g" \
    -e "s#__UTCP_POSTGRES_IMAGE_NAME__#$(image_name "$UTCP_SERVER_POSTGRES_IMAGE")#g" -e "s#__UTCP_POSTGRES_DIGEST__#$(image_digest "$UTCP_SERVER_POSTGRES_IMAGE")#g" \
    -e "s#__UTCP_REDIS_IMAGE_NAME__#$(image_name "$UTCP_SERVER_REDIS_IMAGE")#g" -e "s#__UTCP_REDIS_DIGEST__#$(image_digest "$UTCP_SERVER_REDIS_IMAGE")#g" \
    -e "s#__UTCP_WEB_IMAGE_NAME__#$(image_name "$UTCP_SERVER_WEB_IMAGE")#g" -e "s#__UTCP_WEB_DIGEST__#$(image_digest "$UTCP_SERVER_WEB_IMAGE")#g" \
    -e "s#__UTCP_GATEWAY_IMAGE_NAME__#$(image_name "$UTCP_SERVER_GATEWAY_IMAGE")#g" -e "s#__UTCP_GATEWAY_DIGEST__#$(image_digest "$UTCP_SERVER_GATEWAY_IMAGE")#g" \
    -e "s#__UTCP_ASTERISK_IMAGE_NAME__#$(image_name "$UTCP_SERVER_ASTERISK_IMAGE")#g" -e "s#__UTCP_ASTERISK_DIGEST__#$(image_digest "$UTCP_SERVER_ASTERISK_IMAGE")#g" \
    -e "s#__UTCP_FREESWITCH_IMAGE_NAME__#$(image_name "$UTCP_SERVER_FREESWITCH_IMAGE")#g" -e "s#__UTCP_FREESWITCH_DIGEST__#$(image_digest "$UTCP_SERVER_FREESWITCH_IMAGE")#g" \
    -e "s#__UTCP_RTPENGINE_IMAGE_NAME__#$(image_name "$UTCP_SERVER_RTPENGINE_IMAGE")#g" -e "s#__UTCP_RTPENGINE_DIGEST__#$(image_digest "$UTCP_SERVER_RTPENGINE_IMAGE")#g" \
    -e "s#__UTCP_KAMAILIO_IMAGE_NAME__#$(image_name "$UTCP_SERVER_KAMAILIO_IMAGE")#g" -e "s#__UTCP_KAMAILIO_DIGEST__#$(image_digest "$UTCP_SERVER_KAMAILIO_IMAGE")#g" \
    "$SERVER_OVERLAY/kustomization.yaml" > "$output"
}

wait_data() {
  server_kube -n "$SERVER_NAMESPACE_DATA" rollout status statefulset/postgres --timeout=240s
  server_kube -n "$SERVER_NAMESPACE_DATA" rollout status statefulset/redis --timeout=180s
}

wait_platform() {
  for deployment in api gateway web worker scheduler reverb; do server_kube -n "$SERVER_NAMESPACE_PLATFORM" rollout status "deployment/$deployment" --timeout=240s; done
}

port_forward_gateway() {
  server_kube -n "$SERVER_NAMESPACE_PLATFORM" port-forward --address 127.0.0.1 service/gateway "$SERVER_PROOF_PORT:8080"
}
