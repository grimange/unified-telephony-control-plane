#!/usr/bin/env bash
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"
ensure_target
"$SCRIPT_DIR/image-preflight"
"$SCRIPT_DIR/config-check" >/dev/null
manifest="$(mktemp)"
trap 'rm -f "$manifest"' EXIT
render_server > "$manifest"
server_kube apply -f "$manifest" >/dev/null
wait_data
server_kube -n "$SERVER_NAMESPACE_PLATFORM" delete job utcp-migrate --ignore-not-found >/dev/null
server_kube -n "$SERVER_NAMESPACE_PLATFORM" apply -f "$manifest" >/dev/null
server_kube -n "$SERVER_NAMESPACE_PLATFORM" wait --for=condition=Complete job/utcp-migrate --timeout=240s
wait_platform
server_kube -n "$SERVER_NAMESPACE_PLATFORM" get deployment api web gateway worker scheduler -o wide
printf 'native k3s platform applied\n'
