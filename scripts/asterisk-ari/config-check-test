#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TARGET="$ROOT/apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php"
TMP="$(mktemp -d)"
trap 'cp "$TMP/client.php" "$TARGET"; rm -rf "$TMP"' EXIT
cp "$TARGET" "$TMP/client.php"

printf '%s\n' '        // obsolete: variables[__UTCP_CALL_LEG_ID]' >> "$TARGET"
if make asterisk-ari-config-check >"$TMP/out" 2>"$TMP/err"; then
  printf 'ARI query-variable mutation unexpectedly passed\n' >&2
  exit 1
fi
grep -Fq 'must not be encoded as query parameters' "$TMP/err" || { cat "$TMP/err" >&2; exit 1; }
cp "$TMP/client.php" "$TARGET"

missing_path='/nonexistent'
if PATH="$missing_path" /usr/bin/bash "$ROOT/scripts/asterisk-ari/config-check" >"$TMP/out" 2>"$TMP/err"; then
  printf 'ARI guard unexpectedly passed without rg\n' >&2
  exit 1
fi
grep -Fq 'required tool missing: rg' "$TMP/err" || { cat "$TMP/err" >&2; exit 1; }

printf 'Asterisk ARI guard mutation and missing-rg tests passed\n'
