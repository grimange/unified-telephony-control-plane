#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ASTERISK_IMAGE="${ASTERISK_ARI_IMAGE:-utcp-asterisk-ari:dev}"
PEER_IMAGE="${EXTERNAL_SIP_PEER_IMAGE:-utcp-external-sip-peer:dev}"
suffix="$(printf '%s' "${BASHPID}-$(date +%s%N)" | sha256sum | cut -c1-12)"
network="utcp-caller-identity-${suffix}"
asterisk="utcp-caller-identity-asterisk-${suffix}"
peer="utcp-caller-identity-peer-${suffix}"
tmp="$(mktemp -d)"
failure=0

cleanup() {
  local rc=$?
  if [ "$rc" -ne 0 ] || [ "$failure" -ne 0 ]; then
    printf '%s\n' 'caller_identity_semantics=diagnostic' >&2
    docker inspect -f 'name={{.Name}} status={{.State.Status}} exit={{.State.ExitCode}}' "$asterisk" "$peer" 2>&1 || true
    printf '%s\n' '--- synthetic peer logs ---' >&2
    docker logs "$peer" 2>&1 | tail -120 || true
    printf '%s\n' '--- asterisk logs ---' >&2
    docker logs "$asterisk" 2>&1 | tail -160 || true
  fi
  if [ -n "${stasis_listener_pid:-}" ]; then
    kill "$stasis_listener_pid" >/dev/null 2>&1 || true
  fi
  if [ -n "${asterisk:-}" ]; then
    docker exec "$asterisk" pkill -f utcp-t0-observation >/dev/null 2>&1 || true
  fi
  docker rm -f "$asterisk" "$peer" >/dev/null 2>&1 || true
  docker network rm "$network" >/dev/null 2>&1 || true
  rm -rf "$tmp"
  exit "$rc"
}
trap cleanup EXIT

fail() {
  failure=1
  printf 'caller identity semantic test failed: %s\n' "$1" >&2
  exit 1
}

command -v docker >/dev/null 2>&1 || fail 'docker is required'
docker image inspect "$ASTERISK_IMAGE" >/dev/null 2>&1 || fail "missing Asterisk image: $ASTERISK_IMAGE"
docker image inspect "$PEER_IMAGE" >/dev/null 2>&1 || fail "missing peer image: $PEER_IMAGE"

docker network create --subnet 172.31.0.0/24 "$network" >/dev/null
docker run -d --name "$peer" --network "$network" --ip 172.31.0.2 \
  -e EXTERNAL_SIP_PEER_USERNAME=utcp-v1 \
  -e EXTERNAL_SIP_PEER_PASSWORD=utcp-synthetic-secret \
  -e UTCP_SIGNALING_IP=172.31.0.3 \
  "$PEER_IMAGE" >/dev/null

peer_ready=0
for attempt in $(seq 1 30); do
  if timeout 5 docker exec "$peer" /usr/local/bin/external-sip-peer-readiness >/dev/null 2>&1; then
    peer_ready=1
    break
  fi
  sleep 1
done
[ "$peer_ready" -eq 1 ] || fail 'synthetic peer did not become ready'

cp "$ROOT/infrastructure/docker/asterisk/config/pjsip.conf" "$tmp/pjsip.conf"
sed -i "s#kamailio-sip-internal\.utcp-platform\.svc\.cluster\.local:5060#${peer}:5060#g" "$tmp/pjsip.conf"

docker run -d --name "$asterisk" --network "$network" --ip 172.31.0.3 \
  -p 127.0.0.1::8088 \
  -e ARI_USERNAME=utcp-ari \
  -e ARI_PASSWORD=utcp-ari-secret \
  -v "$tmp/pjsip.conf:/opt/utcp-asterisk-local-config/pjsip.conf:ro" \
  "$ASTERISK_IMAGE" >/dev/null

asterisk_ready=0
for attempt in $(seq 1 45); do
  if timeout 35 docker exec "$asterisk" /usr/local/bin/utcp-asterisk-readiness >/dev/null 2>&1; then
    asterisk_ready=1
    break
  fi
  state="$(docker inspect -f '{{.State.Status}}' "$asterisk" 2>/dev/null || true)"
  [ "$state" = exited ] || [ "$state" = dead ] && break || true
  sleep 1
done
[ "$asterisk_ready" -eq 1 ] || fail 'Asterisk did not become ready'

docker exec "$peer" asterisk -rx 'pjsip set logger on' >/dev/null
host_port="$(docker port "$asterisk" 8088/tcp | sed -n 's/.*:\([0-9][0-9]*\)$/\1/p')"
[ -n "$host_port" ] || fail 'Asterisk ARI port was not published'
asterisk_cli() {
  docker exec "$asterisk" asterisk -C /tmp/utcp-asterisk/asterisk.conf -rx "$1"
}

# Register the repository-owned Stasis application through the same ARI event
# WebSocket contract used by the managed listener. Without an active
# subscription Asterisk correctly rejects an app= originate as unowned.
ws_auth="$(printf '%s' 'utcp-ari:utcp-ari-secret' | base64 -w0)"
docker exec -d "$asterisk" sh -c 'python3 -c '\''import base64,json,socket,time
host="127.0.0.1"; port=8088
s=socket.create_connection((host,port),10)
key=base64.b64encode(b"utcp-semantic-ws-key").decode()
request=("GET /ari/events?app=utcp-t0-observation&subscribeAll=true HTTP/1.1\r\n"
         "Host: 127.0.0.1:8088\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
         "Sec-WebSocket-Key: "+key+"\r\nSec-WebSocket-Version: 13\r\n"
         "Authorization: Basic '"$ws_auth"'\r\n\r\n")
s.sendall(request.encode())
response=b""
while b"\r\n\r\n" not in response:
 response += s.recv(4096)
if b" 101 " not in response.split(b"\r\n",1)[0]:
 raise SystemExit("ARI WebSocket registration failed: "+response.decode(errors="replace"))
s.settimeout(None)
events=open("/tmp/utcp-recording-events.jsonl","a", buffering=1)
def receive(n):
 data=b""
 while len(data)<n:
  part=s.recv(n-len(data))
  if not part: raise EOFError
  data += part
 return data
def send_frame(op,payload=b""):
 header=bytes([0x80|op])
 n=len(payload)
 if n < 126: header += bytes([n])
 elif n < 65536: header += bytes([126])+n.to_bytes(2,"big")
 else: header += bytes([127])+n.to_bytes(8,"big")
 s.sendall(header+payload)
while True:
 first=receive(2); opcode=first[0] & 0x0f; length=first[1] & 0x7f
 if length == 126: length=int.from_bytes(receive(2),"big")
 elif length == 127: length=int.from_bytes(receive(8),"big")
 payload=receive(length) if length else b""
 if opcode == 9: send_frame(10,payload)
 elif opcode == 8: break
 elif opcode == 1:
  try:
   event=json.loads(payload.decode())
   if event.get("type") in ("RecordingStarted","RecordingFinished","RecordingFailed"):
    recording=event.get("recording") or {}
    events.write(json.dumps({"observed_at":time.time(),"type":event.get("type"),"recording_name":recording.get("name"),"recording_format":recording.get("format"),"recording_state":recording.get("state"),"cause":event.get("cause"),"reason":event.get("reason")})+"\n")
  except (ValueError,UnicodeDecodeError): pass
'\'' >"/tmp/utcp-stasis-listener.log" 2>&1'
stasis_listener_pid=''
stasis_registered=0
for attempt in $(seq 1 20); do
  app_status="$(curl -sS -o /dev/null -w '%{http_code}' --user utcp-ari:utcp-ari-secret \
    "http://127.0.0.1:${host_port}/ari/applications/utcp-t0-observation" || true)"
  if [ "$app_status" = 200 ]; then
    stasis_registered=1
    break
  fi
  sleep 1
done
[ "$stasis_registered" -eq 1 ] || fail 'canonical ARI Stasis application did not register'
docker exec "$asterisk" test -f /tmp/utcp-recording-events.jsonl || fail 'ARI lifecycle listener did not initialize its event capture file'

body='{"variables":{"__UTCP_CALL_LEG_ID":"leg-semantic","__UTCP_ROUTE_DECISION_ID":"route-semantic","__UTCP_TRUNK_ENDPOINT_ID":"endpoint-semantic","__UTCP_CALLER_IDENTITY_ID":"caller-semantic"}}'
response="$tmp/ari-response"
channel_pattern='Local/97001@utcp-outbound[^";]*;1'
endpoint_query='Local%2F97001%40utcp-outbound'
if [ "${UTCP_ASTERISK_RECORDING_RUNTIME_SMOKE:-0}" = 1 ]; then
  # The provider smoke records a directly Stasis-owned PJSIP channel so the
  # test exercises a real media-bearing channel, while the default semantic
  # test continues to cover the canonical Local-channel control landing.
  endpoint_query="PJSIP%2Fanonymous%2Fsip%3A97001%40${peer}%3A5060"
  channel_pattern='PJSIP/anonymous[^";]*'
fi
ari_url="http://127.0.0.1:${host_port}/ari/channels?endpoint=${endpoint_query}&app=utcp-t0-observation&timeout=30&formats=ulaw&callerId=utcp-v1%20%3Cutcp-v1%3E&channelId=caller-identity-semantic"
http_code="$(curl -sS -o "$response" -w '%{http_code}' --user utcp-ari:utcp-ari-secret \
  -H 'Content-Type: application/json' --data-binary "$body" "$ari_url")"
[ "$http_code" = 200 ] || fail "ARI originate failed: http=${http_code} response=$(tr '\n' ' ' < "$response")"

from_user=''
for attempt in $(seq 1 30); do
  logs="$(docker logs "$peer" 2>&1 || true)"
  if printf '%s\n' "$logs" | rg -q '^From: .*<sip:utcp-v1@'; then
    from_user=utcp-v1
    break
  fi
  sleep 1
done
[ "$from_user" = utcp-v1 ] || fail 'synthetic peer did not observe From user utcp-v1'
invite_count="$(printf '%s\n' "$logs" | rg -c '^INVITE sip:' || true)"
[ "$invite_count" -eq 1 ] || fail "synthetic peer observed ${invite_count} provider INVITEs; expected exactly one"

answered=0
for attempt in $(seq 1 10); do
  logs="$(docker logs "$peer" 2>&1 || true)"
  if printf '%s\n' "$logs" | rg -q 'SIP/2.0 200 OK'; then
    answered=1
    break
  fi
  sleep 1
done
[ "$answered" -eq 1 ] || fail 'synthetic peer did not answer the single provider INVITE with 200 OK'

logs="$(docker logs "$peer" 2>&1 || true)"
invite_count="$(printf '%s\n' "$logs" | rg -c '^INVITE sip:' || true)"
[ "$invite_count" -eq 1 ] || fail "synthetic peer observed a duplicate provider INVITE after answer: count=${invite_count}"
if printf '%s\n' "$logs" | rg -q '^From: .*<sip:(anonymous|asterisk)@'; then
  fail 'synthetic peer observed an anonymous/default From user'
fi

local_control_half_valid=0
answered_channel_sustained=1
sustain_attempts=4
if [ "${UTCP_ASTERISK_RECORDING_RUNTIME_SMOKE:-0}" = 1 ]; then
  sustain_attempts=1
fi
for attempt in $(seq 1 "$sustain_attempts"); do
  channel_json="$(curl -sS --user utcp-ari:utcp-ari-secret \
    "http://127.0.0.1:${host_port}/ari/channels/caller-identity-semantic" 2>/dev/null || true)"
  if ! printf '%s\n' "$channel_json" | rg -q "\"name\"[[:space:]]*:[[:space:]]*\"${channel_pattern}"; then
    answered_channel_sustained=0
  fi
  if printf '%s\n' "$channel_json" | rg -q "\"name\"[[:space:]]*:[[:space:]]*\"${channel_pattern}"; then
    local_control_half_valid=1
  fi
  sleep 1
done
  [ "$local_control_half_valid" -eq 1 ] || fail "ARI channel did not remain in the expected control landing: ${channel_json:-no channel response}"
[ "$answered_channel_sustained" -eq 1 ] || fail 'answered Local pair was not sustained beyond the historical failure window'

asterisk_logs="$(docker logs "$asterisk" 2>&1 || true)"
if printf '%s\n' "$asterisk_logs" | rg -q 'No such extension/context|invalid extension|default,97001,1'; then
  fail 'Asterisk reported an invalid Local ;1 dialplan landing'
fi

if [ "${UTCP_ASTERISK_RECORDING_RUNTIME_SMOKE:-0}" = 1 ]; then
  # Echo() on the synthetic peer provides a deterministic media path. Send
  # PCMU RTP to the peer's answered SDP port; the peer echoes it back to the
  # originator, so the recorded channel has real inbound audio.
  rtp_target_port="$(printf '%s\n' "$logs" | awk 'BEGIN{ok=0} /^SIP\/2.0 200 OK/{ok=1} ok && /^m=audio[[:space:]]+[0-9]+/{print $2; exit}')"
  [[ "$rtp_target_port" =~ ^[0-9]+$ ]] || fail 'synthetic peer SDP did not expose its answered RTP port'
  rtp_source_port="$(printf '%s\n' "$logs" | awk '/^m=audio[[:space:]]+[0-9]+/{print $2; exit}')"
  [[ "$rtp_source_port" =~ ^[0-9]+$ ]] || fail 'originating INVITE SDP did not expose its RTP port'
  # Do not start recording until the ARI-owned channel has crossed the
  # provider answer boundary.  Asterisk can accept the record request while
  # the channel is still Down, but that transient state does not produce a
  # finalized channel-owned WAV artifact.
  channel_state=''
  for attempt in $(seq 1 15); do
    channel_json="$(curl -sS --user utcp-ari:utcp-ari-secret \
      "http://127.0.0.1:${host_port}/ari/channels/caller-identity-semantic" 2>/dev/null || true)"
    channel_state="$(printf '%s\n' "$channel_json" | sed -n 's/.*"state"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
    [ "$channel_state" = Up ] && break
    sleep 1
  done
  [ "$channel_state" = Up ] || fail "ARI recording smoke channel did not reach Up before recording: ${channel_json:-no channel response}"
  asterisk_cli 'rtp set debug on' >/dev/null 2>&1 || true
  docker exec -d -e RTP_TARGET_IP=172.31.0.2 -e RTP_TARGET_PORT="$rtp_target_port" \
    -e RTP_SOURCE_PORT="$rtp_source_port" \
    "$peer" /usr/local/bin/utcp-peer-rtp-sender >/dev/null
  sleep 1
  sender_pid="$(docker exec "$peer" pgrep -f utcp-peer-rtp-sender | head -1 || true)"
  [ -n "$sender_pid" ] || fail 'synthetic RTP sender did not remain active after launch'
  recording_name="utcp-recording-runtime-${suffix}"
  recording_response="$tmp/recording-start-response"
  recording_code="$(curl -sS -o "$recording_response" -w '%{http_code}' -X POST \
    --user utcp-ari:utcp-ari-secret \
    "http://127.0.0.1:${host_port}/ari/channels/caller-identity-semantic/record?name=${recording_name}&format=wav&ifExists=overwrite" || true)"
  case "$recording_code" in
    200|201) ;;
    *) fail "ARI recording start failed: http=${recording_code} response=$(tr '\n' ' ' < "$recording_response")" ;;
  esac
  grep -Fq '"name"' "$recording_response" || fail 'ARI recording start response did not contain a recording resource'
  rg -q '"format"[[:space:]]*:[[:space:]]*"wav"' "$recording_response" || fail "ARI recording start response did not report WAV format: $(tr '\n' ' ' < "$recording_response")"

  recording_started_at=''
  recording_event_deadline=$((SECONDS + 20))
  while [ "$SECONDS" -lt "$recording_event_deadline" ]; do
    matching_events="$(docker exec "$asterisk" cat /tmp/utcp-recording-events.jsonl 2>/dev/null | grep -F "\"recording_name\": \"${recording_name}\"" || true)"
    if printf '%s\n' "$matching_events" | rg -q '"type"[[:space:]]*:[[:space:]]*"RecordingFailed"'; then
      failed_event="$(printf '%s\n' "$matching_events" | rg '"type"[[:space:]]*:[[:space:]]*"RecordingFailed"' | tail -1)"
      fail "provider emitted RecordingFailed for ${recording_name}: ${failed_event}"
    fi
    started_event="$(printf '%s\n' "$matching_events" | rg '"type"[[:space:]]*:[[:space:]]*"RecordingStarted"' | tail -1 || true)"
    if [ -n "$started_event" ]; then
      recording_started_at="$(printf '%s\n' "$started_event" | sed -n 's/.*"observed_at"[[:space:]]*:[[:space:]]*\([0-9.]*\).*/\1/p')"
      break
    fi
    sleep 0.2
  done
  [ -n "$recording_started_at" ] || fail "matching RecordingStarted event was not observed for ${recording_name} before 20s deadline; captured_events=$(docker exec "$asterisk" sh -c 'tail -20 /tmp/utcp-recording-events.jsonl 2>/dev/null || true' | tr '\n' ' ') listener=$(docker exec "$asterisk" sh -c 'tail -5 /tmp/utcp-stasis-listener.log 2>/dev/null || true' | tr '\n' ' ')"

  live_code=0
  for attempt in $(seq 1 10); do
    live_code="$(curl -sS -o "$tmp/live-recording-response" -w '%{http_code}' \
      --user utcp-ari:utcp-ari-secret \
      "http://127.0.0.1:${host_port}/ari/recordings/live/${recording_name}" || true)"
    [ "$live_code" = 200 ] && break
    sleep 1
  done
  [ "$live_code" = 200 ] || fail "live recording was not observable: http=${live_code}"

  # Keep the provider recording live long enough for the deterministic RTP
  # stream to be consumed and flushed before stopping it.
  sleep "${UTCP_RECORDING_RUNTIME_HOLD_SECONDS:-3}"

  stop_code="$(curl -sS -o "$tmp/recording-stop-response" -w '%{http_code}' -X DELETE \
    --user utcp-ari:utcp-ari-secret \
    "http://127.0.0.1:${host_port}/ari/recordings/live/${recording_name}" || true)"
  [ "$stop_code" = 204 ] || fail "ARI recording stop failed: http=${stop_code} response=$(tr '\n' ' ' < "$tmp/recording-stop-response")"

  stop_204_at="$(date +%s.%3N)"
  artifact="/var/spool/asterisk/recording/${recording_name}.wav"
  recording_finished_at=''
  stored_visible_at=''
  filesystem_visible_at=''
  finalization_deadline=$((SECONDS + 30))
  while [ "$SECONDS" -lt "$finalization_deadline" ]; do
    matching_events="$(docker exec "$asterisk" cat /tmp/utcp-recording-events.jsonl 2>/dev/null | grep -F "\"recording_name\": \"${recording_name}\"" || true)"
    if printf '%s\n' "$matching_events" | rg -q '"type"[[:space:]]*:[[:space:]]*"RecordingFailed"'; then
      failed_event="$(printf '%s\n' "$matching_events" | rg '"type"[[:space:]]*:[[:space:]]*"RecordingFailed"' | tail -1)"
      fail "provider emitted RecordingFailed after stop for ${recording_name}: ${failed_event}"
    fi
    finished_event="$(printf '%s\n' "$matching_events" | rg '"type"[[:space:]]*:[[:space:]]*"RecordingFinished"' | tail -1 || true)"
    if [ -n "$finished_event" ] && [ -z "$recording_finished_at" ]; then
      recording_finished_at="$(printf '%s\n' "$finished_event" | sed -n 's/.*"observed_at"[[:space:]]*:[[:space:]]*\([0-9.]*\).*/\1/p')"
    fi
    live_code="$(curl -sS -o "$tmp/live-recording-response" -w '%{http_code}' \
      --user utcp-ari:utcp-ari-secret \
      "http://127.0.0.1:${host_port}/ari/recordings/live/${recording_name}" || true)"
    stored_code="$(curl -sS -o "$tmp/stored-recording-response" -w '%{http_code}' \
      --user utcp-ari:utcp-ari-secret \
      "http://127.0.0.1:${host_port}/ari/recordings/stored/${recording_name}" || true)"
    [ "$stored_code" = 200 ] && [ -z "$stored_visible_at" ] && stored_visible_at="$(date +%s.%3N)"
    if docker exec "$asterisk" sh -c "test -f '$artifact' && test -s '$artifact'" >/dev/null 2>&1; then
      [ -n "$filesystem_visible_at" ] || filesystem_visible_at="$(date +%s.%3N)"
    fi
    if [ -n "$recording_finished_at" ] && [ "$live_code" != 200 ] && [ "$stored_code" = 200 ] && [ -n "$filesystem_visible_at" ]; then
      break
    fi
    sleep 0.2
  done
  [ -n "$recording_finished_at" ] || fail "stop accepted (204) but matching RecordingFinished timed out after 30s for ${recording_name}; live_http=${live_code}"
  [ "$live_code" != 200 ] || fail "matching RecordingFinished arrived but live recording remained active: ${recording_name}"
  if [ "$stored_code" != 200 ]; then
    artifact_listing="$(docker exec "$asterisk" sh -c "find /var/spool/asterisk -maxdepth 4 -type f -name '${recording_name}*' -ls 2>/dev/null || true" 2>&1 || true)"
    recording_dir_listing="$(docker exec "$asterisk" sh -c 'ls -la /var/spool/asterisk/recording 2>&1 || true' 2>&1 || true)"
    channel_stats="$(asterisk_cli 'core show channels verbose' 2>&1 || true)"
    rtp_debug="$(docker logs "$asterisk" 2>&1 | rg -i 'RTP|strict RTP|record|no audio' | tail -80 || true)"
    fail "matching RecordingFinished arrived but stored recording remained unavailable: recording=${recording_name} started_at=${recording_started_at} stop_204_at=${stop_204_at} finished_at=${recording_finished_at} live_http=${live_code} stored_http=${stored_code} stored_body=$(tr '\n' ' ' < "$tmp/stored-recording-response" 2>/dev/null || true) finished_event=${finished_event} artifact=${artifact} artifact_listing=${artifact_listing} recording_dir=${recording_dir_listing} channels=${channel_stats} rtp=${rtp_debug}"
  fi
  rg -q '"name"[[:space:]]*:[[:space:]]*"'"$recording_name"'"' "$tmp/stored-recording-response" || fail "stored recording returned the wrong name: $(tr '\n' ' ' < "$tmp/stored-recording-response")"
  rg -q '"format"[[:space:]]*:[[:space:]]*"wav"' "$tmp/stored-recording-response" || fail "stored recording did not report WAV: $(tr '\n' ' ' < "$tmp/stored-recording-response")"
  stored_file_code="$(curl -sS -o "$tmp/stored-recording-file" -w '%{http_code}' \
    --user utcp-ari:utcp-ari-secret \
    "http://127.0.0.1:${host_port}/ari/recordings/stored/${recording_name}/file" || true)"
  [ "$stored_file_code" = 200 ] || fail "stored recording file endpoint failed: http=${stored_file_code}"
  [ -n "$filesystem_visible_at" ] || fail "stored recording and RecordingFinished were observed but filesystem WAV was not visible before 30s: ${artifact}"
  artifact_size="$(docker exec "$asterisk" sh -c "stat -c '%s' '$artifact'" 2>/dev/null || true)"
  docker exec "$asterisk" sh -c "test -f '$artifact' && test -s '$artifact'" >/dev/null 2>&1 || fail "filesystem WAV was not a non-empty regular file: ${artifact} size=${artifact_size}"
  printf 'asterisk_recording_runtime=pass recording_name=%s started_event=%s finished_event=%s stop_204_at=%s stored_visible_at=%s filesystem_visible_at=%s artifact=%s artifact_bytes=%s stored_file_http=%s\n' \
    "$recording_name" "$started_event" "$finished_event" "$stop_204_at" "$stored_visible_at" "$filesystem_visible_at" "$artifact" "$artifact_size" "$stored_file_code"
  cleanup_recording_code="$(curl -sS -o /dev/null -w '%{http_code}' -X DELETE \
    --user utcp-ari:utcp-ari-secret \
    "http://127.0.0.1:${host_port}/ari/recordings/stored/${recording_name}" || true)"
  [ "$cleanup_recording_code" = 204 ] || [ "$cleanup_recording_code" = 404 ] || fail "stored recording cleanup failed: http=${cleanup_recording_code}"
  ! docker exec "$asterisk" sh -c "test -e '$artifact'" >/dev/null 2>&1 || fail "stored recording cleanup left filesystem artifact: ${artifact}"
  printf 'asterisk_recording_runtime_cleanup=pass recording_name=%s cleanup_http=%s\n' "$recording_name" "$cleanup_recording_code"
fi

delete_code="$(curl -sS -o /dev/null -w '%{http_code}' -X DELETE --user utcp-ari:utcp-ari-secret \
  "http://127.0.0.1:${host_port}/ari/channels/caller-identity-semantic" || true)"
[ "$delete_code" = 204 ] || [ "$delete_code" = 404 ] || fail "ARI teardown failed: http=${delete_code}"
for attempt in $(seq 1 10); do
  channels="$(asterisk_cli 'core show channels concise' 2>/dev/null || true)"
  if ! printf '%s\n' "$channels" | rg -q 'Local/97001@utcp-outbound'; then
    break
  fi
  sleep 1
done
if printf '%s\n' "$channels" | rg -q 'Local/97001@utcp-outbound|PJSIP/'; then
  fail 'normal teardown left an Asterisk Local or provider channel behind'
fi

printf 'asterisk_caller_identity_runtime_semantics=pass from_user=%s provider_invites=%s provider_answer=200 local_control_half_valid=true answered_channel_sustained=true\n' "$from_user" "$invite_count"
