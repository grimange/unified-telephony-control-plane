#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

fail() {
  printf 'asterisk ari config check failed: %s\n' "$1" >&2
  exit 1
}

command -v rg >/dev/null 2>&1 || fail "required tool missing: rg"

check_kustomize_forbidden() {
  local path="$1"
  local pattern="$2"
  local message="$3"
  local rendered
  rendered="$(mktemp)"
  if ! kubectl kustomize "$path" >"$rendered"; then
    rm -f "$rendered"
    fail "could not render Kubernetes manifests: $path"
  fi
  if rg -n "$pattern" "$rendered"; then
    rm -f "$rendered"
    fail "$message"
  fi
  rm -f "$rendered"
}

for file in \
  apps/api/config/asterisk_ari.php \
  apps/api/database/migrations/2026_07_15_150000_create_runtime_listener_leases.php \
  apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php \
  apps/api/app/RuntimeAdapters/Asterisk/AsteriskRuntimeAdapter.php \
  apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriEventListener.php \
  apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriEventNormalizer.php \
  apps/api/app/RuntimeAdapters/Asterisk/AsteriskRuntimeNodeReconciler.php \
  apps/api/app/RuntimeEngine/Commands/GenericRuntimeNodeInspectHandler.php \
  apps/api/app/RuntimeEngine/Listeners/RuntimeListenerLeaseRepository.php \
  infrastructure/docker/asterisk/Dockerfile \
  infrastructure/docker/asterisk/readiness \
  infrastructure/docker/asterisk/config/asterisk.conf \
  infrastructure/docker/asterisk/config/modules.conf \
  infrastructure/kubernetes/components/asterisk-sip-fixtures/extensions.local.conf \
  infrastructure/kubernetes/components/asterisk-instance/kustomization.yaml \
  infrastructure/kubernetes/overlays/local-two-asterisk/kustomization.yaml \
  infrastructure/kubernetes/base/platform/asterisk-ari-events-deployment.yaml \
  infrastructure/kubernetes/base/runtime/asterisk-ari-deployment.yaml \
  infrastructure/kubernetes/base/runtime/asterisk-ari-service.yaml \
  infrastructure/runtime-nodes/asterisk-ari/local-asterisk-ari-a.registration.json \
  infrastructure/runtime-nodes/asterisk-ari/local-asterisk-ari-b.registration.json \
  scripts/asterisk-ari/validate-ab-topology \
  infrastructure/kubernetes/security/platform/allow-asterisk-ari-events.yaml \
  infrastructure/kubernetes/security/platform/allow-asterisk-ari-egress.yaml \
  infrastructure/kubernetes/security/runtime/allow-asterisk-ari-ingress.yaml \
  infrastructure/kubernetes/observability/alerts/utcp-alerts.yaml
do
  [ -s "$file" ] || fail "missing required T0 file: $file"
done

grep -Fq '/var/lib/asterisk/sounds/reference-tone.wav' infrastructure/docker/asterisk/Dockerfile || fail "validation playback asset is not projected into Asterisk"
grep -Fq '/var/lib/asterisk/sounds/en/reference-tone.wav' infrastructure/docker/asterisk/Dockerfile || fail "validation playback asset is not available in the default language directory"
grep -Fq 'mkdir -p /var/spool/asterisk/recording' infrastructure/docker/asterisk/Dockerfile || fail "Asterisk recording spool directory is not provisioned in the image"
grep -Fq 'chown -R asterisk:asterisk /opt/utcp-asterisk-config /var/lib/asterisk/sounds /var/spool/asterisk/recording' infrastructure/docker/asterisk/Dockerfile || fail "Asterisk recording spool ownership is not provisioned"
grep -Fq 'chmod 0750 /var/spool/asterisk/recording' infrastructure/docker/asterisk/Dockerfile || fail "Asterisk recording spool permissions are not bounded"
grep -Fq 'RECORDING_DIR=' infrastructure/docker/asterisk/readiness || fail "Asterisk readiness does not validate recording spool capability"
grep -Fq 'recording_directory_write_failed' infrastructure/docker/asterisk/readiness || fail "Asterisk readiness does not prove runtime-user recording writability"
grep -Fq 'core show file formats' infrastructure/docker/asterisk/readiness || fail "Asterisk readiness does not validate registered recording formats"
grep -Fq 'wav_format_unavailable' infrastructure/docker/asterisk/readiness || fail "Asterisk readiness does not require WAV capability"
for module in res_stasis_recording.so res_ari_recordings.so format_wav.so; do
  [ "$(grep -Fc "load = $module" infrastructure/docker/asterisk/config/modules.conf)" -eq 1 ] || fail "required recording module load contract is missing: $module"
done
[ -x scripts/asterisk-ari/recording-runtime-test ] || fail "provider-native recording runtime smoke is missing"
recording_smoke_normalized="$(tr -d '[:space:]' < scripts/asterisk-ari/caller-identity-semantics-test)"
printf '%s' "$recording_smoke_normalized" | grep -Fq -- 'http://127.0.0.1:${host_port}/ari/recordings/live/${recording_name}/stop' || fail "provider recording smoke must use the store-preserving live-recording stop operation"
if printf '%s' "$recording_smoke_normalized" | grep -Fq -- '-XDELETE--userutcp-ari:utcp-ari-secret"http://127.0.0.1:${host_port}/ari/recordings/live/${recording_name}"'; then
  fail "provider recording smoke must not use the discarding live-recording DELETE operation"
fi

grep -q '^exten => c6-generic-proof,1,' infrastructure/kubernetes/components/asterisk-sip-fixtures/extensions.local.conf || fail "missing C6 generic inbound proof destination"
grep -q 'Stasis(utcp-t0-observation,c6-generic-proof)' infrastructure/kubernetes/components/asterisk-sip-fixtures/extensions.local.conf || fail "C6 generic proof destination must enter the existing Stasis application"
if grep -A4 -q '^exten => c6-generic-proof,1,.*Echo' infrastructure/kubernetes/components/asterisk-sip-fixtures/extensions.local.conf; then
  fail "C6 generic proof destination must not use the T3 Echo fixture"
fi

grep -Fq 'exten => _utcp-in-.,1,' infrastructure/docker/asterisk/config/extensions.conf || fail "canonical inbound Asterisk destination is missing"
grep -Fq 'EXTEN:8' infrastructure/docker/asterisk/config/extensions.conf || fail "canonical inbound Asterisk destination must validate the UUID token"
grep -Fq 'PJSIP_HEADER(read,X-UTCP-Ingress-External-Trunk-ID)' infrastructure/docker/asterisk/config/extensions.conf || fail "Asterisk inbound trunk correlation is missing"
grep -Fq 'PJSIP_HEADER(read,X-UTCP-Ingress-Telephony-Address-ID)' infrastructure/docker/asterisk/config/extensions.conf || fail "Asterisk inbound address correlation is missing"
grep -Fq 'PJSIP_HEADER(read,X-UTCP-Ingress-Trunk-Endpoint-ID)' infrastructure/docker/asterisk/config/extensions.conf || fail "Asterisk inbound endpoint correlation is missing"
grep -Fq 'PJSIP_HEADER(read,X-UTCP-Ingress-Runtime-Node-ID)' infrastructure/docker/asterisk/config/extensions.conf || fail "Asterisk inbound runtime correlation is missing"
grep -Fq 'Stasis(utcp-t0-observation,${EXTEN},${UTCP_INGRESS_EXTERNAL_TRUNK_ID}' infrastructure/docker/asterisk/config/extensions.conf || fail "Asterisk inbound destination must enter the observation path with correlation"
grep -Fq 'same => n,Answer()' infrastructure/docker/asterisk/config/extensions.conf || fail "Asterisk inbound destination must answer"

php_files=(
  $(find apps/api/app/RuntimeAdapters/Asterisk -name '*.php' -print)
  apps/api/app/RuntimeEngine/Commands/GenericRuntimeNodeInspectHandler.php
  apps/api/app/RuntimeEngine/Listeners/RuntimeListenerLeaseRepository.php
  apps/api/config/asterisk_ari.php
  apps/api/routes/console.php
)
if command -v php >/dev/null 2>&1; then
  for php_file in "${php_files[@]}"; do
    php -l "$php_file" >/dev/null
  done
elif command -v docker >/dev/null 2>&1 && docker image inspect utcp-api:dev-test >/dev/null 2>&1; then
  docker run --rm --entrypoint /bin/sh -v "$ROOT:/workspace:ro" -w /workspace utcp-api:dev-test \
    -c 'for php_file in "$@"; do php -l "$php_file" >/dev/null || exit 1; done' lint "${php_files[@]}"
else
  fail "PHP syntax validation requires host php or the canonical utcp-api:dev-test image"
fi

max_events_per_cycle="$(sed -n "s/^[[:space:]]*'max_events_per_cycle'[[:space:]]*=>[[:space:]]*\\([0-9][0-9]*\\),[[:space:]]*$/\\1/p" apps/api/config/asterisk_ari.php)"
[ -n "$max_events_per_cycle" ] || fail "missing deterministic ARI max_events_per_cycle configuration"
[ "$max_events_per_cycle" -ge 1 ] && [ "$max_events_per_cycle" -le 1000 ] || fail "ARI max_events_per_cycle must be positive and bounded"
grep -q "maxEventsPerCycle" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriEventListener.php || fail "listener does not use the configured per-cycle drain cap"
grep -q "readWebSocketMessage" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriEventListener.php || fail "listener does not read queued ARI WebSocket messages"
grep -q "\$type === 'empty'" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriEventListener.php || fail "listener drain does not terminate on empty queue"
grep -q "sendPing" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriEventListener.php || fail "listener does not send WebSocket ping control frames"
grep -q "last_authoritative_signal_at" apps/api/app/RuntimeEngine/Events/RuntimeEventReceiptRepository.php apps/api/database/migrations/*_add_ari_event_epoch_liveness.php || fail "event epoch does not persist authoritative signal evidence"
grep -q "events_degraded" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriEventNormalizer.php apps/api/database/migrations/*_add_ari_event_epoch_liveness.php || fail "runtime node projection does not include events_degraded"
if rg -n "UTCP_ASTERISK_ARI_MAX_EVENTS_PER_CYCLE|max_events_per_cycle.*env\\(" apps/api/config apps/api/app infrastructure scripts | rg -v '^scripts/asterisk-ari/config-check:'; then
  fail "ARI max_events_per_cycle must not be controlled by an environment feature gate"
fi
if rg -n "sleep\\(" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriEventListener.php; then
  fail "listener drain must not sleep inside the work cycle"
fi
if rg -n "drain.*ari|ari.*drain|events:drain|drain-events" apps/api/app apps/api/routes scripts | rg -v '^scripts/asterisk-ari/config-check:'; then
  fail "manual ARI drain control is present"
fi

grep -Eq '^UTCP_PHASE=C5$|^UTCP_PHASE=T[01]$' versions.env || fail "unexpected phase marker for T0 corridor"
grep -q "adapter_key.*asterisk-ari" apps/api/config/runtime_registry.php || fail "missing asterisk-ari registry metadata"
grep -q "runtime_family.*asterisk" apps/api/config/runtime_registry.php || fail "missing asterisk runtime family metadata"
grep -q "'event.stream'" apps/api/config/runtime_registry.php || fail "missing event.stream runtime capability"
grep -q "asterisk-ari-events" apps/api/config/runtime_engine.php infrastructure/docker/api/entrypoint infrastructure/kubernetes/base/platform/asterisk-ari-events-deployment.yaml || fail "missing asterisk listener process role"

if rg -n "class AriController|class AsteriskController|Route::.*(ari|asterisk)" apps/api/app/Http apps/api/routes; then
  fail "public ARI controller or route is present"
fi

architecture_scan_paths=()
[ -d apps/api/app/RuntimeEngine/Workers ] && architecture_scan_paths+=(apps/api/app/RuntimeEngine/Workers)
for path in apps/api/app/TelephonyDomain/*.php apps/api/app/Http/Controllers/TelephonyDomain/*.php; do
  [ -f "$path" ] && architecture_scan_paths+=("$path")
done
if [ "${#architecture_scan_paths[@]}" -gt 0 ] && rg -n "Asterisk|Ari|ARI" "${architecture_scan_paths[@]}"; then
  fail "generic C3 worker or C5 domain contains Asterisk-specific branch"
fi

if rg -n "SimulatorRuntimeAdapter|simulator-deterministic" apps/api/app/RuntimeAdapters/Asterisk apps/api/app/RuntimeEngine/Commands/GenericRuntimeNodeInspectHandler.php; then
  fail "Asterisk path contains simulator fallback"
fi

grep -Fq "utcp-outbound" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "Asterisk adapter must use the canonical outbound dialplan"
grep -Fq 'channelvars = UTCP_CALL_LEG_ID' infrastructure/docker/asterisk/entrypoint || fail "managed Asterisk ARI must expose only the canonical CallLeg channel variable"
grep -Fqi "kamailio" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "Asterisk adapter must document the internal Kamailio execution seam"
grep -Fq "'app' => (string) \$profile['application_name']" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "Asterisk originate must use the canonical ARI application landing"
grep -Fq "UTCP_TRUNK_ENDPOINT_ID" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "Asterisk adapter must carry the selected trunk endpoint correlation"
if rg -n "'context' => 'utcp-outbound'|'priority' => '1'" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php; then
  fail "call.leg.originate must use the Local endpoint as its sole outbound dialplan-entry authority"
fi
if rg -n "'extension' =>" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php; then
  fail "call.leg.originate must not select a post-answer dialplan extension when using the ARI app landing"
fi
for variable in \
  __UTCP_CALL_LEG_ID \
  __UTCP_ROUTE_DECISION_ID \
  __UTCP_TRUNK_ENDPOINT_ID \
  __UTCP_CALLER_IDENTITY_ID
do
  grep -Fq "'$variable' =>" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "Asterisk originate body must carry $variable"
done
grep -Fq "'variables' => [" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "Asterisk originate variables must be sent in the JSON body"
if rg -n "variables\[[^]]+\]" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php; then
  fail "Asterisk originate variables must not be encoded as query parameters"
fi
grep -Fq 'json_encode($body' apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "Asterisk ARI request path must serialize the JSON body"
grep -Fq "'endpoint' =>" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "ordinary originate endpoint must remain a query parameter"
grep -Fq "'execution_media_formats' => ['ulaw']" apps/api/config/asterisk_ari.php || fail "managed Asterisk execution media authority must be the canonical ulaw declaration"
grep -Fq "'formats' => implode(',', \$formats)" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "Asterisk originate must serialize canonical execution media formats"
grep -Fq "ari_execution_media_formats_invalid" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "Asterisk originate must fail closed when execution media formats are invalid"
grep -Fq "caller_identity_address" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "Asterisk originate must consume the resolved caller identity address"
grep -Fq "callerIdForOriginate" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "Asterisk originate must derive callerId through the bounded adapter seam"
grep -Fq "ari_caller_identity_invalid" apps/api/app/RuntimeAdapters/Asterisk/AsteriskAriClient.php || fail "Asterisk originate must fail closed for an invalid caller identity"
if rg -n "38\.146\.161\.46|PJSIP/[0-9].*@|sip:[0-9]{1,3}(\.[0-9]{1,3}){3}" apps/api/app/RuntimeAdapters/Asterisk infrastructure/kubernetes/base/runtime; then
  fail "Asterisk adapter/runtime contains a direct provider destination"
fi
if rg -n "ConfBridge|rtpengine|PSTN|uac_auth|auth_username|auth_password|provider_(ip|host|credential)" apps/api/app/RuntimeAdapters/Asterisk infrastructure/kubernetes/base/runtime; then
  fail "Asterisk adapter/runtime contains provider or media authority"
fi

if rg -n "api_key=|username=.*password|password=.*@" apps/api/app/RuntimeAdapters/Asterisk infrastructure/kubernetes; then
  fail "credential appears in URL-oriented configuration"
fi

if rg -n "'(tenant|tenant_id|runtime_node_id|operation_id|epoch_id|request_id|hostname|username|application_name)'[[:space:]]*=>" apps/api/app/Http/Controllers/Platform/MetricsController.php; then
  fail "T0 metrics include forbidden high-cardinality/sensitive labels"
fi

if rg -n "by[[:space:]]*\\([^)]*(tenant|tenant_id|runtime_node_id|operation_id|epoch_id|request_id|hostname|username|application_name)" infrastructure/kubernetes/observability/alerts/utcp-alerts.yaml; then
  fail "T0 alerts aggregate by forbidden high-cardinality/sensitive labels"
fi

for metric in \
  asterisk_ari_http_requests_total \
  asterisk_ari_websocket_connections \
  asterisk_ari_events_received_total \
  asterisk_ari_reconnects_total \
  asterisk_ari_authentication_failures_total \
  asterisk_ari_listener_claims_total \
  asterisk_ari_listener_nodes \
  asterisk_ari_events_degraded_nodes
do
  rg -n -- "$metric" apps/api/app/Http/Controllers/Platform/MetricsController.php infrastructure/kubernetes/observability/alerts/utcp-alerts.yaml >/dev/null ||
    fail "missing T0 metric or alert reference: $metric"
done

for alert in \
  UTCPAsteriskAriEventsUnavailable \
  UTCPAsteriskAriNodeWithoutListenerEvidence \
  UTCPAsteriskAriEventStreamDegraded \
  UTCPAsteriskAriAuthenticationFailures \
  UTCPAsteriskAriReconnectLoop \
  UTCPAsteriskAriReceiptBacklog \
  UTCPAsteriskRuntimeObservationStale
do
  rg -n -- "$alert" infrastructure/kubernetes/observability/alerts/utcp-alerts.yaml >/dev/null ||
    fail "missing T0 alert: $alert"
done

check_kustomize_forbidden infrastructure/kubernetes/base/platform "LoadBalancer|hostPort|hostNetwork|hostPID|5061" "T0 platform manifests expose forbidden network surface"
check_kustomize_forbidden infrastructure/kubernetes/base/runtime "NodePort|LoadBalancer|hostPort|hostNetwork|hostPID|5061" "T0 runtime manifests expose forbidden network surface"
check_kustomize_forbidden infrastructure/kubernetes/overlays/local-two-asterisk "NodePort|LoadBalancer|hostPort|hostNetwork|hostPID|5061" "T5 staged A/B runtime manifests expose forbidden network surface"
check_kustomize_forbidden infrastructure/kubernetes/security "0\\.0\\.0\\.0/0|::/0|5061" "T0 NetworkPolicy contains broad egress or public SIP ports"

scripts/asterisk-ari/validate-ab-topology >/dev/null

printf 'asterisk_ari_config_check=ok\n'
