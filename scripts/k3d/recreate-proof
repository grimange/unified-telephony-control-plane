#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/k3d/lib
. "$SCRIPT_DIR/lib"

required_tools

before_compose="$(compose_state)"
before_context="$(kubectl config current-context 2>/dev/null || true)"

validate_standard_edge_ports_available

"$SCRIPT_DIR/delete"
"$SCRIPT_DIR/create"
"$SCRIPT_DIR/registry-proof"

after_compose="$(compose_state)"
after_context="$(kubectl config current-context 2>/dev/null || true)"

if [ "$before_compose" != "$after_compose" ]; then
  printf 'persistent UTCP Compose project state changed during recreate proof\n' >&2
  exit 1
fi

if [ "$before_context" != "$after_context" ]; then
  printf 'global Kubernetes context changed during recreate proof: before=%s after=%s\n' "$before_context" "$after_context" >&2
  exit 1
fi

printf 'k3d recreate proof passed\n'
