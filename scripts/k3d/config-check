#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/k3d/lib
. "$SCRIPT_DIR/lib"

required_tools

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
selected_config="${K3D_CONFIG_FILE:-$CLUSTER_CONFIG}"
k3d config migrate "$selected_config" "$tmp" >/dev/null

check_contains() {
  local pattern="$1"
  local description="$2"
  if ! grep -Fq "$pattern" "$tmp"; then
    printf 'k3d config check failed: %s\n' "$description" >&2
    exit 1
  fi
}

check_absent() {
  local pattern="$1"
  local description="$2"
  if grep -Eiq "$pattern" "$tmp"; then
    printf 'k3d config check failed: %s\n' "$description" >&2
    exit 1
  fi
}

check_contains "name: $K3D_CLUSTER_NAME" "cluster name must be $K3D_CLUSTER_NAME"
check_contains "servers: $K3D_SERVER_COUNT" "server count must be $K3D_SERVER_COUNT"
check_contains "agents: $K3D_AGENT_COUNT" "agent count must be $K3D_AGENT_COUNT"
check_contains "hostIP: $K3D_API_HOST" "Kubernetes API must bind to $K3D_API_HOST"
check_contains "hostPort: \"$K3D_API_HOST_PORT\"" "Kubernetes API port must be $K3D_API_HOST_PORT"
check_contains "name: $K3D_REGISTRY_NAME" "registry name must be $K3D_REGISTRY_NAME"
check_contains "host: $K3D_REGISTRY_HOST" "registry must bind to $K3D_REGISTRY_HOST"
check_contains "hostPort: \"$K3D_REGISTRY_HOST_PORT\"" "registry port must be $K3D_REGISTRY_HOST_PORT"
check_contains "image: $K3D_REGISTRY_IMAGE" "registry image must be $K3D_REGISTRY_IMAGE"
check_contains "arg: --disable=traefik" "packaged Traefik must be disabled"
check_contains "port: ${UTCP_EDGE_HTTP_HOST}:${UTCP_EDGE_HTTP_HOST_PORT}:80" "K2 HTTP edge mapping must be ${UTCP_EDGE_HTTP_HOST}:${UTCP_EDGE_HTTP_HOST_PORT}->80"
check_contains "port: ${UTCP_EDGE_HTTPS_HOST}:${UTCP_EDGE_HTTPS_HOST_PORT}:443" "K2 HTTPS edge mapping must be ${UTCP_EDGE_HTTPS_HOST}:${UTCP_EDGE_HTTPS_HOST_PORT}->443"
check_contains "nodeFilters:" "K2 edge mappings must target the load balancer"
if [ "${K3D_MEDIA_EDGE_PROFILE:-0}" = "1" ]; then
  check_contains "port: 127.0.0.1:40000-40099:40000-40099/udp" "media-edge profile must publish the canonical UDP range"
  check_contains "arg: --kube-apiserver-arg=service-node-port-range=30000-40099" "media-edge profile must extend the NodePort range"
  check_contains "label: utcp.dev/media-edge=true" "media-edge node label is required"
  check_absent "0\\.0\\.0\\.0|\\[::\\]|:2223|:2224|:10000|:20000|:21000|:21099|:5060|:5061|hostNetwork|pod-cidr" "unapproved media-edge exposure is prohibited"
else
  check_absent "18080|18443|0\\.0\\.0\\.0:(6550|5001|80|443)|:5060|:5061|rtp|sip|sips|asterisk|freeswitch|kamailio|rtpengine|NodePort|40000-40099|service-node-port-range=30000-40099|utcp.dev/media-edge" "unapproved application, custom-port, or telephony exposure is prohibited"
fi

printf 'k3d config check passed\n'
