#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/k3d/lib
. "$SCRIPT_DIR/lib"

required_tools
"$SCRIPT_DIR/config-check" >/dev/null

before_context="$(kubectl config current-context 2>/dev/null || true)"
initial_state="$(cluster_state)"
ensure_cluster_running

write_kubeconfig
apply_namespaces
wait_for_nodes
wait_for_system_pods

after_context="$(kubectl config current-context 2>/dev/null || true)"
if [ "$before_context" != "$after_context" ]; then
  printf 'global Kubernetes context changed unexpectedly: before=%s after=%s\n' "$before_context" "$after_context" >&2
  exit 1
fi

if [ "$initial_state" = "ABSENT" ]; then
  "$SCRIPT_DIR/verify" >/dev/null
else
  "$SCRIPT_DIR/runtime-ready" >/dev/null
fi

printf 'K0 cluster ready: %s\n' "$K3D_CLUSTER_NAME"
printf 'repository kubeconfig: %s\n' "$KUBECONFIG_FILE"
printf 'use: scripts/k3d/kube get nodes\n'
