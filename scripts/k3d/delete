#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/k3d/lib
. "$SCRIPT_DIR/lib"

required_tools

delete_kubeconfig="$KUBECONFIG_FILE"
if [ ! -f "$delete_kubeconfig" ]; then
  mkdir -p "$RUNTIME_DIR"
  delete_kubeconfig="$RUNTIME_DIR/delete-kubeconfig.yaml"
  : > "$delete_kubeconfig"
fi

if cluster_exists; then
  KUBECONFIG="$delete_kubeconfig" k3d cluster delete "$K3D_CLUSTER_NAME"
  printf 'deleted k3d cluster: %s\n' "$K3D_CLUSTER_NAME"
else
  printf 'k3d cluster already absent: %s\n' "$K3D_CLUSTER_NAME"
fi

if registry_exists; then
  k3d registry delete "$K3D_REGISTRY_NAME"
  printf 'deleted k3d registry: %s\n' "$K3D_REGISTRY_NAME"
else
  printf 'k3d registry already absent: %s\n' "$K3D_REGISTRY_NAME"
fi

rm -f "$KUBECONFIG_FILE"
rm -f "$RUNTIME_DIR/delete-kubeconfig.yaml"
printf 'removed repository kubeconfig: %s\n' "$KUBECONFIG_FILE"
