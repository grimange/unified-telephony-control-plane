#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/k3d/lib
. "$SCRIPT_DIR/lib"

required_tools

printf 'cluster=%s\n' "$K3D_CLUSTER_NAME"
printf 'context=%s\n' "$K3D_CONTEXT_NAME"
print_versions

if cluster_exists; then
  k3d cluster list "$K3D_CLUSTER_NAME"
else
  printf 'cluster_status=missing\n'
  exit 0
fi

printf 'kubeconfig=%s\n' "$KUBECONFIG_FILE"
if [ -s "$KUBECONFIG_FILE" ]; then
  printf 'repository_context=%s\n' "$(KUBECONFIG="$KUBECONFIG_FILE" kubectl config current-context)"
  printf 'repository_namespace=%s\n' "$(KUBECONFIG="$KUBECONFIG_FILE" kubectl config view --minify --output 'jsonpath={..namespace}')"
  kube get nodes -o wide
  kube get namespaces traefik-system utcp-platform utcp-runtime utcp-data utcp-observability
  kube -n kube-system get pods
else
  printf 'repository_context=missing\n'
fi

if registry_exists; then
  k3d registry list "$K3D_REGISTRY_NAME"
else
  printf 'registry_status=missing\n'
fi

if docker ps --filter "name=k3d-${K3D_CLUSTER_NAME}-serverlb" --format '{{.Ports}}' | grep -Fq "${K3D_API_HOST}:${K3D_API_HOST_PORT}->6443"; then
  printf 'api_binding=%s:%s\n' "$K3D_API_HOST" "$K3D_API_HOST_PORT"
else
  printf 'api_binding=not-found\n'
fi

serverlb_ports="$(docker ps --filter "name=k3d-${K3D_CLUSTER_NAME}-serverlb" --format '{{.Ports}}')"
for binding in "${UTCP_EDGE_HTTP_HOST}:${UTCP_EDGE_HTTP_HOST_PORT}->80" "${UTCP_EDGE_HTTPS_HOST}:${UTCP_EDGE_HTTPS_HOST_PORT}->443"; do
  if printf '%s\n' "$serverlb_ports" | grep -Fq "$binding"; then
    printf 'edge_binding=%s\n' "$binding"
  else
    printf 'edge_binding_missing=%s\n' "$binding"
  fi
done

if printf '%s\n' "$serverlb_ports" | grep -Fq '127.0.0.1:40000-40099->40000-40099/udp'; then
  printf 'media_binding=127.0.0.1:40000-40099->40000-40099/udp\n'
else
  printf 'media_binding_missing=127.0.0.1:40000-40099->40000-40099/udp\n'
fi

if kube -A get pods,deployments 2>/dev/null | grep -iq traefik; then
  printf 'traefik_absent=false\n'
else
  printf 'traefik_absent=true\n'
fi
