#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

cat > "$tmpdir/k3d" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [ "$1" = cluster ] && [ "$2" = list ]; then
  case "${UTCP_K3D_TEST_STATE:-ABSENT}" in
    ABSENT) printf '[]\n' ;;
    RUNNING) printf '[{"name":"utcp-local","serversRunning":1,"agentsRunning":2}]\n' ;;
    STOPPED) printf '[{"name":"utcp-local","serversRunning":0,"agentsRunning":0}]\n' ;;
    *) exit 1 ;;
  esac
  exit 0
fi
printf '%s\n' "$*" >> "${UTCP_K3D_TEST_CALLS:?}"
EOF
chmod +x "$tmpdir/k3d"

for expected in ABSENT RUNNING STOPPED; do
  actual="$(PATH="$tmpdir:$PATH" UTCP_K3D_TEST_STATE="$expected" bash -c ". '$ROOT/scripts/k3d/lib'; cluster_state")"
  if [ "$actual" != "$expected" ]; then
    printf 'cluster state mismatch: expected=%s actual=%s\n' "$expected" "$actual" >&2
    exit 1
  fi
done

for rejected_state in ABSENT STOPPED; do
  if ! PATH="$tmpdir:$PATH" UTCP_K3D_TEST_STATE="$rejected_state" "$ROOT/scripts/k3d/runtime-ready" >/dev/null 2>&1; then
    :
  else
    printf 'runtime readiness unexpectedly accepted %s cluster\n' "$rejected_state" >&2
    exit 1
  fi
done

calls="$tmpdir/calls"
: > "$calls"
PATH="$tmpdir:$PATH" UTCP_K3D_TEST_STATE=STOPPED UTCP_K3D_TEST_CALLS="$calls" bash -c \
  ". '$ROOT/scripts/k3d/lib'; validate_ports_available_for_create(){ :; }; ensure_cluster_running" >/dev/null
if ! grep -Fxq 'cluster start utcp-local' "$calls"; then
  printf 'stopped cluster did not use canonical k3d cluster start\n' >&2
  exit 1
fi
if grep -Fq 'cluster delete' "$calls"; then
  printf 'cluster start path attempted deletion\n' >&2
  exit 1
fi

runtime_ready="$ROOT/scripts/k3d/runtime-ready"
if grep -Eq '5060|30560|edge-activate|ignore[-_]v1b|V1_B' "$runtime_ready"; then
  printf 'runtime readiness must not encode V1-B exposure or bypass controls\n' >&2
  exit 1
fi
if ! grep -Fq 'cluster is absent' "$runtime_ready" ||
  ! grep -Fq 'cluster is stopped' "$runtime_ready" ||
  ! grep -Fq 'wait_for_nodes' "$runtime_ready"; then
  printf 'runtime readiness state/readiness checks are incomplete\n' >&2
  exit 1
fi
if grep -Fq 'scripts/k3d/verify' "$ROOT/scripts/kubernetes/lib" "$ROOT/scripts/security/lib" "$ROOT/scripts/observability/lib" "$ROOT/scripts/gateway/apply"; then
  printf 'normal deployment callers still depend on strict full-topology verification\n' >&2
  exit 1
fi
if ! grep -Fq 'scripts/k3d/runtime-ready' "$ROOT/scripts/kubernetes/lib" "$ROOT/scripts/security/lib" "$ROOT/scripts/observability/lib" "$ROOT/scripts/gateway/apply"; then
  printf 'normal deployment callers do not use canonical runtime readiness\n' >&2
  exit 1
fi
if ! grep -Fq 'initial_state' "$ROOT/scripts/k3d/create" ||
  ! grep -Fq 'initial_state" = "ABSENT"' "$ROOT/scripts/k3d/create" ||
  ! grep -Fq 'runtime-ready' "$ROOT/scripts/k3d/create"; then
  printf 'cluster creation/reuse does not separate strict creation verification from runtime readiness\n' >&2
  exit 1
fi

printf 'k3d lifecycle state tests passed\n'
