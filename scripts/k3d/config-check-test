#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CHECK="$ROOT/scripts/k3d/config-check"
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

cp "$ROOT/infrastructure/k3d/cluster.yaml" "$tmpdir/cluster.yaml"

expect_pass() {
  K3D_CONFIG_FILE="$tmpdir/cluster.yaml" "$CHECK" >/dev/null
}

expect_fail() {
  local label="$1"
  if K3D_CONFIG_FILE="$tmpdir/cluster.yaml" "$CHECK" >/dev/null 2>&1; then
    printf 'k3d config mutation unexpectedly passed: %s\n' "$label" >&2
    exit 1
  fi
}

expect_pass

custom_dns="$ROOT/infrastructure/k3d/coredns-custom.yaml"
if ! grep -Fq 'name: coredns-custom' "$custom_dns" ||
  ! grep -Fq 'namespace: kube-system' "$custom_dns" ||
  ! grep -Fq 'utcp-lan.server:' "$custom_dns" ||
  ! grep -Fq 'lan:53 {' "$custom_dns" ||
  ! grep -Fq 'rcode NXDOMAIN' "$custom_dns"; then
  printf 'CoreDNS custom ConfigMap contract is incomplete\n' >&2
  exit 1
fi
if grep -Eq 'forward|proxy|\.lan' "$custom_dns"; then
  printf 'CoreDNS custom .lan block must not forward to an external resolver\n' >&2
  exit 1
fi
if ! grep -Fq 'template ANY ANY' "$custom_dns"; then
  printf 'CoreDNS custom .lan block must use the local template negative response\n' >&2
  exit 1
fi
if ! grep -Fq 'import /etc/coredns/custom/*.server' <(scripts/k3d/kube -n kube-system get configmap coredns -o jsonpath='{.data.Corefile}' 2>/dev/null || true); then
  printf 'installed CoreDNS Corefile no longer imports custom server blocks\n' >&2
  exit 1
fi

if ! grep -Fq 'cluster_state' "$ROOT/scripts/k3d/lib" ||
  ! grep -Fq '"serversRunning":0' "$ROOT/scripts/k3d/lib" ||
  ! grep -Fq 'k3d cluster start' "$ROOT/scripts/k3d/lib"; then
  printf 'k3d lifecycle state/start contract is incomplete\n' >&2
  exit 1
fi
if grep -Fq 'k3d cluster delete' "$ROOT/scripts/k3d/create" "$ROOT/scripts/k3d/start"; then
  printf 'canonical start path must never delete a cluster\n' >&2
  exit 1
fi
if ! grep -Fq '0.0.0.0:5060:30560/udp' "$ROOT/infrastructure/k3d/cluster.yaml"; then
  printf 'strict V1-B UDP/5060 declaration was removed\n' >&2
  exit 1
fi

sed -i 's/name: utcp-local/name: utcp-other/' "$tmpdir/cluster.yaml"
expect_fail "alternate cluster identity"
cp "$ROOT/infrastructure/k3d/cluster.yaml" "$tmpdir/cluster.yaml"
sed -i 's/name: utcp-local-registry/name: other-registry/' "$tmpdir/cluster.yaml"
expect_fail "alternate registry identity"
cp "$ROOT/infrastructure/k3d/cluster.yaml" "$tmpdir/cluster.yaml"
sed -i '0,/hostPort: "5001"/s//hostPort: "5002"/' "$tmpdir/cluster.yaml"
expect_fail "alternate registry port"
cp "$ROOT/infrastructure/k3d/cluster.yaml" "$tmpdir/cluster.yaml"
sed -i 's#127.0.0.1:40000-40099:40000-40099/udp#127.0.0.1:40000-40098:40000-40098/udp#' "$tmpdir/cluster.yaml"
expect_fail "truncated UDP range"
cp "$ROOT/infrastructure/k3d/cluster.yaml" "$tmpdir/cluster.yaml"
sed -i 's#127.0.0.1:40000-40099:40000-40099/udp#127.0.0.1:40000-40099:40000-40099/tcp#' "$tmpdir/cluster.yaml"
expect_fail "TCP instead of UDP"
cp "$ROOT/infrastructure/k3d/cluster.yaml" "$tmpdir/cluster.yaml"
sed -i '/127.0.0.1:40000-40099:40000-40099\/udp/d' "$tmpdir/cluster.yaml"
expect_fail "missing UDP publication"
cp "$ROOT/infrastructure/k3d/cluster.yaml" "$tmpdir/cluster.yaml"
sed -i '/port: 0.0.0.0:5060:30560\/udp/,+2d' "$tmpdir/cluster.yaml"
expect_fail "missing V1 external SIP publication"
cp "$ROOT/infrastructure/k3d/cluster.yaml" "$tmpdir/cluster.yaml"
sed -i 's/--kube-apiserver-arg=service-node-port-range=30000-40099/--kube-apiserver-arg=service-node-port-range=30000-30099/' "$tmpdir/cluster.yaml"
expect_fail "missing extended NodePort range"
cp "$ROOT/infrastructure/k3d/cluster.yaml" "$tmpdir/cluster.yaml"
sed -i 's/utcp.dev\/media-edge=true/utcp.dev\/wrong=true/' "$tmpdir/cluster.yaml"
expect_fail "media-edge node label mutation"

printf 'k3d config mutation checks passed\n'
