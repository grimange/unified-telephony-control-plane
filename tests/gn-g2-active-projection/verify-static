#!/usr/bin/env python3
"""Include untracked active source, schemas, PHP, docs and evidence in hygiene."""
import ast
import json
from pathlib import Path
import re
import subprocess

ROOT = Path(__file__).resolve().parents[2]
bases = [ROOT / 'components/kubernetes-effects/active', ROOT / 'tests/gn-g2-active-projection',
         ROOT / 'docs/architecture/proposals/gn-g2/contracts/v3']
for name in ['UTCP_GN_G2_ACTIVE_RUNTIME_PROJECTION_PROFILES_AND_FIVE_CORRIDOR_PARITY.md',
             'gn-g2/active-real-api-evidence.json', 'gn-g2/active-source-parity.md', 'gn-g2/GN-G2-canonical-integration-assignment.md']:
    path = ROOT / 'docs/architecture/proposals' / name
    if path.exists():
        bases.append(path)
errors = []
for name in ['action.schema.json', 'result.schema.json', 'fixtures.json']:
    source = ROOT / 'docs/architecture/proposals/gn-g2/contracts/v3' / name
    embedded = ROOT / 'components/kubernetes-effects/active/contracts' / name
    if not source.is_file() or not embedded.is_file() or source.read_bytes() != embedded.read_bytes():
        errors.append('contract copy mismatch: ' + name)
files = sorted(p for base in bases for p in (base.rglob('*') if base.is_dir() else [base]) if p.is_file())
for path in files:
    if '__pycache__' in path.parts:
        errors.append('generated cache: ' + str(path.relative_to(ROOT)))
        continue
    text = path.read_text()
    if not text.endswith('\n') or any(line.rstrip() != line for line in text.splitlines()):
        errors.append('whitespace: ' + str(path.relative_to(ROOT)))
    if re.search(r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----', text):
        errors.append('private key: ' + str(path.relative_to(ROOT)))
    if path.suffix == '.json':
        json.loads(text)
    if path.suffix == '.py' or path.name in ['verify', 'verify-static']:
        ast.parse(text)
    if path.suffix == '.php':
        subprocess.run(['php', '-l', str(path)], check=True, stdout=subprocess.DEVNULL)
    if path.suffix == '.md':
        for target in re.findall(r'\[[^\]]*\]\(([^)]+)\)', text):
            if re.match(r'^[a-z]+://', target) or target.startswith('#'):
                continue
            if not (path.parent / target.split('#')[0]).exists():
                errors.append('broken link: ' + str(path.relative_to(ROOT)) + ': ' + target)
    if path.suffix == '.go' and not path.name.endswith('_test.go'):
        for pattern in [r'package main\b', r'InClusterConfig|BuildConfigFromFlags|ListenAndServe',
                        r'database/sql|go-redis|os\.Getenv\(', r'\.(?:Post|Put|Delete|Watch)\(']:
            if re.search(pattern, text):
                errors.append('isolation: ' + str(path.relative_to(ROOT)) + ': ' + pattern)
if errors:
    raise SystemExit('\n'.join(errors))
print(f'Active static/docs/JSON/PHP/secret/isolation checks: PASS ({len(files)} files)')
