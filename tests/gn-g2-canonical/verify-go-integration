#!/usr/bin/env python3
"""Use pinned SDK, live ephemeral PHP callback and exported PostgreSQL authority facts."""
import os
from pathlib import Path
import subprocess
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parents[2]
url = os.environ.get('UTCP_CANONICAL_PHP_URL', '')
p = urlparse(url)
if p.scheme != 'http' or p.hostname != '127.0.0.1' or not p.port or p.username or p.query or p.fragment:
    raise SystemExit('Explicit ephemeral loopback PHP bridge URL required')
output = Path(os.environ['UTCP_GN_G2_CANONICAL_OUTPUT']).resolve()
if not (output / 'canonical-proof.json').is_file():
    raise SystemExit('PostgreSQL-backed PHP proof export is missing')
cache = os.environ.get('UTCP_GN_G2_CACHE', '/tmp/utcp-gn-g0-go-cache')
subprocess.run([
    'docker', 'run', '--rm', '--network', 'host', '--user', f'{os.getuid()}:{os.getgid()}',
    '-e', 'GOPATH=/cache', '-e', 'GOCACHE=/cache/build', '-e', 'GOTOOLCHAIN=local', '-e', 'GOPROXY=off',
    '-e', 'UTCP_CANONICAL_PHP_URL=' + url, '-e', 'UTCP_GN_G2_CANONICAL_OUTPUT=/proof-output',
    '-v', cache + ':/cache', '-v', str(ROOT) + ':/repo:ro', '-v', str(output) + ':/proof-output:ro',
    '-w', '/repo/components/kubernetes-effects',
    'golang@sha256:4557cf171e3cdf5053a298d5171b1a5f5734d920260c25f22c79e94760eb2084',
    'sh', '-ec', 'go test -count=1 -v -run TestCanonicalPostgreSQL ./...; '
    'go test -race -count=1 -v -run TestCanonicalPostgreSQL ./...; go vet ./...; go mod verify'
], check=True)
